Properties><string name="Name">MaterialName</string><string name="Value">Wood</string></Properties></Item><Item class="StringValue" referent="RBX8306"><Properties><string name="Name">Role</string><string name="Value">lobbyShop</string></Properties></Item><Item class="StringValue" referent="RBX8307"><Properties><string name="Name">Title</string><string name="Value">Ward &amp; Thread</string></Properties></Item><Item class="StringValue" referent="RBX8308"><Properties><string name="Name">Action</string><string name="Value">Browse classes and Memory Shards</string></Properties></Item><Item class="StringValue" referent="RBX8309"><Properties><string name="Name">Text</string><string name="Value">Choose your work before you return to the house.</string></Properties></Item></Item><Item class="Part" referent="RBX8351"><Properties><string name="Name">SoloTicketEasy</string><CoordinateFrame name="CFrame"><X>447</X><Y>3.7</Y><Z>30.5</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1</X><Y>0.15</Y><Z>1</Z></Vector3><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">true</bool><float name="Transparency">0</float><token name="Material">512</token><Color3uint8 name="Color3uint8">13483670</Color3uint8><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties><Item class="StringValue" referent="RBX8346"><Properties><string name="Name">MaterialName</string><string name="Value">Wood</string></Properties></Item><Item class="StringValue" referent="RBX8347"><Properties><string name="Name">Role</string><string name="Value">lobbySolo</string></Properties></Item><Item class="StringValue" referent="RBX8348"><Properties><string name="Name">Title</string><string name="Value">Easy ticket</string></Properties></Item><Item class="StringValue" referent="RBX8349"><Properties><string name="Name">Action</string><string name="Value">Depart solo / Easy</string></Properties></Item><Item class="StringValue" referent="RBX8350"><Properties><string name="Name">Mode</string><string name="Value">Easy</string></Properties></Item></Item><Item class="Part" referent="RBX8357"><Properties><string name="Name">SoloTicketIntermediate</string><CoordinateFrame name="CFrame"><X>454</X><Y>3.7</Y><Z>30.5</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1</X><Y>0.15</Y><Z>1</Z></Vector3><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">true</bool><float name="Transparency">0</float><token name="Material">512</token><Color3uint8 name="Color3uint8">13483670</Color3uint8><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties><Item class="StringValue" referent="RBX8352"><Properties><string name="Name">MaterialName</string><string name="Value">Wood</string></Properties></Item><Item class="StringValue" referent="RBX8353"><Properties><string name="Name">Role</string><string name="Value">lobbySolo</string></Properties></Item><Item class="StringValue" referent="RBX8354"><Properties><string name="Name">Title</string><string name="Value">Intermediate ticket</string></Properties></Item><Item class="StringValue" referent="RBX8355"><Properties><string name="Name">Action</string><string name="Value">Depart solo / Intermediate</string></Properties></Item><Item class="StringValue" referent="RBX8356"><Properties><string name="Name">Mode</string><string name="Value">Intermediate</string></Properties></Item></Item><Item class="Part" referent="RBX8363"><Properties><string name="Name">SoloTicketHard</string><CoordinateFrame name="CFrame"><X>461</X><Y>3.7</Y><Z>30.5</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1</X><Y>0.15</Y><Z>1</Z></Vector3><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">true</bool><float name="Transparency">0</float><token name="Material">512</token><Color3uint8 name="Color3uint8">13483670</Color3uint8><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties><Item class="StringValue" referent="RBX8358"><Properties><string name="Name">MaterialName</string><string name="Value">Wood</string></Properties></Item><Item class="StringValue" referent="RBX8359"><Properties><string name="Name">Role</string><string name="Value">lobbySolo</string></Properties></Item><Item class="StringValue" referent="RBX8360"><Properties><string name="Name">Title</string><string name="Value">Hard ticket</string></Properties></Item><Item class="StringValue" referent="RBX8361"><Properties><string name="Name">Action</string><string name="Value">Depart solo / Hard</string></Properties></Item><Item class="StringValue" referent="RBX8362"><Properties><string name="Name">Mode</string><string name="Value">Hard</string></Properties></Item></Item></Item></Item></Item><Item class="ReplicatedStorage" referent="RBX8604"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="ModuleScript" referent="RBX8598"><Properties><string name="Name">SpareRoomConfig</string><ProtectedString name="Source">-- The Spare Room: Roblox Studio starter. All positions use Roblox studs.
local Config={
 Version = &quot;Roblox prototype 0.8&quot;,
 -- Create a repeatable Developer Product priced at 30 Robux in this experience.
 -- The old gamepass 2073110257 cannot be used as a consumable product.
 ReviveProductId = 3729479338, -- REVIVE developer product; creator-configured price: 30 Robux.
 Classes = {
  Wanderer={name=&quot;Wanderer&quot;,cost=0,description=&quot;Free. Standard stamina, recovery and sanity loss.&quot;,damage=1,drain=1,stamina=1,recovery=1,food=0},
  Archivist={name=&quot;Archivist&quot;,cost=80,description=&quot;20% less sanity lost from disturbing discoveries.&quot;,damage=0.8,drain=1,stamina=1,recovery=1,food=0},
  Courier={name=&quot;Courier&quot;,cost=100,description=&quot;Sprint uses 25% less stamina; stamina recovers 15% faster.&quot;,damage=1,drain=1,stamina=0.75,recovery=1.15,food=0},
  Caretaker={name=&quot;Caretaker&quot;,cost=120,description=&quot;20% less passive sanity loss; sandwiches restore 3% extra.&quot;,damage=1,drain=0.8,stamina=1,recovery=1,food=3},
 },
 ClassOrder={&quot;Wanderer&quot;,&quot;Archivist&quot;,&quot;Courier&quot;,&quot;Caretaker&quot;},
 -- Create three distinct developer products in the SAME experience. Never reuse the revive ID.
 ShardPacks={
  {name=&quot;+50 Memory Shards&quot;,amount=50,productId=3729646165},
  {name=&quot;+150 Memory Shards&quot;,amount=150,productId=3729646314},
  {name=&quot;+1000 Memory Shards&quot;,amount=1000,productId=3729646477},
 },
 ReviveSanity = 50,
 SaveEndingJournal = false, -- Enable only after publishing and configuring DataStore access.
 Modes = {
  Easy = {drain = 0.025, damage = 0.75, sandwich = 15, delay = 45},
  Intermediate = {drain = 0.045, damage = 1, sandwich = 12, delay = 34},
  Hard = {drain = 0.07, damage = 1.25, sandwich = 10, delay = 25},
 },
 Diary = {
  &quot;Mum put four plates out. I counted them because I was learning fours. She said I was getting good at numbers.&quot;,
  &quot;Dad fixed the kitchen chair. He told us not to stand on it while the glue was drying. We all promised separately.&quot;,
  &quot;We measured our heights beside the little beds. My line was crooked. Someone drew a sun over it.&quot;,
  &quot;The spare room is for visitors. I asked why our coats were in its cupboard. Mum said cupboards do not belong to rooms.&quot;,
  &quot;We played a game where nobody could say their own name. Dad forgot the rules halfway through and looked frightened.&quot;,
  &quot;There was knocking after tea. It copied the number of people at the table. I did not tell anyone I counted five.&quot;,
  &quot;Mum and Dad argued about which photograph to keep. Both photographs looked ordinary until they were beside each other.&quot;,
  &quot;My school report has the wrong first name. The teacher says it is the name she has always used.&quot;,
  &quot;Someone moved my bed. The marks in the carpet say it has never been anywhere else.&quot;,
  &quot;Dad wrote a list of everything in the house. He left spaces between the names. Mum folded the spaces out.&quot;,
  &quot;The boiler answers if I tap three times. It waits until the house is quiet before adding a fourth.&quot;,
  &quot;My sibling says we never had a red bicycle. There is a photograph of us carrying it together.&quot;,
  &quot;Mum remembered an extra lunchbox this morning. By the time she found the lid, she could not remember why.&quot;,
  &quot;There is a room number on the maintenance sheet that does not appear on the plan. Its inspection is signed.&quot;,
  &quot;Dad's coat was warm when I found it. Mum says the man in the photograph is a visitor. She cannot say when he visited.&quot;,
  &quot;I can remember two people teaching me the same song. The words disagree. Both voices sound like home.&quot;,
  &quot;The little bed has my handwriting underneath. I have grown too tall to reach it without lying on the floor.&quot;,
  &quot;I asked how many children lived here. Mum said that was a cruel question. Later she asked me the same thing.&quot;,
  &quot;I am keeping both copies. If one of them disappears, please do not decide that the other one was always right.&quot;,
  &quot;I left the last page unfinished. There should be somewhere for tomorrow to go. You do not have to give us faces.&quot;,
 },
 Anomalies = {
  {id = &quot;watcher&quot;, title = &quot;The Watcher&quot;, text = &quot;Too tall for the family photograph. Its pale eyes find you slowly. It turns only when you stop watching.&quot;},
  {id = &quot;doll&quot;, title = &quot;Borrowed Childhood&quot;, text = &quot;The doll turns towards a voice you cannot hear. Its empty hands remember holding something.&quot;},
  {id = &quot;pages&quot;, title = &quot;The Unfinished Sentence&quot;, text = &quot;Loose pages circle an empty space. Every line ends before the same name.&quot;},
  {id = &quot;door&quot;, title = &quot;A Room Short&quot;, text = &quot;A door stands without a wall. Someone has polished the handle from the other side.&quot;},
  {id = &quot;family&quot;, title = &quot;The Family Arrangement&quot;, text = &quot;Four silhouettes wait together. The smallest space keeps changing sides.&quot;},
  {id = &quot;blocks&quot;, title = &quot;Spelling Practice&quot;, text = &quot;Children's blocks arrange themselves. There are too few letters for the name you remember.&quot;},
  {id = &quot;plates&quot;, title = &quot;Places Reserved&quot;, text = &quot;Four plates rise where no table stands. A fifth place is almost visible.&quot;},
  {id = &quot;lamp&quot;, title = &quot;The Answering Light&quot;, text = &quot;A lamp answers in groups of three. The last answer always has an extra pulse.&quot;},
  {id = &quot;coat&quot;, title = &quot;Small Shoulders&quot;, text = &quot;A child's coat rises as though someone is inside it. Then it hangs empty.&quot;},
  {id = &quot;steps&quot;, title = &quot;One Step More&quot;, text = &quot;Footprints continue after the person making them should have stopped.&quot;},
  {id = &quot;clock&quot;, title = &quot;The Uncounted Minute&quot;, text = &quot;The clock moves backwards. The house keeps its own time.&quot;},
  {id = &quot;chair&quot;, title = &quot;One More Place&quot;, text = &quot;There is an extra chair. Its legs are free of dust.&quot;},
 },
 Endings = {
  morning = {title = &quot;An Ordinary Morning&quot;, text = &quot;You keep one ordinary memory without deciding whose it was. Mum puts the kettle on.&quot;, diary = 2, anchor = true},
  names = {title = &quot;Names Without Faces&quot;, text = &quot;You preserve both records. Neither is declared a mistake. There is room for an answer later.&quot;, diary = 6, records = 2},
  seal = {title = &quot;Maintained in Absence&quot;, text = &quot;You renew the inspection seal. The earlier signatures remain beneath yours.&quot;, diary = 10, valve = true},
  tomorrow = {title = &quot;Somewhere for Tomorrow&quot;, text = &quot;You leave the final page unfinished. The house remembers a larger family, but offers no explanation.&quot;, diary = 20, records = 3, mum = true},
  glass = {title = &quot;The Far Side of the Glass&quot;, text = &quot;You cover the observation pane. The reflection continues arranging places on the other side.&quot;, anomalies = 3, sanityMax = 45},
  blueprint = {title=&quot;A House Without an Afterthought&quot;, text=&quot;You erase the red line. Downstairs, a door quietly becomes a wall. The floorboards settle. Mum asks whether you would like to help redecorate your old room.&quot;, flags={&quot;note_study&quot;,&quot;blueprint&quot;}},
  lullaby = {title=&quot;The Last Line&quot;, text=&quot;You finish the song. The clock starts counting forwards. From the empty cot, a child says goodnight. Mum sleeps until morning without calling anyone’s name.&quot;, flags={&quot;note_nursery&quot;,&quot;clock&quot;}},
  letters = {title=&quot;A Forwarding Address&quot;, text=&quot;You type HOME on the last envelope. The letters lift like startled birds and slip beneath the door. Mum is waiting by the front gate. This time, both of you know where you are going.&quot;, flags={&quot;note_loft&quot;,&quot;letters&quot;}},
  fallen = {title=&quot;YOU DIED&quot;, text=&quot;The house grows quiet. Restart for free, or use one paid revive to keep this run’s discoveries.&quot;},
  consumed = {title = &quot;YOUR SANITY GOT CONSUMED&quot;, text = &quot;The house keeps the memory you could no longer hold.&quot;},
 },
 Rooms = {&quot;Storage Room&quot;, &quot;Boiler Room&quot;, &quot;Maintenance Tunnel&quot;, &quot;Archive Room&quot;, &quot;Forgotten Family Room&quot;, &quot;Hidden Study&quot;, &quot;Sealed Corridor&quot;, &quot;Observation Room&quot;, &quot;Former Children's Area&quot;, &quot;Locked Chamber&quot;},
}


local Content=require(script.Parent:WaitForChild(&quot;SpareRoomContent&quot;))
for i,n in ipairs(Content.BENEATH.diary) do Config.Diary[i]=n.text end
for _,e in ipairs(Content.BENEATH.endings) do
 Config.Endings[&quot;deep:&quot;..e.id]={title=e.name,text=e.description..&quot;\n\nAchievement: &quot;..e.achievement,requirements=e.requirements}
end
for _,p in ipairs(Content.cityPlaces) do
 for k,c in ipairs(p.choices) do Config.Endings[&quot;city:&quot;..p.id..&quot;:&quot;..(k-1)]={title=c[2],text=c[3],flags={&quot;venue:&quot;..p.id}} end
end
local visual={portrait=&quot;family&quot;,chair=&quot;chair&quot;,names=&quot;blocks&quot;,breath=&quot;coat&quot;,drawer=&quot;pages&quot;,ink=&quot;pages&quot;,clock=&quot;clock&quot;,coat=&quot;coat&quot;,chalk=&quot;blocks&quot;,cups=&quot;plates&quot;,steps=&quot;steps&quot;,page=&quot;pages&quot;,shadow=&quot;watcher&quot;,radio=&quot;lamp&quot;,door=&quot;door&quot;,boxes=&quot;blocks&quot;,glass=&quot;family&quot;,pipe=&quot;lamp&quot;,drawing=&quot;pages&quot;,label=&quot;blocks&quot;,lamp=&quot;lamp&quot;,frost=&quot;coat&quot;,scale=&quot;door&quot;,inventory=&quot;plates&quot;,lullaby=&quot;doll&quot;}
for _,a in ipairs(Content.BENEATH.anomalies) do
 table.insert(Config.Anomalies,{id=&quot;source:&quot;..a.id,visualId=visual[a.id],title=a.name,text=a.description,room=a.room,source=true})
end
for id,e in pairs(Content.legacy.endings) do Config.Endings[&quot;legacy:&quot;..id]={title=e.title,text=e.text,flags=e.flags,dayOnly=id==&quot;dawn&quot;} end
Config.Endings[&quot;legacy:burn&quot;].unprotectedText=&quot;You burn the diary. The door disappears, taking its memories with it.\nMum asks your name. You cannot remember.\nIn your pocket is a photograph of an empty house.&quot;
return Config
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8599"><Properties><string name="Name">SpareRoomAvatars</string><ProtectedString name="Source">-- Native Roblox avatar rigs. API-created R15 with a self-contained R6 fallback.
local Players=game:GetService(&quot;Players&quot;)
local Factory={}
local skin=Color3.fromRGB(194,170,144)
-- Curated NPC presentation pools; no gender is inferred from real Roblox users.
local looks={
 Female={hair={451220849,915267638,915267120},shirts={398634295,398635081,144076436,4047886060}},
 Male={hair={63690008,16630147,376548738,417457139},shirts={607785314,144076358,398633584,4047884046}},
}
local complexions={Color3.fromRGB(234,204,170),Color3.fromRGB(199,156,119),Color3.fromRGB(148,105,77),Color3.fromRGB(100,72,55)}
local trousers={382537569,382538503,129458426,398634487}
function Factory.randomStyle(name,gender,rng)
 local pool=looks[gender] or looks.Female
 return {name=name,gender=gender,skin=complexions[rng:NextInteger(1,#complexions)],
  shirt=Color3.fromRGB(235,231,220),pants=Color3.fromRGB(72,75,78),
  hairAsset=pool.hair[rng:NextInteger(1,#pool.hair)],shirtAsset=pool.shirts[rng:NextInteger(1,#pool.shirts)],
  pantsAsset=trousers[rng:NextInteger(1,#trousers)],height=rng:NextNumber(0.94,1.04),width=rng:NextNumber(0.88,1.02)}
end
local function fallback(style)
 local model=Instance.new(&quot;Model&quot;)
 local function part(name,size,color)
  local p=Instance.new(&quot;Part&quot;) p.Name=name p.Size=size p.Color=color p.Material=Enum.Material.SmoothPlastic
  p.TopSurface=Enum.SurfaceType.Smooth p.BottomSurface=Enum.SurfaceType.Smooth p.Parent=model
  return p
 end
 local root=part(&quot;HumanoidRootPart&quot;,Vector3.new(2,2,1),skin) root.Transparency=1
 local torso=part(&quot;Torso&quot;,Vector3.new(2,2,1),style.shirt)
 local head=part(&quot;Head&quot;,Vector3.new(2,1,1),style.skin or skin)
 local mesh=Instance.new(&quot;SpecialMesh&quot;) mesh.MeshType=Enum.MeshType.Head mesh.Scale=Vector3.new(1.25,1.25,1.25) mesh.Parent=head
 local la=part(&quot;Left Arm&quot;,Vector3.new(1,2,1),style.shirt)
 local ra=part(&quot;Right Arm&quot;,Vector3.new(1,2,1),style.shirt)
 local ll=part(&quot;Left Leg&quot;,Vector3.new(1,2,1),style.pants)
 local rl=part(&quot;Right Leg&quot;,Vector3.new(1,2,1),style.pants)
 local function joint(name,a,b,c0,c1)
  local m=Instance.new(&quot;Motor6D&quot;) m.Name=name m.Part0=a m.Part1=b m.C0=c0 m.C1=c1 m.Parent=a
  b.CFrame=a.CFrame*c0*c1:Inverse()
 end
 joint(&quot;RootJoint&quot;,root,torso,CFrame.new(),CFrame.new())
 joint(&quot;Neck&quot;,torso,head,CFrame.new(0,1,0),CFrame.new(0,-0.5,0))
 joint(&quot;Left Shoulder&quot;,torso,la,CFrame.new(-1.5,0.5,0),CFrame.new(0,0.5,0))
 joint(&quot;Right Shoulder&quot;,torso,ra,CFrame.new(1.5,0.5,0),CFrame.new(0,0.5,0))
 joint(&quot;Left Hip&quot;,torso,ll,CFrame.new(-0.5,-1,0),CFrame.new(0,1,0))
 joint(&quot;Right Hip&quot;,torso,rl,CFrame.new(0.5,-1,0),CFrame.new(0,1,0))
 local h=Instance.new(&quot;Humanoid&quot;) h.RigType=Enum.HumanoidRigType.R6 h.Parent=model
 model.PrimaryPart=root
 return model
end
function Factory.create(style)
 local description=Instance.new(&quot;HumanoidDescription&quot;)
 description.HeadColor=style.skin or skin
 local armColor=style.shirtAsset and (style.skin or skin) or style.shirt
 description.LeftArmColor=armColor description.RightArmColor=armColor description.TorsoColor=style.shirt
 description.LeftLegColor=style.pants description.RightLegColor=style.pants
 if style.hairAsset then description.HairAccessory=tostring(style.hairAsset) end
 if style.shirtAsset then description.Shirt=style.shirtAsset end
 if style.pantsAsset then description.Pants=style.pantsAsset end
 description.HeightScale=style.height or 1
 description.WidthScale=style.width or 1
 local ok,model=pcall(function() return Players:CreateHumanoidModelFromDescriptionAsync(description,Enum.HumanoidRigType.R15) end)
 description:Destroy()
 if not ok or not model then model=fallback(style) end
 model.Name=style.name
 local root=model:FindFirstChild(&quot;HumanoidRootPart&quot;)
 local humanoid=model:FindFirstChildOfClass(&quot;Humanoid&quot;)
 model.PrimaryPart=root
 humanoid.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
 humanoid.BreakJointsOnDeath=false
 humanoid.MaxHealth=1000000 humanoid.Health=1000000
 if not style.faceless then
  local head=model:FindFirstChild(&quot;Head&quot;)
  if head and not head:FindFirstChildOfClass(&quot;Decal&quot;) then
   local face=Instance.new(&quot;Decal&quot;) face.Name=&quot;face&quot; face.Texture=&quot;rbxasset://textures/face.png&quot; face.Face=Enum.NormalId.Front face.Parent=head
  end
 else
  for _,p in ipairs(model:GetDescendants()) do if p:IsA(&quot;Decal&quot;) then p:Destroy() end end
 end
 local head=model:FindFirstChild(&quot;Head&quot;)
 if head and not style.watcher and not model:FindFirstChildWhichIsA(&quot;Accessory&quot;) then
  local hair=Instance.new(&quot;Part&quot;) hair.Name=&quot;Hair&quot; hair.Size=Vector3.new(head.Size.X*1.04,head.Size.Y*0.4,head.Size.Z*1.04)
  hair.Color=style.hair or Color3.fromRGB(43,39,33) hair.CanCollide=false hair.Massless=true
  hair.CFrame=head.CFrame*CFrame.new(0,head.Size.Y*0.4,0) hair.Parent=model
  local round=Instance.new(&quot;SpecialMesh&quot;) round.MeshType=Enum.MeshType.Sphere round.Parent=hair
  local weld=Instance.new(&quot;WeldConstraint&quot;) weld.Part0=head weld.Part1=hair weld.Parent=hair
 end
 if style.watcher and head then
  local function detail(name,size,cf,color,attach,glow)
   local p=Instance.new(&quot;Part&quot;) p.Name=name p.Size=size p.CFrame=cf p.Color=color
   p.CanCollide=false p.Massless=true p.Material=glow and Enum.Material.Neon or Enum.Material.Fabric
   if glow then p.Transparency=0.35 end
   p.Parent=model
   local w=Instance.new(&quot;WeldConstraint&quot;) w.Part0=attach w.Part1=p w.Parent=p
  end
  local cloth=Color3.fromRGB(12,17,17)
  detail(&quot;WatcherHoodTop&quot;,Vector3.new(head.Size.X*1.16,0.18,head.Size.Z*1.16),head.CFrame*CFrame.new(0,head.Size.Y*0.56,0),cloth,head)
  for _,side in ipairs({-1,1}) do
   detail(&quot;WatcherHoodSide&quot;,Vector3.new(0.12,head.Size.Y*1.1,head.Size.Z*1.12),head.CFrame*CFrame.new(side*head.Size.X*0.56,0,0),cloth,head)
   detail(&quot;WatcherEye&quot;,Vector3.new(0.07,0.035,0.035),head.CFrame*CFrame.new(side*head.Size.X*0.19,0.08,-head.Size.Z*0.51),Color3.fromRGB(158,169,146),head,true)
  end
  for _,name in ipairs({&quot;LeftHand&quot;,&quot;RightHand&quot;,&quot;Left Arm&quot;,&quot;Right Arm&quot;}) do
   local hand=model:FindFirstChild(name)
   if hand then
    for finger=-1,1 do
     detail(&quot;WatcherFinger&quot;,Vector3.new(0.06,0.65,0.09),hand.CFrame*CFrame.new(finger*0.17,-hand.Size.Y/2-0.22,-0.12),Color3.fromRGB(50,57,52),hand)
    end
   end
  end
 end
 for _,p in ipairs(model:GetDescendants()) do
  if p:IsA(&quot;BasePart&quot;) then p.CanCollide=false p.CanTouch=false p.CanQuery=false p.Massless=true end
 end
 root.Massless=false
 if style.scale then model:ScaleTo(style.scale) end
 model:SetAttribute(&quot;SpareRoomAvatar&quot;,true)
 if style.gender then model:SetAttribute(&quot;Gender&quot;,style.gender) end
 return model
end
function Factory.place(model,point)
 local root=model.PrimaryPart
 local h=model:FindFirstChildOfClass(&quot;Humanoid&quot;)
 local height=h.RigType==Enum.HumanoidRigType.R6 and 3*model:GetScale() or h.HipHeight+root.Size.Y/2
 model:PivotTo(CFrame.new(point+Vector3.new(0,height,0)))
end
return Factory
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8600"><Properties><string name="Name">SpareRoomRevive</string><ProtectedString name="Source">-- Server receipt ledger: one developer product buys one revive credit.
-- Purchase-window completion is never proof of payment.
local Revive={}
function Revive.new(deps)
 local gate={pending={},busy={}}
 local function status(p,message) deps.status(p,message) end
 local function ledger(p,change)
  return deps.store:UpdateAsync(&quot;user:&quot;..p.UserId,function(old)
   local data=old or {purchases={},credits=0}
   data.purchases=data.purchases or {} data.credits=data.credits or 0
   -- Recover a reservation after a server crash. A short lease prevents two servers consuming it.
   if data.claim and deps.now()-data.claim.at&gt;180 then data.credits+=1 data.claim=nil end
   change(data)
   return data
  end)
 end
 function gate:consume(p)
  if self.busy[p] or not deps.canRevive(p) then return false end
  self.busy[p]=true
  local token=deps.token()
  local ok,data=pcall(ledger,p,function(d)
   if not d.claim and d.credits&gt;0 then d.credits-=1 d.claim={token=token,at=deps.now()} end
  end)
  if not ok then self.busy[p]=nil status(p,&quot;Revive storage is unavailable. No new purchase was opened; try again shortly.&quot;) return false end
  if not data.claim or data.claim.token~=token then
   self.busy[p]=nil
   if data.claim then status(p,&quot;Your previous revive is still processing. Please wait before trying again.&quot;) end
   return false,data.claim~=nil
  end
  local loaded,result=pcall(deps.revive,p)
  local success=loaded and result==true
  local saved=pcall(ledger,p,function(d)
   if d.claim and d.claim.token==token then
    d.claim=nil
    if not success then d.credits+=1 end
   end
  end)
  self.busy[p]=nil
  if not success then status(p,&quot;Character loading failed. Your paid revive is saved; try again shortly.&quot;)
  elseif not saved then status(p,&quot;You revived. Purchase storage is catching up.&quot;) end
  return success,true
 end
 function gate:request(p)
  if not deps.canRevive(p) or self.busy[p] then return end
  if deps.productId&lt;=0 or not deps.ready() then status(p,&quot;Revive setup pending. The creator must connect a developer product. Restart is free.&quot;) return end
  if self.pending[p] then status(p,&quot;Finish or close the Roblox purchase window first.&quot;) return end
  -- Check persistence before checkout. Never prompt when the ledger cannot be read.
  local ok,data=pcall(ledger,p,function() end)
  if not ok then status(p,&quot;Purchase storage is unavailable. Try later; restarting is free.&quot;) return end
  if data.credits&gt;0 or data.claim then self:consume(p) return end
  self.pending[p]=true
  local shown=pcall(function() deps.market:PromptProductPurchase(p,deps.productId) end)
  if not shown then self.pending[p]=nil status(p,&quot;The purchase window could not open. Restart is free.&quot;) end
 end
 function gate:receipt(info)
  if info.ProductId~=deps.productId or deps.productId&lt;=0 or not info.PurchaseId then return false end
  local p=deps.player(info.PlayerId)
  if not p then return false end
  local purchase=tostring(info.PurchaseId)
  local ok=pcall(ledger,p,function(d)
   if not d.purchases[purchase] then d.purchases[purchase]=true d.credits+=1 end
  end)
  if not ok then return false end -- Roblox retries an unacknowledged receipt.
  self.pending[p]=nil
  deps.defer(function() if deps.canRevive(p) then self:consume(p) else status(p,&quot;Your revive credit is saved for your next sanity death.&quot;) end end)
  return true
 end
 function gate:purchaseFinished(p,id)
  if id~=deps.productId then return end
  self.pending[p]=nil -- only a verified receipt can grant a credit
  status(p,&quot;If purchased, Roblox is verifying your revive. Otherwise you can try again or restart for free.&quot;)
 end
 function gate:forget(p) self.pending[p]=nil end
 return gate
end
return Revive
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8601"><Properties><string name="Name">SpareRoomEconomy</string><ProtectedString name="Source">-- Server-authoritative, persistent shards and permanent class unlocks.
-- Every write merges in UpdateAsync; no whole-cache save on leave.
local Economy={}
function Economy.new(deps)
 local self={profiles={},locks={},pending={}}
 local function clean(d)
  d=d or {} d.balance=d.balance or 0 d.owned=d.owned or {Wanderer=true}
  d.owned.Wanderer=true d.selected=d.selected or &quot;Wanderer&quot;
  d.claims=d.claims or {} d.receipts=d.receipts or {} d.revision=d.revision or 0
  if not deps.classes[d.selected] or not d.owned[d.selected] then d.selected=&quot;Wanderer&quot; end
  return d
 end
 function self:publish(p)
  local d=self.profiles[p]
  if not d then return end
  deps.send(p,{balance=d.balance,owned=d.owned,selected=d.selected,persistent=d.persistent==true})
 end
 function self:load(p)
  if self.locks[p] then return end
  self.locks[p]=true
  local ok,data=pcall(function() return deps.store:GetAsync(&quot;u:&quot;..p.UserId) end)
  local d=clean(ok and data or nil) d.persistent=ok
  if deps.present(p) then self.profiles[p]=d self:publish(p) end
  self.locks[p]=nil
  if not ok then deps.status(p,&quot;Practice lobby: saving is unavailable. Classes and Robux packs are disabled; Wanderer is free.&quot;) end
 end
 function self:write(p,change)
  -- Do not let overlapping receipt/reward/menu requests overwrite the local display.
  while self.locks[p] do deps.wait() end
  if not deps.present(p) then return false end
  self.locks[p]=true
  local ok,data=pcall(function()
   return deps.store:UpdateAsync(&quot;u:&quot;..p.UserId,function(old)
    local d=clean(old) change(d) d.revision+=1 return d
   end)
  end)
  if ok and deps.present(p) then data.persistent=true self.profiles[p]=data self:publish(p) end
  self.locks[p]=nil
  return ok,data
 end
 function self:class(p)
  local d=self.profiles[p]
  return d and d.selected or &quot;Wanderer&quot;
 end
 function self:unlock(p,id)
  local c=deps.classes[id]
  if not c or not deps.lobby(p) then return end
  local d=self.profiles[p]
  if not d or not d.persistent then deps.status(p,&quot;Class saving is unavailable. Wanderer is still free.&quot;) return end
  local ok,data=self:write(p,function(row)
   if not row.owned[id] and row.balance&gt;=c.cost then row.balance-=c.cost row.owned[id]=true end
   if row.owned[id] then row.selected=id end
  end)
  if not ok then deps.status(p,&quot;Could not save the class change. Please retry.&quot;)
  elseif data.selected~=id then deps.status(p,&quot;Not enough Memory Shards. Earn them by finding new diary pages and endings.&quot;) end
 end
 function self:award(p,key,amount)
  local d=self.profiles[p]
  if not d or not d.persistent or d.claims[key] then return end
  local ok=self:write(p,function(row)
   if not row.claims[key] then row.claims[key]=true row.balance+=amount end
  end)
  if not ok then deps.status(p,&quot;A shard reward could not be saved. Discover it again when saving is available.&quot;) end
 end
 function self:receipt(info)
  local amount=deps.products[info.ProductId]
  if not amount or type(info.PurchaseId)~=&quot;string&quot; or info.PurchaseId==&quot;&quot; then return false end
  local p=deps.player(info.PlayerId) if not p then return false end
  local ok=self:write(p,function(row)
   if not row.receipts[info.PurchaseId] then row.receipts[info.PurchaseId]=true row.balance+=amount end
  end)
  if ok then self.pending[p]=nil deps.status(p,&quot;Memory Shards saved. You can spend them on permanent classes in the lobby.&quot;) end
  return ok -- acknowledge only after benefit and receipt ID are durably saved together
 end
 function self:buy(p,id)
  local d=self.profiles[p]
  if not deps.lobby(p) or not deps.products[id] or not deps.ready() or self.pending[p] then return end
  if not d or not d.persistent then deps.status(p,&quot;Purchases are disabled while saving is unavailable.&quot;) return end
  -- Probe the ledger immediately before checkout; never charge against a known outage.
  local ok=self:write(p,function() end)
  if not ok then deps.status(p,&quot;Purchase storage is unavailable. Nothing was opened.&quot;) return end
  self.pending[p]=true
  local shown=pcall(function() deps.market:PromptProductPurchase(p,id) end)
  if not shown then self.pending[p]=nil deps.status(p,&quot;Roblox checkout could not open. Please try later.&quot;) end
 end
 function self:closed(p,id) if deps.products[id] then self.pending[p]=nil end end
 function self:forget(p) self.profiles[p]=nil self.pending[p]=nil end
 return self
end
return Economy
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8602"><Properties><string name="Name">SpareRoomLobby</string><ProtectedString name="Source">-- Waiting areas form departure groups; gameplay remains in this shared prototype world.
local Lobby={}
function Lobby.new(deps)
 local self={queues={},membership={},clock=0,serial=0}
 function self:send(p)
  local mode=self.membership[p] local q=mode and self.queues[mode]
  deps.send(p,{mode=mode,members=q and #q.players or 0,seconds=q and math.max(0,math.ceil(q.deadline-self.clock)) or 0})
 end
 function self:leave(p)
  local mode=self.membership[p] self.membership[p]=nil
  local q=mode and self.queues[mode]
  if q then
   for i=#q.players,1,-1 do if q.players[i]==p then table.remove(q.players,i) end end
   if #q.players==0 then self.queues[mode]=nil else for _,other in ipairs(q.players) do self:send(other) end end
  end
  self:send(p)
 end
 function self:join(p,mode)
  if not deps.modes[mode] or not deps.available(p) then return end
  if self.membership[p]==mode then self:send(p) return end
  local q=self.queues[mode]
  if q and #q.players&gt;=4 then deps.status(p,&quot;That bus is full. Try another difficulty or depart solo.&quot;) return end
  self:leave(p)
  q=self.queues[mode] or {players={},deadline=self.clock+15}
  self.queues[mode]=q table.insert(q.players,p) self.membership[p]=mode
  deps.move(p,mode)
  for _,other in ipairs(q.players) do self:send(other) end
 end
 function self:step(dt)
  self.clock+=dt
  local departures={}
  for mode,q in pairs(self.queues) do
   if self.clock&gt;=q.deadline then table.insert(departures,{mode=mode,players=q.players})
   else for _,p in ipairs(q.players) do self:send(p) end end
  end
  for _,group in ipairs(departures) do
   self.queues[group.mode]=nil self.serial+=1
   for _,p in ipairs(group.players) do
    self.membership[p]=nil self:send(p)
    if deps.available(p) then deps.start(p,group.mode,self.serial) end
   end
  end
 end
 return self
end
return Lobby
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8603"><Properties><string name="Name">SpareRoomContent</string><ProtectedString name="Source">-- Generated from the published original game source. Do not hand-edit narrative text.
return {[&quot;BENEATH&quot;]={[&quot;title&quot;]=&quot;THE SPARE ROOM v3.0.0 — BENEATH THE HOUSE&quot;,[&quot;tagline&quot;]=&quot;There was always something underneath.&quot;,[&quot;rooms&quot;]={{[&quot;id&quot;]=&quot;storage&quot;,[&quot;name&quot;]=&quot;Storage Room&quot;,[&quot;purpose&quot;]=&quot;Unpack a history nobody labelled.&quot;,[&quot;set&quot;]=&quot;Dusty shelves, folded blankets, a travel trunk and a ledger of boxes.&quot;,[&quot;contradiction&quot;]=&quot;The handwriting on a recent box matches an old school label.&quot;,[&quot;progression&quot;]=&quot;Inventory boxes; find the archive key.&quot;,[&quot;side&quot;]=-1,[&quot;row&quot;]=0},{[&quot;id&quot;]=&quot;boiler&quot;,[&quot;name&quot;]=&quot;Boiler Room&quot;,[&quot;purpose&quot;]=&quot;Give the house a rhythm that is not a voice.&quot;,[&quot;set&quot;]=&quot;Copper pipes, pressure gauges, condensate, a service bench and an isolated valve.&quot;,[&quot;contradiction&quot;]=&quot;Four branches are labelled BEDROOM. The house has fewer bedrooms.&quot;,[&quot;progression&quot;]=&quot;Choose whether to stop the knocking pipe or keep its rhythm.&quot;,[&quot;side&quot;]=1,[&quot;row&quot;]=0},{[&quot;id&quot;]=&quot;tunnel&quot;,[&quot;name&quot;]=&quot;Maintenance Tunnel&quot;,[&quot;purpose&quot;]=&quot;Follow domestic repairs into unfamiliar space.&quot;,[&quot;set&quot;]=&quot;Narrow service racks, cable trays, wall access panels and a measured central route.&quot;,[&quot;contradiction&quot;]=&quot;A maintenance distance is longer on the return journey.&quot;,[&quot;progression&quot;]=&quot;Mark a route and recover the observation key.&quot;,[&quot;side&quot;]=-1,[&quot;row&quot;]=1},{[&quot;id&quot;]=&quot;archive&quot;,[&quot;name&quot;]=&quot;Archive Room&quot;,[&quot;purpose&quot;]=&quot;Compare records without assuming they are reliable.&quot;,[&quot;set&quot;]=&quot;Flat files, labelled archive boxes, school registers and a family index.&quot;,[&quot;contradiction&quot;]=&quot;Two originals carry the same document number and different household totals.&quot;,[&quot;progression&quot;]=&quot;Use the storage key; compare the conflicting records; find the study key.&quot;,[&quot;side&quot;]=1,[&quot;row&quot;]=1},{[&quot;id&quot;]=&quot;family&quot;,[&quot;name&quot;]=&quot;Forgotten Family Room&quot;,[&quot;purpose&quot;]=&quot;Recognise habits before recognising faces.&quot;,[&quot;set&quot;]=&quot;An ordinary sofa, a low table, extra chairs, a cardigan and an unplugged radio.&quot;,[&quot;contradiction&quot;]=&quot;The furniture is worn where no one is supposed to have sat.&quot;,[&quot;progression&quot;]=&quot;Lay out photographs, set places and listen to the radio.&quot;,[&quot;side&quot;]=-1,[&quot;row&quot;]=2},{[&quot;id&quot;]=&quot;study&quot;,[&quot;name&quot;]=&quot;Hidden Study&quot;,[&quot;purpose&quot;]=&quot;Encounter the possibility of Dad through his work.&quot;,[&quot;set&quot;]=&quot;Drafting tools, unfinished letters, a desk lamp and a chair facing away from the door.&quot;,[&quot;contradiction&quot;]=&quot;One letter is signed Dad; another matching draft is unsigned.&quot;,[&quot;progression&quot;]=&quot;Use the archive key; assemble and choose what to do with the drafts.&quot;,[&quot;side&quot;]=1,[&quot;row&quot;]=2},{[&quot;id&quot;]=&quot;sealed&quot;,[&quot;name&quot;]=&quot;Sealed Corridor&quot;,[&quot;purpose&quot;]=&quot;Reach an omission somebody took care to preserve.&quot;,[&quot;set&quot;]=&quot;Bricked door outlines, inspection tags, chalk measurements and a single accessible doorway.&quot;,[&quot;contradiction&quot;]=&quot;Room numbers skip a number twice, in different places.&quot;,[&quot;progression&quot;]=&quot;Isolate the noisy pipe and use the observation key.&quot;,[&quot;side&quot;]=-1,[&quot;row&quot;]=3},{[&quot;id&quot;]=&quot;observation&quot;,[&quot;name&quot;]=&quot;Observation Room&quot;,[&quot;purpose&quot;]=&quot;Question who was studying whom.&quot;,[&quot;set&quot;]=&quot;An internal window, an empty recording desk and chairs facing the family room.&quot;,[&quot;contradiction&quot;]=&quot;A report describes the observer using the player’s childhood nickname.&quot;,[&quot;progression&quot;]=&quot;Use the tunnel key; compare the glass, log and empty tape spool.&quot;,[&quot;side&quot;]=1,[&quot;row&quot;]=3},{[&quot;id&quot;]=&quot;children&quot;,[&quot;name&quot;]=&quot;Former Children’s Area&quot;,[&quot;purpose&quot;]=&quot;Find the traces of more than one childhood.&quot;,[&quot;set&quot;]=&quot;Two narrow bed frames, low hooks, a drawing wall, height marks and a toy shelf.&quot;,[&quot;contradiction&quot;]=&quot;Three height columns have two dates. The pencil heights do not fit the dates.&quot;,[&quot;progression&quot;]=&quot;Match drawings and height marks; discover the chamber key.&quot;,[&quot;side&quot;]=-1,[&quot;row&quot;]=4},{[&quot;id&quot;]=&quot;chamber&quot;,[&quot;name&quot;]=&quot;Locked Chamber&quot;,[&quot;purpose&quot;]=&quot;Find a question that resists becoming an answer.&quot;,[&quot;set&quot;]=&quot;A plain room, two chairs, an unfinished family inventory and an unpowered door mechanism.&quot;,[&quot;contradiction&quot;]=&quot;Its inventory describes furniture the player has just moved elsewhere.&quot;,[&quot;progression&quot;]=&quot;Use the chamber key, twelve diary entries and three family records. Make an interpretation, not a revelation.&quot;,[&quot;side&quot;]=1,[&quot;row&quot;]=4}},[&quot;diary&quot;]={{[&quot;id&quot;]=&quot;diary1&quot;,[&quot;number&quot;]=1,[&quot;title&quot;]=&quot;The long table&quot;,[&quot;text&quot;]=&quot;Mum made toast and Dad drew a boat in the butter. We argued about who got the crooked slice. I counted four cups before anyone sat down. I am writing that because I always forget ordinary things.&quot;},{[&quot;id&quot;]=&quot;diary2&quot;,[&quot;number&quot;]=2,[&quot;title&quot;]=&quot;Our marks&quot;,[&quot;text&quot;]=&quot;We measured ourselves by the kitchen door. Mine is the bent line. The straight one belongs to the person who insists they are taller. Dad wrote the date twice because the first date looked wrong.&quot;},{[&quot;id&quot;]=&quot;diary3&quot;,[&quot;number&quot;]=3,[&quot;title&quot;]=&quot;Saturday rain&quot;,[&quot;text&quot;]=&quot;We made a tent from two sheets. Mum said not to block the hallway. Someone kept putting a fourth cushion inside. We left it there. It made a good roof support.&quot;},{[&quot;id&quot;]=&quot;diary4&quot;,[&quot;number&quot;]=4,[&quot;title&quot;]=&quot;The school photograph&quot;,[&quot;text&quot;]=&quot;Our class photographs came home. There are two envelopes with our surname and one with no name. Mum put the empty one in the drawer before I could see whether it was empty.&quot;},{[&quot;id&quot;]=&quot;diary5&quot;,[&quot;number&quot;]=5,[&quot;title&quot;]=&quot;Dad’s coat&quot;,[&quot;text&quot;]=&quot;Dad let me carry his coat upstairs. It smelled of rain and the workshop. The pockets were full of small screws. One pocket had a key labelled RETURN, though I do not know what it returns.&quot;},{[&quot;id&quot;]=&quot;diary6&quot;,[&quot;number&quot;]=6,[&quot;title&quot;]=&quot;The other bed&quot;,[&quot;text&quot;]=&quot;We swapped beds after the argument about the window. In the morning everybody said there had only ever been one bed. The floor is still lighter where the other feet stood.&quot;},{[&quot;id&quot;]=&quot;diary7&quot;,[&quot;number&quot;]=7,[&quot;title&quot;]=&quot;The room at the end&quot;,[&quot;text&quot;]=&quot;There is a room at the end of the hall. I thought it belonged to our visitor. Nobody remembers inviting a visitor. Mum told me to leave the clean towel outside it anyway.&quot;},{[&quot;id&quot;]=&quot;diary8&quot;,[&quot;number&quot;]=8,[&quot;title&quot;]=&quot;Knocking practice&quot;,[&quot;text&quot;]=&quot;Three knocks mean come in. Two mean wait. Tonight someone knocked twice from the wall beside my pillow. I waited. It seems rude to leave someone waiting, even if there is no door.&quot;},{[&quot;id&quot;]=&quot;diary9&quot;,[&quot;number&quot;]=9,[&quot;title&quot;]=&quot;A quiet argument&quot;,[&quot;text&quot;]=&quot;Dad said keeping a room was not the same as keeping a person. Mum said he had agreed before. They stopped when I entered. There were four unfinished cups on the table, all still warm.&quot;},{[&quot;id&quot;]=&quot;diary10&quot;,[&quot;number&quot;]=10,[&quot;title&quot;]=&quot;The spare name&quot;,[&quot;text&quot;]=&quot;My report has a name crossed out beneath mine. The teacher says she never wrote it. Her pen left the same little hook on every letter. I have copied the hook here so it cannot disappear.&quot;},{[&quot;id&quot;]=&quot;diary11&quot;,[&quot;number&quot;]=11,[&quot;title&quot;]=&quot;Yesterday’s drawing&quot;,[&quot;text&quot;]=&quot;My drawing has changed. I remember giving the tall person five fingers. Now the tall person is a door, but the hand is still there. Mum says I have always drawn buildings.&quot;},{[&quot;id&quot;]=&quot;diary12&quot;,[&quot;number&quot;]=12,[&quot;title&quot;]=&quot;Someone’s birthday&quot;,[&quot;text&quot;]=&quot;We lit candles without a cake. Mum said it was not a birthday. Dad could not remember why he had bought the candles. There are marks on the table from a cake tin that will not fit our cupboard.&quot;},{[&quot;id&quot;]=&quot;diary13&quot;,[&quot;number&quot;]=13,[&quot;title&quot;]=&quot;The missing pronoun&quot;,[&quot;text&quot;]=&quot;I wrote WE WENT HOME. This morning it says I WENT HOME. The space is too wide for I. I keep trying to remember whose hand I was holding, and remembering a different sleeve.&quot;},{[&quot;id&quot;]=&quot;diary14&quot;,[&quot;number&quot;]=14,[&quot;title&quot;]=&quot;A longer landing&quot;,[&quot;text&quot;]=&quot;It took seventeen steps to reach the bathroom. I counted twelve on the way back. Dad marked the wall with tape. In the evening the tape was wrapped around his wrist like he had always worn it.&quot;},{[&quot;id&quot;]=&quot;diary15&quot;,[&quot;number&quot;]=15,[&quot;title&quot;]=&quot;The voice downstairs&quot;,[&quot;text&quot;]=&quot;Someone read my first page aloud from underneath the floor. They made the same mistake over the word crooked. I do not remember writing that mistake. I do remember being corrected.&quot;},{[&quot;id&quot;]=&quot;diary16&quot;,[&quot;number&quot;]=16,[&quot;title&quot;]=&quot;Our own handwriting&quot;,[&quot;text&quot;]=&quot;There are two kinds of handwriting in this book. The second kind calls the first kind a liar. Both make the same spelling mistakes. I am leaving the mistakes where they are.&quot;},{[&quot;id&quot;]=&quot;diary17&quot;,[&quot;number&quot;]=17,[&quot;title&quot;]=&quot;The person in the photograph&quot;,[&quot;text&quot;]=&quot;Dad is missing from one photograph. In the next he is holding the camera, though I can see both his hands in the picture. Mum knows which coat was his. She cannot say what he looked like.&quot;},{[&quot;id&quot;]=&quot;diary18&quot;,[&quot;number&quot;]=18,[&quot;title&quot;]=&quot;A room set aside&quot;,[&quot;text&quot;]=&quot;We carried boxes to the room that is not on the plan. I remember doing it alone. My arms hurt in four places, as if someone else had been holding the same box.&quot;},{[&quot;id&quot;]=&quot;diary19&quot;,[&quot;number&quot;]=19,[&quot;title&quot;]=&quot;If you find this&quot;,[&quot;text&quot;]=&quot;If you find this, do not decide too quickly who I was. I have been your sibling in some memories and your visitor in others. The room remembers a name. It will not tell me whether the name was mine.&quot;},{[&quot;id&quot;]=&quot;diary20&quot;,[&quot;number&quot;]=20,[&quot;title&quot;]=&quot;An ordinary morning&quot;,[&quot;text&quot;]=&quot;Today we had toast. Someone asked for the crooked slice. There were places for everybody, which is not the same as knowing how many people there were. Please leave this page unfinished. I would like tomorrow to have somewhere to go.&quot;}},[&quot;anomalies&quot;]={{[&quot;id&quot;]=&quot;portrait&quot;,[&quot;name&quot;]=&quot;The Removed Face&quot;,[&quot;room&quot;]=&quot;family&quot;,[&quot;description&quot;]=&quot;A photograph loses one silhouette, leaving a clean patch rather than a torn surface.&quot;,[&quot;visual&quot;]=&quot;A frame alternates between three and four silhouettes only after the player looks away.&quot;,[&quot;interaction&quot;]=&quot;Inspect both versions; record a contradiction, not a name.&quot;},{[&quot;id&quot;]=&quot;chair&quot;,[&quot;name&quot;]=&quot;One More Place&quot;,[&quot;room&quot;]=&quot;family&quot;,[&quot;description&quot;]=&quot;A fourth chair appears at the table. Its legs are free of dust.&quot;,[&quot;visual&quot;]=&quot;A spare chair is enabled behind the player after a turn.&quot;,[&quot;interaction&quot;]=&quot;Count the chairs and inspect the extra seat.&quot;},{[&quot;id&quot;]=&quot;names&quot;,[&quot;name&quot;]=&quot;Carbon Names&quot;,[&quot;room&quot;]=&quot;archive&quot;,[&quot;description&quot;]=&quot;Names emerge on a blank carbon sheet, then overlap.&quot;,[&quot;visual&quot;]=&quot;A document label reveals an additional line in oblique light.&quot;,[&quot;interaction&quot;]=&quot;Read before and after switching the desk lamp.&quot;},{[&quot;id&quot;]=&quot;breath&quot;,[&quot;name&quot;]=&quot;Breathing Plaster&quot;,[&quot;room&quot;]=&quot;sealed&quot;,[&quot;description&quot;]=&quot;The wall expands by a few centimetres with the boiler rhythm.&quot;,[&quot;visual&quot;]=&quot;A bounded wall inset scales slowly; collision stays fixed.&quot;,[&quot;interaction&quot;]=&quot;Watch a full cycle from a safe distance.&quot;},{[&quot;id&quot;]=&quot;drawer&quot;,[&quot;name&quot;]=&quot;The Returning Drawer&quot;,[&quot;room&quot;]=&quot;study&quot;,[&quot;description&quot;]=&quot;A shut drawer reopens with a different small possession inside.&quot;,[&quot;visual&quot;]=&quot;A drawer slides back within its desk footprint.&quot;,[&quot;interaction&quot;]=&quot;Close it twice and inspect the returned object.&quot;},{[&quot;id&quot;]=&quot;ink&quot;,[&quot;name&quot;]=&quot;A Second Report&quot;,[&quot;room&quot;]=&quot;archive&quot;,[&quot;description&quot;]=&quot;A school report adds another pupil using the same registration number.&quot;,[&quot;visual&quot;]=&quot;A second report plane appears beside the first.&quot;,[&quot;interaction&quot;]=&quot;Compare the two copies.&quot;},{[&quot;id&quot;]=&quot;clock&quot;,[&quot;name&quot;]=&quot;The Uncounted Minute&quot;,[&quot;room&quot;]=&quot;boiler&quot;,[&quot;description&quot;]=&quot;A clock hand travels backwards while the pipe keeps time.&quot;,[&quot;visual&quot;]=&quot;Clock hands reverse; world time continues normally.&quot;,[&quot;interaction&quot;]=&quot;Listen through six ticks.&quot;},{[&quot;id&quot;]=&quot;coat&quot;,[&quot;name&quot;]=&quot;Small Shoulders&quot;,[&quot;room&quot;]=&quot;storage&quot;,[&quot;description&quot;]=&quot;A child’s coat lifts as if occupied, then hangs empty.&quot;,[&quot;visual&quot;]=&quot;A cloth-shaped rig rises and settles without approaching.&quot;,[&quot;interaction&quot;]=&quot;Look away and inspect the hook.&quot;},{[&quot;id&quot;]=&quot;chalk&quot;,[&quot;name&quot;]=&quot;The Taller Mark&quot;,[&quot;room&quot;]=&quot;children&quot;,[&quot;description&quot;]=&quot;A pencil height mark rises above the adult line.&quot;,[&quot;visual&quot;]=&quot;One measured line slides upward within the board.&quot;,[&quot;interaction&quot;]=&quot;Compare it with the school dates.&quot;},{[&quot;id&quot;]=&quot;cups&quot;,[&quot;name&quot;]=&quot;Still Warm&quot;,[&quot;room&quot;]=&quot;family&quot;,[&quot;description&quot;]=&quot;Steam rises from cups on an unpowered table.&quot;,[&quot;visual&quot;]=&quot;Three pooled translucent wisps rise over four cups.&quot;,[&quot;interaction&quot;]=&quot;Inspect the unconnected kettle.&quot;},{[&quot;id&quot;]=&quot;steps&quot;,[&quot;name&quot;]=&quot;The Other Footfall&quot;,[&quot;room&quot;]=&quot;tunnel&quot;,[&quot;description&quot;]=&quot;A second footstep continues after the player stops.&quot;,[&quot;visual&quot;]=&quot;Two quiet beats and a caption trail the stopped player.&quot;,[&quot;interaction&quot;]=&quot;Stand still until the extra step ends.&quot;},{[&quot;id&quot;]=&quot;page&quot;,[&quot;name&quot;]=&quot;Borrowed Page&quot;,[&quot;room&quot;]=&quot;storage&quot;,[&quot;description&quot;]=&quot;A diary page appears on a shelf after it was filed.&quot;,[&quot;visual&quot;]=&quot;An apparition of a collected page appears; it cannot duplicate inventory.&quot;,[&quot;interaction&quot;]=&quot;Inspect the apparition to record it.&quot;},{[&quot;id&quot;]=&quot;shadow&quot;,[&quot;name&quot;]=&quot;The Wrong Height&quot;,[&quot;room&quot;]=&quot;children&quot;,[&quot;description&quot;]=&quot;The player’s shadow has a child’s proportions.&quot;,[&quot;visual&quot;]=&quot;A floor decal shortens while the camera and body stay unchanged.&quot;,[&quot;interaction&quot;]=&quot;Watch the shadow without moving.&quot;},{[&quot;id&quot;]=&quot;radio&quot;,[&quot;name&quot;]=&quot;The Dinner Call&quot;,[&quot;room&quot;]=&quot;family&quot;,[&quot;description&quot;]=&quot;The disconnected radio counts places for dinner.&quot;,[&quot;visual&quot;]=&quot;A radio dial glows and four quiet pulses play with captions.&quot;,[&quot;interaction&quot;]=&quot;Listen without turning it on.&quot;},{[&quot;id&quot;]=&quot;door&quot;,[&quot;name&quot;]=&quot;The Inside Handle&quot;,[&quot;room&quot;]=&quot;sealed&quot;,[&quot;description&quot;]=&quot;A handle turns on the bricked outline of a door.&quot;,[&quot;visual&quot;]=&quot;A brass handle rotates on a solid wall.&quot;,[&quot;interaction&quot;]=&quot;Wait for it to stop; no traversable door is created.&quot;},{[&quot;id&quot;]=&quot;boxes&quot;,[&quot;name&quot;]=&quot;The Different Initials&quot;,[&quot;room&quot;]=&quot;storage&quot;,[&quot;description&quot;]=&quot;Boxes reorder their initials while the objects remain in place.&quot;,[&quot;visual&quot;]=&quot;Three labels change once when unseen.&quot;,[&quot;interaction&quot;]=&quot;Read two different arrangements.&quot;},{[&quot;id&quot;]=&quot;glass&quot;,[&quot;name&quot;]=&quot;The Occupied Reflection&quot;,[&quot;room&quot;]=&quot;observation&quot;,[&quot;description&quot;]=&quot;The glass shows occupied chairs where the real room is empty.&quot;,[&quot;visual&quot;]=&quot;Faint stationary silhouettes appear behind the pane.&quot;,[&quot;interaction&quot;]=&quot;Inspect the pane and the chairs.&quot;},{[&quot;id&quot;]=&quot;pipe&quot;,[&quot;name&quot;]=&quot;A Knock Returned&quot;,[&quot;room&quot;]=&quot;boiler&quot;,[&quot;description&quot;]=&quot;The pipe repeats a rhythm with one additional beat.&quot;,[&quot;visual&quot;]=&quot;A valve wheel pulses in time with captioned tapping.&quot;,[&quot;interaction&quot;]=&quot;Answer using the rhythm control.&quot;},{[&quot;id&quot;]=&quot;drawing&quot;,[&quot;name&quot;]=&quot;Five Windows&quot;,[&quot;room&quot;]=&quot;children&quot;,[&quot;description&quot;]=&quot;A drawing gains a window in a wall with no room behind it.&quot;,[&quot;visual&quot;]=&quot;A fifth cut-out window lights up on the drawing board.&quot;,[&quot;interaction&quot;]=&quot;Compare the drawing with the floor plan.&quot;},{[&quot;id&quot;]=&quot;label&quot;,[&quot;name&quot;]=&quot;Room Zero&quot;,[&quot;room&quot;]=&quot;tunnel&quot;,[&quot;description&quot;]=&quot;An inspection plate changes its room number to zero.&quot;,[&quot;visual&quot;]=&quot;A small sign flips between two numbered faces.&quot;,[&quot;interaction&quot;]=&quot;Inspect the plate after the flip.&quot;},{[&quot;id&quot;]=&quot;lamp&quot;,[&quot;name&quot;]=&quot;Someone Working&quot;,[&quot;room&quot;]=&quot;study&quot;,[&quot;description&quot;]=&quot;The desk lamp bends toward the empty chair.&quot;,[&quot;visual&quot;]=&quot;An articulated lamp pivots slowly once.&quot;,[&quot;interaction&quot;]=&quot;Stay outside the desk footprint and observe.&quot;},{[&quot;id&quot;]=&quot;frost&quot;,[&quot;name&quot;]=&quot;A Handprint Inside&quot;,[&quot;room&quot;]=&quot;observation&quot;,[&quot;description&quot;]=&quot;A warm palm-shaped clearing appears on the far side of cold glass.&quot;,[&quot;visual&quot;]=&quot;A translucent handprint fades in behind the window.&quot;,[&quot;interaction&quot;]=&quot;Inspect the far side without touching it.&quot;},{[&quot;id&quot;]=&quot;scale&quot;,[&quot;name&quot;]=&quot;The Long Return&quot;,[&quot;room&quot;]=&quot;tunnel&quot;,[&quot;description&quot;]=&quot;Perspective makes the exit seem farther away after turning.&quot;,[&quot;visual&quot;]=&quot;Non-colliding repeated arch details compress visually; real route dimensions stay fixed.&quot;,[&quot;interaction&quot;]=&quot;Walk to the original survey mark.&quot;},{[&quot;id&quot;]=&quot;inventory&quot;,[&quot;name&quot;]=&quot;Already Unpacked&quot;,[&quot;room&quot;]=&quot;chamber&quot;,[&quot;description&quot;]=&quot;An inventory lists the player’s current arrangement before it is made.&quot;,[&quot;visual&quot;]=&quot;A document lists the flags last chosen in the family room.&quot;,[&quot;interaction&quot;]=&quot;Compare the list with the family table.&quot;},{[&quot;id&quot;]=&quot;lullaby&quot;,[&quot;name&quot;]=&quot;The Missing Singer&quot;,[&quot;room&quot;]=&quot;children&quot;,[&quot;description&quot;]=&quot;An instrument plays a lullaby with a silent space where a voice should be.&quot;,[&quot;visual&quot;]=&quot;A toy music wheel rotates through a captioned missing verse.&quot;,[&quot;interaction&quot;]=&quot;Let the entire verse finish.&quot;}},[&quot;endings&quot;]={{[&quot;id&quot;]=&quot;places&quot;,[&quot;category&quot;]=&quot;Family&quot;,[&quot;name&quot;]=&quot;Places for Everyone&quot;,[&quot;requirements&quot;]={[&quot;items&quot;]={&quot;photo1&quot;,&quot;photo2&quot;},[&quot;flags&quot;]={&quot;places&quot;}},[&quot;description&quot;]=&quot;You set a place for every person suggested by the photographs. Mum adds one more cup, then sits down without explaining it.&quot;,[&quot;achievement&quot;]=&quot;A Table Kept&quot;,[&quot;lore&quot;]=&quot;Acknowledges possible relatives without assigning identities.&quot;,[&quot;number&quot;]=32},{[&quot;id&quot;]=&quot;coat-home&quot;,[&quot;category&quot;]=&quot;Family&quot;,[&quot;name&quot;]=&quot;The Coat at the Door&quot;,[&quot;requirements&quot;]={[&quot;items&quot;]={&quot;dad1&quot;,&quot;photo3&quot;},[&quot;flags&quot;]={&quot;letters&quot;}},[&quot;description&quot;]=&quot;You leave the coat where someone could collect it. In the morning it is dry. The hook is still warm.&quot;,[&quot;achievement&quot;]=&quot;Expected Home&quot;,[&quot;lore&quot;]=&quot;Dad remains an inference from belongings and drafts.&quot;,[&quot;number&quot;]=33},{[&quot;id&quot;]=&quot;two-beds&quot;,[&quot;category&quot;]=&quot;Family&quot;,[&quot;name&quot;]=&quot;Neither Bed Empty&quot;,[&quot;requirements&quot;]={[&quot;items&quot;]={&quot;drawing1&quot;,&quot;drawing2&quot;},[&quot;flags&quot;]={&quot;beds&quot;}},[&quot;description&quot;]=&quot;You make both beds. One mattress settles after the light goes out. You decide not to check which one.&quot;,[&quot;achievement&quot;]=&quot;Room for Two&quot;,[&quot;lore&quot;]=&quot;Supports a sibling reading while preserving uncertainty.&quot;,[&quot;number&quot;]=34},{[&quot;id&quot;]=&quot;ask-mum&quot;,[&quot;category&quot;]=&quot;Family&quot;,[&quot;name&quot;]=&quot;The Question at Breakfast&quot;,[&quot;requirements&quot;]={[&quot;diary&quot;]=6,[&quot;items&quot;]={&quot;record1&quot;},[&quot;flags&quot;]={&quot;mum&quot;}},[&quot;description&quot;]=&quot;Mum listens to the names you found. She says she remembers the sound of them, but asks you not to supply the faces.&quot;,[&quot;achievement&quot;]=&quot;Ask Gently&quot;,[&quot;lore&quot;]=&quot;Mum is a witness with incomplete memories, not an exposition source.&quot;,[&quot;number&quot;]=35},{[&quot;id&quot;]=&quot;isolate&quot;,[&quot;category&quot;]=&quot;Basement&quot;,[&quot;name&quot;]=&quot;A Quiet Circuit&quot;,[&quot;requirements&quot;]={[&quot;items&quot;]={&quot;dad2&quot;},[&quot;flags&quot;]={&quot;valve&quot;,&quot;power&quot;}},[&quot;description&quot;]=&quot;The boiler stops knocking. Somewhere upstairs a chair is drawn back. The house has found another way to be heard.&quot;,[&quot;achievement&quot;]=&quot;Circuit Open&quot;,[&quot;lore&quot;]=&quot;Silencing one mechanism does not resolve the house.&quot;,[&quot;number&quot;]=36},{[&quot;id&quot;]=&quot;route&quot;,[&quot;category&quot;]=&quot;Basement&quot;,[&quot;name&quot;]=&quot;The Measured Way Out&quot;,[&quot;requirements&quot;]={[&quot;items&quot;]={&quot;record2&quot;},[&quot;flags&quot;]={&quot;route&quot;}},[&quot;description&quot;]=&quot;You follow the marked distances to the stairs. Your final measurement leaves a person-sized space unaccounted for.&quot;,[&quot;achievement&quot;]=&quot;Keep the Measure&quot;,[&quot;lore&quot;]=&quot;Physical records can be useful and still incomplete.&quot;,[&quot;number&quot;]=37},{[&quot;id&quot;]=&quot;seal&quot;,[&quot;category&quot;]=&quot;Basement&quot;,[&quot;name&quot;]=&quot;Maintained in Absence&quot;,[&quot;requirements&quot;]={[&quot;items&quot;]={&quot;letter1&quot;},[&quot;flags&quot;]={&quot;seal&quot;,&quot;valve&quot;}},[&quot;description&quot;]=&quot;You renew the inspection seal. By morning the signature beneath yours has been freshly added.&quot;,[&quot;achievement&quot;]=&quot;Seal Renewed&quot;,[&quot;lore&quot;]=&quot;An omitted place may still receive care.&quot;,[&quot;number&quot;]=38},{[&quot;id&quot;]=&quot;leave-open&quot;,[&quot;category&quot;]=&quot;Basement&quot;,[&quot;name&quot;]=&quot;Leave the Light On&quot;,[&quot;requirements&quot;]={[&quot;items&quot;]={&quot;key-chamber&quot;},[&quot;flags&quot;]={&quot;power&quot;,&quot;door&quot;}},[&quot;description&quot;]=&quot;You unlock the chamber and leave its light burning. Nobody comes out while you are watching.&quot;,[&quot;achievement&quot;]=&quot;An Open Invitation&quot;,[&quot;lore&quot;]=&quot;Offers hospitality without identifying an occupant.&quot;,[&quot;number&quot;]=39},{[&quot;id&quot;]=&quot;bind&quot;,[&quot;category&quot;]=&quot;Memory&quot;,[&quot;name&quot;]=&quot;A Book with Both Hands&quot;,[&quot;requirements&quot;]={[&quot;diary&quot;]=20,[&quot;flags&quot;]={&quot;bind&quot;}},[&quot;description&quot;]=&quot;You bind both kinds of handwriting into one volume. The last blank page remains blank until you close the cover.&quot;,[&quot;achievement&quot;]=&quot;Both Hands&quot;,[&quot;lore&quot;]=&quot;Refuses to declare either narrator authentic.&quot;,[&quot;number&quot;]=40},{[&quot;id&quot;]=&quot;contradictions&quot;,[&quot;category&quot;]=&quot;Memory&quot;,[&quot;name&quot;]=&quot;Two Originals&quot;,[&quot;requirements&quot;]={[&quot;records&quot;]=4,[&quot;flags&quot;]={&quot;compare&quot;}},[&quot;description&quot;]=&quot;You file both originals. The drawer accepts them without resistance. For once, you do not choose which version deserves to exist.&quot;,[&quot;achievement&quot;]=&quot;Keep Both Copies&quot;,[&quot;lore&quot;]=&quot;Contradictory evidence can coexist.&quot;,[&quot;number&quot;]=41},{[&quot;id&quot;]=&quot;names-kept&quot;,[&quot;category&quot;]=&quot;Memory&quot;,[&quot;name&quot;]=&quot;Names Without Faces&quot;,[&quot;requirements&quot;]={[&quot;items&quot;]={&quot;record3&quot;,&quot;letter2&quot;},[&quot;flags&quot;]={&quot;names&quot;}},[&quot;description&quot;]=&quot;You write the names without inventing faces. At dinner Mum recognises one spelling and crosses out nothing.&quot;,[&quot;achievement&quot;]=&quot;Leave the Faces Blank&quot;,[&quot;lore&quot;]=&quot;Distinguishes preserving evidence from manufacturing certainty.&quot;,[&quot;number&quot;]=42},{[&quot;id&quot;]=&quot;blank&quot;,[&quot;category&quot;]=&quot;Memory&quot;,[&quot;name&quot;]=&quot;The Unwritten Page&quot;,[&quot;requirements&quot;]={[&quot;diary&quot;]=12,[&quot;flags&quot;]={&quot;blank&quot;}},[&quot;description&quot;]=&quot;You leave a page for the person who cannot yet be described. In the quiet, a pen rolls toward it and stops.&quot;,[&quot;achievement&quot;]=&quot;Leave a Margin&quot;,[&quot;lore&quot;]=&quot;Makes room for unresolved identity.&quot;,[&quot;number&quot;]=43},{[&quot;id&quot;]=&quot;extra-seat&quot;,[&quot;category&quot;]=&quot;Anomaly&quot;,[&quot;name&quot;]=&quot;The Patient Guest&quot;,[&quot;requirements&quot;]={[&quot;anomalies&quot;]={&quot;chair&quot;},[&quot;flags&quot;]={&quot;places&quot;}},[&quot;description&quot;]=&quot;You sit beside the extra chair until morning. Its seat cools at exactly the moment yours does.&quot;,[&quot;achievement&quot;]=&quot;Wait Beside It&quot;,[&quot;lore&quot;]=&quot;An anomaly offers companionship rather than a pursuer.&quot;,[&quot;number&quot;]=44},{[&quot;id&quot;]=&quot;answer&quot;,[&quot;category&quot;]=&quot;Anomaly&quot;,[&quot;name&quot;]=&quot;One Knock More&quot;,[&quot;requirements&quot;]={[&quot;anomalies&quot;]={&quot;pipe&quot;},[&quot;flags&quot;]={&quot;answer&quot;}},[&quot;description&quot;]=&quot;You return the additional beat. The response comes from the ordinary hallway, at the height of a child’s hand.&quot;,[&quot;achievement&quot;]=&quot;Return the Beat&quot;,[&quot;lore&quot;]=&quot;Connects infrastructure to domestic memory without proving a cause.&quot;,[&quot;number&quot;]=45},{[&quot;id&quot;]=&quot;glass-guest&quot;,[&quot;category&quot;]=&quot;Anomaly&quot;,[&quot;name&quot;]=&quot;The Far Side of the Glass&quot;,[&quot;requirements&quot;]={[&quot;anomalies&quot;]={&quot;glass&quot;,&quot;frost&quot;},[&quot;flags&quot;]={&quot;glass&quot;}},[&quot;description&quot;]=&quot;You cover the observation pane. The covered surface reflects a room you are not standing in.&quot;,[&quot;achievement&quot;]=&quot;Stop Observing&quot;,[&quot;lore&quot;]=&quot;Questions the act of watching and recording.&quot;,[&quot;number&quot;]=46},{[&quot;id&quot;]=&quot;follow-step&quot;,[&quot;category&quot;]=&quot;Anomaly&quot;,[&quot;name&quot;]=&quot;Walk at Their Pace&quot;,[&quot;requirements&quot;]={[&quot;anomalies&quot;]={&quot;steps&quot;,&quot;scale&quot;},[&quot;flags&quot;]={&quot;route&quot;}},[&quot;description&quot;]=&quot;You let the second footfall set your pace. The stairs return you to an unfamiliar arrangement of familiar furniture.&quot;,[&quot;achievement&quot;]=&quot;A Shared Pace&quot;,[&quot;lore&quot;]=&quot;A path may be shared without identifying a companion.&quot;,[&quot;number&quot;]=47},{[&quot;id&quot;]=&quot;steady&quot;,[&quot;category&quot;]=&quot;Sanity&quot;,[&quot;name&quot;]=&quot;A Carefully Kept Morning&quot;,[&quot;requirements&quot;]={[&quot;diary&quot;]=8,[&quot;sanityMin&quot;]=80,[&quot;flags&quot;]={&quot;rest&quot;}},[&quot;description&quot;]=&quot;You put the evidence down, eat and wait for daylight. The questions remain. You are able to ask them tomorrow.&quot;,[&quot;achievement&quot;]=&quot;Return Tomorrow&quot;,[&quot;lore&quot;]=&quot;Self-preservation is a valid ending.&quot;,[&quot;number&quot;]=48},{[&quot;id&quot;]=&quot;uncertain&quot;,[&quot;category&quot;]=&quot;Sanity&quot;,[&quot;name&quot;]=&quot;An Honest Uncertainty&quot;,[&quot;requirements&quot;]={[&quot;records&quot;]=3,[&quot;sanityMin&quot;]=35,[&quot;sanityMax&quot;]=65,[&quot;flags&quot;]={&quot;compare&quot;}},[&quot;description&quot;]=&quot;You label the file UNCONFIRMED. The letters do not rearrange themselves. That is all the reassurance you ask for.&quot;,[&quot;achievement&quot;]=&quot;Unconfirmed&quot;,[&quot;lore&quot;]=&quot;Sanity is not a truth detector.&quot;,[&quot;number&quot;]=49},{[&quot;id&quot;]=&quot;anchor&quot;,[&quot;category&quot;]=&quot;Sanity&quot;,[&quot;name&quot;]=&quot;One Thing You Know&quot;,[&quot;requirements&quot;]={[&quot;items&quot;]={&quot;memory1&quot;,&quot;memory2&quot;},[&quot;sanityMax&quot;]=25,[&quot;sanityMin&quot;]=1,[&quot;flags&quot;]={&quot;anchor&quot;}},[&quot;description&quot;]=&quot;You hold one ordinary memory through the last of the distortion. A hand steadies yours. You do not turn to see whose.&quot;,[&quot;achievement&quot;]=&quot;Hold One Memory&quot;,[&quot;lore&quot;]=&quot;Distress never makes an interpretation definitively true.&quot;,[&quot;number&quot;]=50},{[&quot;id&quot;]=&quot;diarist&quot;,[&quot;category&quot;]=&quot;Collector&quot;,[&quot;name&quot;]=&quot;Every Page Accounted For&quot;,[&quot;requirements&quot;]={[&quot;diary&quot;]=20},[&quot;description&quot;]=&quot;You number the twenty pages. The binding has room for twenty-one. You leave the extra space in the catalogue.&quot;,[&quot;achievement&quot;]=&quot;The Unfinished Volume&quot;,[&quot;lore&quot;]=&quot;Completeness of a collection is not completeness of history.&quot;,[&quot;number&quot;]=51},{[&quot;id&quot;]=&quot;family-file&quot;,[&quot;category&quot;]=&quot;Collector&quot;,[&quot;name&quot;]=&quot;The Household File&quot;,[&quot;requirements&quot;]={[&quot;photos&quot;]=6,[&quot;records&quot;]=6},[&quot;description&quot;]=&quot;You assemble a family file. Its contents disagree. Its cover can hold them all.&quot;,[&quot;achievement&quot;]=&quot;Family Archivist&quot;,[&quot;lore&quot;]=&quot;Records preserve a larger household, not a certified family tree.&quot;,[&quot;number&quot;]=52},{[&quot;id&quot;]=&quot;drawings&quot;,[&quot;category&quot;]=&quot;Collector&quot;,[&quot;name&quot;]=&quot;The Wall at Their Height&quot;,[&quot;requirements&quot;]={[&quot;drawings&quot;]=5,[&quot;flags&quot;]={&quot;beds&quot;}},[&quot;description&quot;]=&quot;You hang every drawing at the height of its maker. One hangs above the height marks; another below the skirting.&quot;,[&quot;achievement&quot;]=&quot;At Their Height&quot;,[&quot;lore&quot;]=&quot;The children cannot be arranged into a reliable chronology.&quot;,[&quot;number&quot;]=53},{[&quot;id&quot;]=&quot;fragments&quot;,[&quot;category&quot;]=&quot;Collector&quot;,[&quot;name&quot;]=&quot;Nothing Discarded&quot;,[&quot;requirements&quot;]={[&quot;memories&quot;]=8,[&quot;letters&quot;]=4},[&quot;description&quot;]=&quot;You take every fragment to the stairs. Upstairs, a box waits with your handwriting and no date.&quot;,[&quot;achievement&quot;]=&quot;Nothing Discarded&quot;,[&quot;lore&quot;]=&quot;Collection leads to another possible history, not a final solution.&quot;,[&quot;number&quot;]=54},{[&quot;id&quot;]=&quot;zero&quot;,[&quot;category&quot;]=&quot;Secret&quot;,[&quot;name&quot;]=&quot;The Room Number Nobody Used&quot;,[&quot;requirements&quot;]={[&quot;items&quot;]={&quot;record4&quot;,&quot;key-observation&quot;},[&quot;anomalies&quot;]={&quot;label&quot;},[&quot;flags&quot;]={&quot;zero&quot;}},[&quot;description&quot;]=&quot;You enter zero in the inventory. A door clicks shut elsewhere. The corridor still contains the same number of openings.&quot;,[&quot;achievement&quot;]=&quot;Room Zero&quot;,[&quot;lore&quot;]=&quot;An absent number may refer to a person, a space or an accounting error.&quot;,[&quot;number&quot;]=55},{[&quot;id&quot;]=&quot;draft&quot;,[&quot;category&quot;]=&quot;Secret&quot;,[&quot;name&quot;]=&quot;An Unsigned Father&quot;,[&quot;requirements&quot;]={[&quot;dad&quot;]=6,[&quot;flags&quot;]={&quot;letters&quot;}},[&quot;description&quot;]=&quot;You leave the final letter unsigned. Mum calls it his handwriting, then asks whose desk you found it in.&quot;,[&quot;achievement&quot;]=&quot;Unsigned&quot;,[&quot;lore&quot;]=&quot;Keeps the father hypothesis unsettled.&quot;,[&quot;number&quot;]=56},{[&quot;id&quot;]=&quot;wrong-birthday&quot;,[&quot;category&quot;]=&quot;Secret&quot;,[&quot;name&quot;]=&quot;Candles Without a Cake&quot;,[&quot;requirements&quot;]={[&quot;items&quot;]={&quot;diary12&quot;,&quot;photo4&quot;,&quot;drawing3&quot;},[&quot;flags&quot;]={&quot;candles&quot;}},[&quot;description&quot;]=&quot;You light the unclaimed candles. Wax falls in four separate pools. Nobody says a birthday wish aloud.&quot;,[&quot;achievement&quot;]=&quot;An Unclaimed Birthday&quot;,[&quot;lore&quot;]=&quot;A shared ritual outlasts its explanation.&quot;,[&quot;number&quot;]=57},{[&quot;id&quot;]=&quot;listen-wall&quot;,[&quot;category&quot;]=&quot;Secret&quot;,[&quot;name&quot;]=&quot;A Place in the Wall&quot;,[&quot;requirements&quot;]={[&quot;anomalyCount&quot;]=10,[&quot;items&quot;]={&quot;letter3&quot;},[&quot;flags&quot;]={&quot;listen&quot;}},[&quot;description&quot;]=&quot;You spend a night listening to the wall. In the morning a recording contains only your own careful breathing.&quot;,[&quot;achievement&quot;]=&quot;Listen Without Naming&quot;,[&quot;lore&quot;]=&quot;Questions whether the listener contributes to the haunting.&quot;,[&quot;number&quot;]=58},{[&quot;id&quot;]=&quot;inventory-open&quot;,[&quot;category&quot;]=&quot;True Mystery&quot;,[&quot;name&quot;]=&quot;The Inventory Remains Open&quot;,[&quot;requirements&quot;]={[&quot;diary&quot;]=20,[&quot;records&quot;]=6,[&quot;flags&quot;]={&quot;compare&quot;,&quot;door&quot;}},[&quot;description&quot;]=&quot;You leave the household inventory open. One column is headed PRESENT. The other has no heading. Neither column stays empty.&quot;,[&quot;achievement&quot;]=&quot;An Open Inventory&quot;,[&quot;lore&quot;]=&quot;The central family question remains deliberately unanswered.&quot;,[&quot;number&quot;]=59},{[&quot;id&quot;]=&quot;no-correction&quot;,[&quot;category&quot;]=&quot;True Mystery&quot;,[&quot;name&quot;]=&quot;Do Not Correct the House&quot;,[&quot;requirements&quot;]={[&quot;anomalyCount&quot;]=25,[&quot;flags&quot;]={&quot;blank&quot;,&quot;route&quot;}},[&quot;description&quot;]=&quot;You preserve every version of the plan. The house is quieter when it is no longer being asked to agree with you.&quot;,[&quot;achievement&quot;]=&quot;No Correction Necessary&quot;,[&quot;lore&quot;]=&quot;Observation changes the relationship, not the certainty of the lore.&quot;,[&quot;number&quot;]=60},{[&quot;id&quot;]=&quot;tomorrow&quot;,[&quot;category&quot;]=&quot;True Mystery&quot;,[&quot;name&quot;]=&quot;Somewhere for Tomorrow&quot;,[&quot;requirements&quot;]={[&quot;diary&quot;]=20,[&quot;memories&quot;]=8,[&quot;flags&quot;]={&quot;mum&quot;,&quot;bind&quot;,&quot;blank&quot;}},[&quot;description&quot;]=&quot;You leave the last page unfinished. At breakfast Mum asks whether you slept well. For once you tell her about a dream instead of supplying an answer.&quot;,[&quot;achievement&quot;]=&quot;Somewhere for Tomorrow&quot;,[&quot;lore&quot;]=&quot;Begins a new era while leaving the family mystery open.&quot;,[&quot;number&quot;]=61}}},[&quot;deepItems&quot;]={{[&quot;id&quot;]=&quot;diary1&quot;,[&quot;number&quot;]=1,[&quot;title&quot;]=&quot;The long table&quot;,[&quot;text&quot;]=&quot;Mum made toast and Dad drew a boat in the butter. We argued about who got the crooked slice. I counted four cups before anyone sat down. I am writing that because I always forget ordinary things.&quot;,[&quot;type&quot;]=&quot;diary&quot;,[&quot;room&quot;]=&quot;storage&quot;},{[&quot;id&quot;]=&quot;diary2&quot;,[&quot;number&quot;]=2,[&quot;title&quot;]=&quot;Our marks&quot;,[&quot;text&quot;]=&quot;We measured ourselves by the kitchen door. Mine is the bent line. The straight one belongs to the person who insists they are taller. Dad wrote the date twice because the first date looked wrong.&quot;,[&quot;type&quot;]=&quot;diary&quot;,[&quot;room&quot;]=&quot;storage&quot;},{[&quot;id&quot;]=&quot;diary3&quot;,[&quot;number&quot;]=3,[&quot;title&quot;]=&quot;Saturday rain&quot;,[&quot;text&quot;]=&quot;We made a tent from two sheets. Mum said not to block the hallway. Someone kept putting a fourth cushion inside. We left it there. It made a good roof support.&quot;,[&quot;type&quot;]=&quot;diary&quot;,[&quot;room&quot;]=&quot;boiler&quot;},{[&quot;id&quot;]=&quot;diary4&quot;,[&quot;number&quot;]=4,[&quot;title&quot;]=&quot;The school photograph&quot;,[&quot;text&quot;]=&quot;Our class photographs came home. There are two envelopes with our surname and one with no name. Mum put the empty one in the drawer before I could see whether it was empty.&quot;,[&quot;type&quot;]=&quot;diary&quot;,[&quot;room&quot;]=&quot;boiler&quot;},{[&quot;id&quot;]=&quot;diary5&quot;,[&quot;number&quot;]=5,[&quot;title&quot;]=&quot;Dad’s coat&quot;,[&quot;text&quot;]=&quot;Dad let me carry his coat upstairs. It smelled of rain and the workshop. The pockets were full of small screws. One pocket had a key labelled RETURN, though I do not know what it returns.&quot;,[&quot;type&quot;]=&quot;diary&quot;,[&quot;room&quot;]=&quot;tunnel&quot;},{[&quot;id&quot;]=&quot;diary6&quot;,[&quot;number&quot;]=6,[&quot;title&quot;]=&quot;The other bed&quot;,[&quot;text&quot;]=&quot;We swapped beds after the argument about the window. In the morning everybody said there had only ever been one bed. The floor is still lighter where the other feet stood.&quot;,[&quot;type&quot;]=&quot;diary&quot;,[&quot;room&quot;]=&quot;tunnel&quot;},{[&quot;id&quot;]=&quot;diary7&quot;,[&quot;number&quot;]=7,[&quot;title&quot;]=&quot;The room at the end&quot;,[&quot;text&quot;]=&quot;There is a room at the end of the hall. I thought it belonged to our visitor. Nobody remembers inviting a visitor. Mum told me to leave the clean towel outside it anyway.&quot;,[&quot;type&quot;]=&quot;diary&quot;,[&quot;room&quot;]=&quot;archive&quot;},{[&quot;id&quot;]=&quot;diary8&quot;,[&quot;number&quot;]=8,[&quot;title&quot;]=&quot;Knocking practice&quot;,[&quot;text&quot;]=&quot;Three knocks mean come in. Two mean wait. Tonight someone knocked twice from the wall beside my pillow. I waited. It seems rude to leave someone waiting, even if there is no door.&quot;,[&quot;type&quot;]=&quot;diary&quot;,[&quot;room&quot;]=&quot;archive&quot;},{[&quot;id&quot;]=&quot;diary9&quot;,[&quot;number&quot;]=9,[&quot;title&quot;]=&quot;A quiet argument&quot;,[&quot;text&quot;]=&quot;Dad said keeping a room was not the same as keeping a person. Mum said he had agreed before. They stopped when I entered. There were four unfinished cups on the table, all still warm.&quot;,[&quot;type&quot;]=&quot;diary&quot;,[&quot;room&quot;]=&quot;family&quot;},{[&quot;id&quot;]=&quot;diary10&quot;,[&quot;number&quot;]=10,[&quot;title&quot;]=&quot;The spare name&quot;,[&quot;text&quot;]=&quot;My report has a name crossed out beneath mine. The teacher says she never wrote it. Her pen left the same little hook on every letter. I have copied the hook here so it cannot disappear.&quot;,[&quot;type&quot;]=&quot;diary&quot;,[&quot;room&quot;]=&quot;family&quot;},{[&quot;id&quot;]=&quot;diary11&quot;,[&quot;number&quot;]=11,[&quot;title&quot;]=&quot;Yesterday’s drawing&quot;,[&quot;text&quot;]=&quot;My drawing has changed. I remember giving the tall person five fingers. Now the tall person is a door, but the hand is still there. Mum says I have always drawn buildings.&quot;,[&quot;type&quot;]=&quot;diary&quot;,[&quot;room&quot;]=&quot;study&quot;},{[&quot;id&quot;]=&quot;diary12&quot;,[&quot;number&quot;]=12,[&quot;title&quot;]=&quot;Someone’s birthday&quot;,[&quot;text&quot;]=&quot;We lit candles without a cake. Mum said it was not a birthday. Dad could not remember why he had bought the candles. There are marks on the table from a cake tin that will not fit our cupboard.&quot;,[&quot;type&quot;]=&quot;diary&quot;,[&quot;room&quot;]=&quot;study&quot;},{[&quot;id&quot;]=&quot;diary13&quot;,[&quot;number&quot;]=13,[&quot;title&quot;]=&quot;The missing pronoun&quot;,[&quot;text&quot;]=&quot;I wrote WE WENT HOME. This morning it says I WENT HOME. The space is too wide for I. I keep trying to remember whose hand I was holding, and remembering a different sleeve.&quot;,[&quot;type&quot;]=&quot;diary&quot;,[&quot;room&quot;]=&quot;sealed&quot;},{[&quot;id&quot;]=&quot;diary14&quot;,[&quot;number&quot;]=14,[&quot;title&quot;]=&quot;A longer landing&quot;,[&quot;text&quot;]=&quot;It took seventeen steps to reach the bathroom. I counted twelve on the way back. Dad marked the wall with tape. In the evening the tape was wrapped around his wrist like he had always worn it.&quot;,[&quot;type&quot;]=&quot;diary&quot;,[&quot;room&quot;]=&quot;sealed&quot;},{[&quot;id&quot;]=&quot;diary15&quot;,[&quot;number&quot;]=15,[&quot;title&quot;]=&quot;The voice downstairs&quot;,[&quot;text&quot;]=&quot;Someone read my first page aloud from underneath the floor. They made the same mistake over the word crooked. I do not remember writing that mistake. I do remember being corrected.&quot;,[&quot;type&quot;]=&quot;diary&quot;,[&quot;room&quot;]=&quot;observation&quot;},{[&quot;id&quot;]=&quot;diary16&quot;,[&quot;number&quot;]=16,[&quot;title&quot;]=&quot;Our own handwriting&quot;,[&quot;text&quot;]=&quot;There are two kinds of handwriting in this book. The second kind calls the first kind a liar. Both make the same spelling mistakes. I am leaving the mistakes where they are.&quot;,[&quot;type&quot;]=&quot;diary&quot;,[&quot;room&quot;]=&quot;observation&quot;},{[&quot;id&quot;]=&quot;diary17&quot;,[&quot;number&quot;]=17,[&quot;title&quot;]=&quot;The person in the photograph&quot;,[&quot;text&quot;]=&quot;Dad is missing from one photograph. In the next he is holding the camera, though I can see both his hands in the picture. Mum knows which coat was his. She cannot say what he looked like.&quot;,[&quot;type&quot;]=&quot;diary&quot;,[&quot;room&quot;]=&quot;children&quot;},{[&quot;id&quot;]=&quot;diary18&quot;,[&quot;number&quot;]=18,[&quot;title&quot;]=&quot;A room set aside&quot;,[&quot;text&quot;]=&quot;We carried boxes to the room that is not on the plan. I remember doing it alone. My arms hurt in four places, as if someone else had been holding the same box.&quot;,[&quot;type&quot;]=&quot;diary&quot;,[&quot;room&quot;]=&quot;children&quot;},{[&quot;id&quot;]=&quot;diary19&quot;,[&quot;number&quot;]=19,[&quot;title&quot;]=&quot;If you find this&quot;,[&quot;text&quot;]=&quot;If you find this, do not decide too quickly who I was. I have been your sibling in some memories and your visitor in others. The room remembers a name. It will not tell me whether the name was mine.&quot;,[&quot;type&quot;]=&quot;diary&quot;,[&quot;room&quot;]=&quot;chamber&quot;},{[&quot;id&quot;]=&quot;diary20&quot;,[&quot;number&quot;]=20,[&quot;title&quot;]=&quot;An ordinary morning&quot;,[&quot;text&quot;]=&quot;Today we had toast. Someone asked for the crooked slice. There were places for everybody, which is not the same as knowing how many people there were. Please leave this page unfinished. I would like tomorrow to have somewhere to go.&quot;,[&quot;type&quot;]=&quot;diary&quot;,[&quot;room&quot;]=&quot;chamber&quot;},{[&quot;id&quot;]=&quot;dad1&quot;,[&quot;type&quot;]=&quot;dad&quot;,[&quot;title&quot;]=&quot;Dad’s notes · 1&quot;,[&quot;text&quot;]=&quot;A coat repair receipt signed D. The same initials label a child’s school bag.&quot;,[&quot;room&quot;]=&quot;storage&quot;},{[&quot;id&quot;]=&quot;dad2&quot;,[&quot;type&quot;]=&quot;dad&quot;,[&quot;title&quot;]=&quot;Dad’s notes · 2&quot;,[&quot;text&quot;]=&quot;A service note: “Keep the heating on. Leave the fourth branch isolated.”&quot;,[&quot;room&quot;]=&quot;archive&quot;},{[&quot;id&quot;]=&quot;dad3&quot;,[&quot;type&quot;]=&quot;dad&quot;,[&quot;title&quot;]=&quot;Dad’s notes · 3&quot;,[&quot;text&quot;]=&quot;An unfinished letter begins Dear children. The next draft begins Dear child.&quot;,[&quot;room&quot;]=&quot;sealed&quot;},{[&quot;id&quot;]=&quot;dad4&quot;,[&quot;type&quot;]=&quot;dad&quot;,[&quot;title&quot;]=&quot;Dad’s notes · 4&quot;,[&quot;text&quot;]=&quot;A workshop list includes three small stools and one adult chair. None were collected.&quot;,[&quot;room&quot;]=&quot;storage&quot;},{[&quot;id&quot;]=&quot;dad5&quot;,[&quot;type&quot;]=&quot;dad&quot;,[&quot;title&quot;]=&quot;Dad’s notes · 5&quot;,[&quot;text&quot;]=&quot;A folded timetable has a return journey pencilled in on an impossible date.&quot;,[&quot;room&quot;]=&quot;archive&quot;},{[&quot;id&quot;]=&quot;dad6&quot;,[&quot;type&quot;]=&quot;dad&quot;,[&quot;title&quot;]=&quot;Dad’s notes · 6&quot;,[&quot;text&quot;]=&quot;Two final drafts share the same signature stroke. Only one is signed Dad.&quot;,[&quot;room&quot;]=&quot;sealed&quot;},{[&quot;id&quot;]=&quot;photo1&quot;,[&quot;type&quot;]=&quot;photo&quot;,[&quot;title&quot;]=&quot;Family photographs · 1&quot;,[&quot;text&quot;]=&quot;Four places at a long table. The fourth person is outside the frame.&quot;,[&quot;room&quot;]=&quot;boiler&quot;},{[&quot;id&quot;]=&quot;photo2&quot;,[&quot;type&quot;]=&quot;photo&quot;,[&quot;title&quot;]=&quot;Family photographs · 2&quot;,[&quot;text&quot;]=&quot;Two children standing by a bed. A crease runs through both their faces.&quot;,[&quot;room&quot;]=&quot;family&quot;},{[&quot;id&quot;]=&quot;photo3&quot;,[&quot;type&quot;]=&quot;photo&quot;,[&quot;title&quot;]=&quot;Family photographs · 3&quot;,[&quot;text&quot;]=&quot;A raincoat hangs beside a taller figure whose face is turned away.&quot;,[&quot;room&quot;]=&quot;observation&quot;},{[&quot;id&quot;]=&quot;photo4&quot;,[&quot;type&quot;]=&quot;photo&quot;,[&quot;title&quot;]=&quot;Family photographs · 4&quot;,[&quot;text&quot;]=&quot;Candles reflected in a window. There is no cake in the photograph.&quot;,[&quot;room&quot;]=&quot;boiler&quot;},{[&quot;id&quot;]=&quot;photo5&quot;,[&quot;type&quot;]=&quot;photo&quot;,[&quot;title&quot;]=&quot;Family photographs · 5&quot;,[&quot;text&quot;]=&quot;The family house with one more window. The negative has fewer windows.&quot;,[&quot;room&quot;]=&quot;family&quot;},{[&quot;id&quot;]=&quot;photo6&quot;,[&quot;type&quot;]=&quot;photo&quot;,[&quot;title&quot;]=&quot;Family photographs · 6&quot;,[&quot;text&quot;]=&quot;An empty room. The handwritten caption says All of us, home at last.&quot;,[&quot;room&quot;]=&quot;observation&quot;},{[&quot;id&quot;]=&quot;drawing1&quot;,[&quot;type&quot;]=&quot;drawing&quot;,[&quot;title&quot;]=&quot;Lost drawings · 1&quot;,[&quot;text&quot;]=&quot;Two narrow beds, one red and one blue. Both have the same name beneath them.&quot;,[&quot;room&quot;]=&quot;tunnel&quot;},{[&quot;id&quot;]=&quot;drawing2&quot;,[&quot;type&quot;]=&quot;drawing&quot;,[&quot;title&quot;]=&quot;Lost drawings · 2&quot;,[&quot;text&quot;]=&quot;A family with joined hands. One hand belongs to the border of the page.&quot;,[&quot;room&quot;]=&quot;study&quot;},{[&quot;id&quot;]=&quot;drawing3&quot;,[&quot;type&quot;]=&quot;drawing&quot;,[&quot;title&quot;]=&quot;Lost drawings · 3&quot;,[&quot;text&quot;]=&quot;A cake drawn around four candles. The birthday name has been carefully erased.&quot;,[&quot;room&quot;]=&quot;children&quot;},{[&quot;id&quot;]=&quot;drawing4&quot;,[&quot;type&quot;]=&quot;drawing&quot;,[&quot;title&quot;]=&quot;Lost drawings · 4&quot;,[&quot;text&quot;]=&quot;A tall figure watering a garden. The watering can is labelled MUM.&quot;,[&quot;room&quot;]=&quot;tunnel&quot;},{[&quot;id&quot;]=&quot;drawing5&quot;,[&quot;type&quot;]=&quot;drawing&quot;,[&quot;title&quot;]=&quot;Lost drawings · 5&quot;,[&quot;text&quot;]=&quot;Five windows on a wall measured for four. Something waves from the space between them.&quot;,[&quot;room&quot;]=&quot;study&quot;},{[&quot;id&quot;]=&quot;record1&quot;,[&quot;type&quot;]=&quot;record&quot;,[&quot;title&quot;]=&quot;Family records · 1&quot;,[&quot;text&quot;]=&quot;A household list with four entries. Its certified copy has two. Neither is marked amended.&quot;,[&quot;room&quot;]=&quot;archive&quot;},{[&quot;id&quot;]=&quot;record2&quot;,[&quot;type&quot;]=&quot;record&quot;,[&quot;title&quot;]=&quot;Family records · 2&quot;,[&quot;text&quot;]=&quot;A survey records thirty steps. A second measurement records twenty-five with identical end marks.&quot;,[&quot;room&quot;]=&quot;sealed&quot;},{[&quot;id&quot;]=&quot;record3&quot;,[&quot;type&quot;]=&quot;record&quot;,[&quot;title&quot;]=&quot;Family records · 3&quot;,[&quot;text&quot;]=&quot;Three names appear on a school contact form. The telephone number is the house’s own.&quot;,[&quot;room&quot;]=&quot;storage&quot;},{[&quot;id&quot;]=&quot;record4&quot;,[&quot;type&quot;]=&quot;record&quot;,[&quot;title&quot;]=&quot;Family records · 4&quot;,[&quot;text&quot;]=&quot;Room 0: inspected, occupied, no key issued. A later line reads Never allocated.&quot;,[&quot;room&quot;]=&quot;archive&quot;},{[&quot;id&quot;]=&quot;record5&quot;,[&quot;type&quot;]=&quot;record&quot;,[&quot;title&quot;]=&quot;Family records · 5&quot;,[&quot;text&quot;]=&quot;A birth-date column has been cut from an otherwise undamaged ledger.&quot;,[&quot;room&quot;]=&quot;sealed&quot;},{[&quot;id&quot;]=&quot;record6&quot;,[&quot;type&quot;]=&quot;record&quot;,[&quot;title&quot;]=&quot;Family records · 6&quot;,[&quot;text&quot;]=&quot;Two originals of a household inventory. PRESENT is the only column heading that survives.&quot;,[&quot;room&quot;]=&quot;storage&quot;},{[&quot;id&quot;]=&quot;letter1&quot;,[&quot;type&quot;]=&quot;letter&quot;,[&quot;title&quot;]=&quot;Secret letters · 1&quot;,[&quot;text&quot;]=&quot;“Keep the seal intact, even if we cannot agree who it protects.” No signature.&quot;,[&quot;room&quot;]=&quot;family&quot;},{[&quot;id&quot;]=&quot;letter2&quot;,[&quot;type&quot;]=&quot;letter&quot;,[&quot;title&quot;]=&quot;Secret letters · 2&quot;,[&quot;text&quot;]=&quot;“Do not give them faces just because the names sound familiar.”&quot;,[&quot;room&quot;]=&quot;observation&quot;},{[&quot;id&quot;]=&quot;letter3&quot;,[&quot;type&quot;]=&quot;letter&quot;,[&quot;title&quot;]=&quot;Secret letters · 3&quot;,[&quot;text&quot;]=&quot;“Listen before you decide it is asking to be let out.” The envelope is addressed inward.&quot;,[&quot;room&quot;]=&quot;boiler&quot;},{[&quot;id&quot;]=&quot;letter4&quot;,[&quot;type&quot;]=&quot;letter&quot;,[&quot;title&quot;]=&quot;Secret letters · 4&quot;,[&quot;text&quot;]=&quot;“I left enough room for tomorrow.” The date is written in two hands.&quot;,[&quot;room&quot;]=&quot;family&quot;},{[&quot;id&quot;]=&quot;memory1&quot;,[&quot;type&quot;]=&quot;memory&quot;,[&quot;title&quot;]=&quot;Memory fragments · 1&quot;,[&quot;text&quot;]=&quot;A warm sleeve against your cheek. You cannot decide whether you were being carried or carrying someone.&quot;,[&quot;room&quot;]=&quot;study&quot;},{[&quot;id&quot;]=&quot;memory2&quot;,[&quot;type&quot;]=&quot;memory&quot;,[&quot;title&quot;]=&quot;Memory fragments · 2&quot;,[&quot;text&quot;]=&quot;Two hands holding the same heavy box. You remember four aching arms.&quot;,[&quot;room&quot;]=&quot;children&quot;},{[&quot;id&quot;]=&quot;memory3&quot;,[&quot;type&quot;]=&quot;memory&quot;,[&quot;title&quot;]=&quot;Memory fragments · 3&quot;,[&quot;text&quot;]=&quot;A voice saying your childhood nickname from the opposite side of a classroom door.&quot;,[&quot;room&quot;]=&quot;tunnel&quot;},{[&quot;id&quot;]=&quot;memory4&quot;,[&quot;type&quot;]=&quot;memory&quot;,[&quot;title&quot;]=&quot;Memory fragments · 4&quot;,[&quot;text&quot;]=&quot;The smell of wet wool and a workshop you cannot place.&quot;,[&quot;room&quot;]=&quot;study&quot;},{[&quot;id&quot;]=&quot;memory5&quot;,[&quot;type&quot;]=&quot;memory&quot;,[&quot;title&quot;]=&quot;Memory fragments · 5&quot;,[&quot;text&quot;]=&quot;An argument over the window-side bed, followed by an apology nobody remembers making.&quot;,[&quot;room&quot;]=&quot;children&quot;},{[&quot;id&quot;]=&quot;memory6&quot;,[&quot;type&quot;]=&quot;memory&quot;,[&quot;title&quot;]=&quot;Memory fragments · 6&quot;,[&quot;text&quot;]=&quot;Mum cutting one extra slice of toast and looking surprised by the knife.&quot;,[&quot;room&quot;]=&quot;tunnel&quot;},{[&quot;id&quot;]=&quot;memory7&quot;,[&quot;type&quot;]=&quot;memory&quot;,[&quot;title&quot;]=&quot;Memory fragments · 7&quot;,[&quot;text&quot;]=&quot;A pencil marking a height above your head. The hand holding it is smaller than yours.&quot;,[&quot;room&quot;]=&quot;study&quot;},{[&quot;id&quot;]=&quot;memory8&quot;,[&quot;type&quot;]=&quot;memory&quot;,[&quot;title&quot;]=&quot;Memory fragments · 8&quot;,[&quot;text&quot;]=&quot;An ordinary morning that feels shared, without giving you a reliable headcount.&quot;,[&quot;room&quot;]=&quot;children&quot;},{[&quot;id&quot;]=&quot;key-archive&quot;,[&quot;type&quot;]=&quot;key&quot;,[&quot;room&quot;]=&quot;storage&quot;,[&quot;title&quot;]=&quot;Flat-file key&quot;,[&quot;text&quot;]=&quot;A small brass key. Its tag refers to the archive. The tooth pattern has been corrected by hand.&quot;},{[&quot;id&quot;]=&quot;key-study&quot;,[&quot;type&quot;]=&quot;key&quot;,[&quot;room&quot;]=&quot;archive&quot;,[&quot;title&quot;]=&quot;Drafting-desk key&quot;,[&quot;text&quot;]=&quot;A small brass key. Its tag refers to the hidden study. The tooth pattern has been corrected by hand.&quot;},{[&quot;id&quot;]=&quot;key-observation&quot;,[&quot;type&quot;]=&quot;key&quot;,[&quot;room&quot;]=&quot;tunnel&quot;,[&quot;title&quot;]=&quot;Inspection-window key&quot;,[&quot;text&quot;]=&quot;A small brass key. Its tag refers to the observation room. The tooth pattern has been corrected by hand.&quot;},{[&quot;id&quot;]=&quot;key-chamber&quot;,[&quot;type&quot;]=&quot;key&quot;,[&quot;room&quot;]=&quot;children&quot;,[&quot;title&quot;]=&quot;Unnumbered chamber key&quot;,[&quot;text&quot;]=&quot;A small brass key. Its tag refers to a room without a number. The tooth pattern has been corrected by hand.&quot;}},[&quot;deepActions&quot;]={[&quot;storage&quot;]={{&quot;rest&quot;,&quot;Put the evidence down&quot;,&quot;You give yourself permission to return tomorrow. Resting does not erase the evidence.&quot;},{&quot;anchor&quot;,&quot;Hold an ordinary memory&quot;,&quot;You keep one ordinary memory close without deciding whose memory it was.&quot;}},[&quot;boiler&quot;]={{&quot;valve&quot;,&quot;Isolate the knocking pipe&quot;,&quot;The labelled valve closes. The pressure gauge settles safely.&quot;},{&quot;power&quot;,&quot;Switch on auxiliary lighting&quot;,&quot;The isolated lighting circuit comes on. The heating branch remains separate.&quot;},{&quot;answer&quot;,&quot;Return the extra beat&quot;,&quot;You tap the additional beat against a cold pipe.&quot;}},[&quot;tunnel&quot;]={{&quot;route&quot;,&quot;Mark the measured route&quot;,&quot;You mark the same physical route in chalk. Its real distance will not change beneath your feet.&quot;},{&quot;zero&quot;,&quot;Record room zero&quot;,&quot;You copy the unused number without assigning it to a person.&quot;}},[&quot;archive&quot;]={{&quot;compare&quot;,&quot;Keep both originals&quot;,&quot;You file both contradictory records. Neither is declared a mistake.&quot;},{&quot;names&quot;,&quot;Copy names without faces&quot;,&quot;You copy the names and leave their photographs unassigned.&quot;}},[&quot;family&quot;]={{&quot;places&quot;,&quot;Set every suggested place&quot;,&quot;You set places for the household suggested by the evidence. One spare chair remains nearby.&quot;},{&quot;listen&quot;,&quot;Listen to the disconnected radio&quot;,&quot;The radio is unplugged. You leave it that way and listen.&quot;}},[&quot;study&quot;]={{&quot;letters&quot;,&quot;Arrange the unsigned drafts&quot;,&quot;The drafts remain unsigned. You place the coat beside them.&quot;},{&quot;bind&quot;,&quot;Bind both kinds of handwriting&quot;,&quot;You preserve both hands in the same diary.&quot;},{&quot;blank&quot;,&quot;Leave the last page unfinished&quot;,&quot;There is somewhere for tomorrow to go.&quot;}},[&quot;sealed&quot;]={{&quot;seal&quot;,&quot;Renew the inspection seal&quot;,&quot;You add a fresh date without removing the earlier signatures.&quot;},{&quot;listen&quot;,&quot;Listen without naming it&quot;,&quot;You listen without calling the sound a particular person.&quot;}},[&quot;observation&quot;]={{&quot;glass&quot;,&quot;Cover the observation pane&quot;,&quot;You cover the pane, leaving the people it might have shown unobserved.&quot;}},[&quot;children&quot;]={{&quot;beds&quot;,&quot;Make both beds&quot;,&quot;Both beds receive clean sheets. You do not choose who slept where.&quot;},{&quot;candles&quot;,&quot;Light the unclaimed candles&quot;,&quot;Four candles burn beside an empty plate.&quot;}},[&quot;chamber&quot;]={{&quot;door&quot;,&quot;Leave the chamber door open&quot;,&quot;You leave the ordinary door open. Nothing is required to walk through it.&quot;}}},[&quot;deepEndRoom&quot;]={[&quot;Family&quot;]=&quot;family&quot;,[&quot;Basement&quot;]=&quot;boiler&quot;,[&quot;Memory&quot;]=&quot;archive&quot;,[&quot;Anomaly&quot;]=&quot;observation&quot;,[&quot;Sanity&quot;]=&quot;storage&quot;,[&quot;Collector&quot;]=&quot;study&quot;,[&quot;Secret&quot;]=&quot;sealed&quot;,[&quot;True Mystery&quot;]=&quot;chamber&quot;},[&quot;cityPlaces&quot;]={{[&quot;id&quot;]=&quot;station&quot;,[&quot;name&quot;]=&quot;Last Train Station&quot;,[&quot;color&quot;]=&quot;#5e6c68&quot;,[&quot;clue&quot;]=&quot;The ticket has tomorrow’s date. The departure board lists your childhood address.&quot;,[&quot;choices&quot;]={{&quot;Board the last train&quot;,&quot;The passenger&quot;,&quot;You board the train. Every passenger has your face at a different age. At the next stop, you finally recognise the person waiting for you.&quot;},{&quot;Take the signal operator’s chair&quot;,&quot;The signal keeper&quot;,&quot;You change the signal to red. The train never arrives at the house. Every night, you keep one more family from boarding.&quot;}},[&quot;x&quot;]=-80,[&quot;z&quot;]=-170},{[&quot;id&quot;]=&quot;library&quot;,[&quot;name&quot;]=&quot;Municipal Archives&quot;,[&quot;color&quot;]=&quot;#776d57&quot;,[&quot;clue&quot;]=&quot;The register lists your death on every page. One blank line remains beneath Mother’s name.&quot;,[&quot;choices&quot;]={{&quot;Erase your entry&quot;,&quot;The unwritten&quot;,&quot;You erase your entry from the register. Outside, nobody remembers the house. You do not remember it either—until you find the key in your pocket.&quot;},{&quot;Sign as the new archivist&quot;,&quot;The archivist&quot;,&quot;You sign your name at the desk. The books settle. Every lost child has a place in the catalogue now. One shelf is reserved for you.&quot;}},[&quot;x&quot;]=-40,[&quot;z&quot;]=-170},{[&quot;id&quot;]=&quot;cinema&quot;,[&quot;name&quot;]=&quot;Orpheum Cinema&quot;,[&quot;color&quot;]=&quot;#69565a&quot;,[&quot;clue&quot;]=&quot;The projector plays your kitchen. On screen, Mother is about to open the spare room.&quot;,[&quot;choices&quot;]={{&quot;Cut the final reel&quot;,&quot;The missing scene&quot;,&quot;You cut the film before the door opens. The screen turns white. When you walk home, the hallway ends where it always should have.&quot;},{&quot;Step into the screen&quot;,&quot;The understudy&quot;,&quot;You step into the picture. Mother looks up from the kitchen table. Somewhere behind you, an audience begins to applaud.&quot;}},[&quot;x&quot;]=0,[&quot;z&quot;]=-170},{[&quot;id&quot;]=&quot;clinic&quot;,[&quot;name&quot;]=&quot;St Agnes Clinic&quot;,[&quot;color&quot;]=&quot;#69766b&quot;,[&quot;clue&quot;]=&quot;A case file describes a patient split into a memory and a body. The consent form is unsigned.&quot;,[&quot;choices&quot;]={{&quot;Destroy the case file&quot;,&quot;Discharged&quot;,&quot;You destroy the file. The ward doors unlock. You and Mother leave together, but the scar on your palm has two lifelines.&quot;},{&quot;Accept the offered treatment&quot;,&quot;The quiet ward&quot;,&quot;You sign the consent form. Your fear disappears first. Then your name. A nurse closes the curtains around a bed that has always been yours.&quot;}},[&quot;x&quot;]=40,[&quot;z&quot;]=-170},{[&quot;id&quot;]=&quot;chapel&quot;,[&quot;name&quot;]=&quot;Chapel of the Echo&quot;,[&quot;color&quot;]=&quot;#736b61&quot;,[&quot;clue&quot;]=&quot;The bell has no clapper. A prayer tucked inside says: “Speak the name you were given before the room.”&quot;,[&quot;choices&quot;]={{&quot;Ring the bell with your voice&quot;,&quot;The returned name&quot;,&quot;You speak your own name into the bell. The city answers in Mother’s voice. Every locked door opens, and none of them lead back to the spare room.&quot;},{&quot;Stay for the midnight vigil&quot;,&quot;The last candle&quot;,&quot;You light the final candle. The shadows kneel around you. You promise to keep the light burning until every forgotten child comes home.&quot;}},[&quot;x&quot;]=80,[&quot;z&quot;]=-170},{[&quot;id&quot;]=&quot;radio&quot;,[&quot;name&quot;]=&quot;North Street Radio&quot;,[&quot;color&quot;]=&quot;#5f677b&quot;,[&quot;clue&quot;]=&quot;The emergency frequency repeats a warning in your voice. A second microphone is warm.&quot;,[&quot;choices&quot;]={{&quot;Broadcast a warning&quot;,&quot;The warning&quot;,&quot;You warn the city never to open an unfamiliar door. All around you, radios click off. At home, Mother puts down the spare key.&quot;},{&quot;Answer the voice on air&quot;,&quot;The transmission&quot;,&quot;“I’m here,” you say. Your voice escapes through every radio in the city. You can never return to your body, but no one will be alone in the house again.&quot;}},[&quot;x&quot;]=-80,[&quot;z&quot;]=-210},{[&quot;id&quot;]=&quot;cafe&quot;,[&quot;name&quot;]=&quot;The Wakeful Cafe&quot;,[&quot;color&quot;]=&quot;#82705b&quot;,[&quot;clue&quot;]=&quot;Three cups are warm. The receipt says you have been sitting here since Tuesday.&quot;,[&quot;kind&quot;]=&quot;cafe&quot;,[&quot;choices&quot;]={},[&quot;x&quot;]=-40,[&quot;z&quot;]=-210},{[&quot;id&quot;]=&quot;laundry&quot;,[&quot;name&quot;]=&quot;Pale Street Laundry&quot;,[&quot;color&quot;]=&quot;#70837d&quot;,[&quot;clue&quot;]=&quot;A machine turns without water. Inside, your school uniform is still your size.&quot;,[&quot;kind&quot;]=&quot;laundry&quot;,[&quot;choices&quot;]={},[&quot;x&quot;]=0,[&quot;z&quot;]=-210},{[&quot;id&quot;]=&quot;postoffice&quot;,[&quot;name&quot;]=&quot;Dead Letter Office&quot;,[&quot;color&quot;]=&quot;#826952&quot;,[&quot;clue&quot;]=&quot;The undelivered letters are all addressed to the upstairs records room.&quot;,[&quot;kind&quot;]=&quot;post&quot;,[&quot;choices&quot;]={},[&quot;x&quot;]=40,[&quot;z&quot;]=-210},{[&quot;id&quot;]=&quot;workshop&quot;,[&quot;name&quot;]=&quot;Hollow Clock Repairs&quot;,[&quot;color&quot;]=&quot;#717d78&quot;,[&quot;clue&quot;]=&quot;Every clock runs normally until you look away. One ticks inside a locked drawer.&quot;,[&quot;kind&quot;]=&quot;workshop&quot;,[&quot;choices&quot;]={},[&quot;x&quot;]=80,[&quot;z&quot;]=-210},{[&quot;id&quot;]=&quot;florist&quot;,[&quot;name&quot;]=&quot;Night Bloom Florist&quot;,[&quot;color&quot;]=&quot;#758367&quot;,[&quot;clue&quot;]=&quot;Someone ordered flowers for your return. The delivery date is tomorrow.&quot;,[&quot;kind&quot;]=&quot;florist&quot;,[&quot;choices&quot;]={},[&quot;x&quot;]=-80,[&quot;z&quot;]=-250},{[&quot;id&quot;]=&quot;bakery&quot;,[&quot;name&quot;]=&quot;Ash and Honey Bakery&quot;,[&quot;color&quot;]=&quot;#8d7860&quot;,[&quot;clue&quot;]=&quot;The oven is cold. A loaf on the counter is breathing slowly.&quot;,[&quot;kind&quot;]=&quot;bakery&quot;,[&quot;choices&quot;]={},[&quot;x&quot;]=-40,[&quot;z&quot;]=-250},{[&quot;id&quot;]=&quot;apartments&quot;,[&quot;name&quot;]=&quot;Number Nine Flats&quot;,[&quot;color&quot;]=&quot;#747780&quot;,[&quot;clue&quot;]=&quot;The tenants list contains your name twenty times. Each signature is different.&quot;,[&quot;kind&quot;]=&quot;apartments&quot;,[&quot;choices&quot;]={},[&quot;x&quot;]=0,[&quot;z&quot;]=-250},{[&quot;id&quot;]=&quot;hotel&quot;,[&quot;name&quot;]=&quot;Hotel Afterimage&quot;,[&quot;color&quot;]=&quot;#816e72&quot;,[&quot;clue&quot;]=&quot;The guest book says you checked in with Mother. There is no departure column.&quot;,[&quot;kind&quot;]=&quot;hotel&quot;,[&quot;choices&quot;]={},[&quot;x&quot;]=40,[&quot;z&quot;]=-250},{[&quot;id&quot;]=&quot;market&quot;,[&quot;name&quot;]=&quot;Empty Sunday Market&quot;,[&quot;color&quot;]=&quot;#7e805f&quot;,[&quot;clue&quot;]=&quot;The stalls sell objects you lost as a child. One vendor has your missing tooth.&quot;,[&quot;kind&quot;]=&quot;market&quot;,[&quot;choices&quot;]={},[&quot;x&quot;]=80,[&quot;z&quot;]=-250},{[&quot;id&quot;]=&quot;greenhouse&quot;,[&quot;name&quot;]=&quot;Glasshouse Gardens&quot;,[&quot;color&quot;]=&quot;#617968&quot;,[&quot;clue&quot;]=&quot;The plants lean away from the sun and towards the spare-room key in your pocket.&quot;,[&quot;kind&quot;]=&quot;greenhouse&quot;,[&quot;choices&quot;]={},[&quot;x&quot;]=-80,[&quot;z&quot;]=-290},{[&quot;id&quot;]=&quot;waterworks&quot;,[&quot;name&quot;]=&quot;Stillwater Pump House&quot;,[&quot;color&quot;]=&quot;#627b80&quot;,[&quot;clue&quot;]=&quot;The gauge pulses like a heartbeat. Through the pipes, someone whispers your address.&quot;,[&quot;kind&quot;]=&quot;waterworks&quot;,[&quot;choices&quot;]={},[&quot;x&quot;]=-40,[&quot;z&quot;]=-290},{[&quot;id&quot;]=&quot;garage&quot;,[&quot;name&quot;]=&quot;End of Road Garage&quot;,[&quot;color&quot;]=&quot;#7a7665&quot;,[&quot;clue&quot;]=&quot;A car waits with its engine off. In the rear-view mirror, the driver is still here.&quot;,[&quot;kind&quot;]=&quot;garage&quot;,[&quot;choices&quot;]={},[&quot;x&quot;]=0,[&quot;z&quot;]=-290},{[&quot;id&quot;]=&quot;bookshop&quot;,[&quot;name&quot;]=&quot;Second Hand Stories&quot;,[&quot;color&quot;]=&quot;#7e6c63&quot;,[&quot;clue&quot;]=&quot;Every book has the same last sentence: please do not leave me in that room.&quot;,[&quot;kind&quot;]=&quot;books&quot;,[&quot;choices&quot;]={},[&quot;x&quot;]=40,[&quot;z&quot;]=-290},{[&quot;id&quot;]=&quot;playground&quot;,[&quot;name&quot;]=&quot;The Empty Playroom&quot;,[&quot;color&quot;]=&quot;#7f7b69&quot;,[&quot;clue&quot;]=&quot;The rocking horse moves once. Through the glass you see no hand that pushed it.&quot;,[&quot;kind&quot;]=&quot;playroom&quot;,[&quot;choices&quot;]={},[&quot;x&quot;]=80,[&quot;z&quot;]=-290}},[&quot;residents&quot;]={{[&quot;id&quot;]=&quot;chapel&quot;,[&quot;name&quot;]=&quot;The candle keeper&quot;,[&quot;x&quot;]=24,[&quot;z&quot;]=-22.5,[&quot;coat&quot;]=&quot;#756b59&quot;,[&quot;phase&quot;]=0},{[&quot;id&quot;]=&quot;radio&quot;,[&quot;name&quot;]=&quot;The engineer&quot;,[&quot;x&quot;]=42,[&quot;z&quot;]=-21.574381916711314,[&quot;coat&quot;]=&quot;#4e6970&quot;,[&quot;phase&quot;]=1},{[&quot;id&quot;]=&quot;clinic&quot;,[&quot;name&quot;]=&quot;The night nurse&quot;,[&quot;x&quot;]=24,[&quot;z&quot;]=-39.49977283049175,[&quot;coat&quot;]=&quot;#775857&quot;,[&quot;phase&quot;]=2},{[&quot;id&quot;]=&quot;library&quot;,[&quot;name&quot;]=&quot;The archivist&quot;,[&quot;x&quot;]=24,[&quot;z&quot;]=-58.34476799113415,[&quot;coat&quot;]=&quot;#668071&quot;,[&quot;phase&quot;]=3},{[&quot;id&quot;]=&quot;station&quot;,[&quot;name&quot;]=&quot;The porter&quot;,[&quot;x&quot;]=42,[&quot;z&quot;]=-59.33248274483872,[&quot;coat&quot;]=&quot;#827754&quot;,[&quot;phase&quot;]=4},{[&quot;id&quot;]=&quot;cinema&quot;,[&quot;name&quot;]=&quot;The projectionist&quot;,[&quot;x&quot;]=6,[&quot;z&quot;]=-77.55481670212946,[&quot;coat&quot;]=&quot;#66647d&quot;,[&quot;phase&quot;]=5}},[&quot;legacy&quot;]={[&quot;advancedEndings&quot;]={[&quot;grid&quot;]={&quot;Ending 25 · A city with its lights on&quot;,&quot;You isolate the circuit feeding the spare room. Along every street, the lamps brighten. Mother calls from a house with one fewer door.&quot;},[&quot;dawn&quot;]={&quot;Ending 26 · The first bus home&quot;,&quot;You sit beside the porter and wait until daylight. When the next bus arrives, the passengers are ordinary strangers. For once, nobody knows your name.&quot;},[&quot;witness&quot;]={&quot;Ending 27 · The witness&quot;,&quot;You watch the film, then tell the archivist exactly what you saw. This time, there is a witness outside the house. Mother can no longer be made to forget.&quot;},[&quot;keeper&quot;]={&quot;Ending 28 · Keep the door closed&quot;,&quot;You choose to remain, with a warning on the fuse box and the lantern beside the door. The house does not stop whispering. You learn when not to listen.&quot;}},[&quot;noteDefs&quot;]={{[&quot;id&quot;]=&quot;note1&quot;,[&quot;p&quot;]={1.38,1.45,3.8},[&quot;axis&quot;]=&quot;x&quot;,[&quot;title&quot;]=&quot;BEFORE YOU LEAVE&quot;,[&quot;text&quot;]=&quot;The gate knows three words.\nFirst: WE.\nDo not knock back.&quot;},{[&quot;id&quot;]=&quot;note2&quot;,[&quot;p&quot;]={-6.13,1.05,8.5},[&quot;axis&quot;]=&quot;x&quot;,[&quot;title&quot;]=&quot;DON’T FEED IT&quot;,[&quot;text&quot;]=&quot;Second: WERE.\nThe sandwiches appear because\nsomeone keeps setting your place.&quot;},{[&quot;id&quot;]=&quot;note3&quot;,[&quot;p&quot;]={2.8,1.65,17.87},[&quot;axis&quot;]=&quot;z&quot;,[&quot;title&quot;]=&quot;COUNT THE CHAIRS&quot;,[&quot;text&quot;]=&quot;Third: HERE.\nSay all three at the garden gate.\nTake nobody’s reflection with you.&quot;},{[&quot;id&quot;]=&quot;note4&quot;,[&quot;p&quot;]={-5.8,1.5,-8.87},[&quot;axis&quot;]=&quot;z&quot;,[&quot;title&quot;]=&quot;THE GARDENER&quot;,[&quot;text&quot;]=&quot;Turn the music box in the shed.\nTake its lullaby to the well.\nDo not look down while it sings.&quot;},{[&quot;id&quot;]=&quot;note5&quot;,[&quot;p&quot;]={8.88,1.4,-7},[&quot;axis&quot;]=&quot;x&quot;,[&quot;title&quot;]=&quot;PLEASE REMEMBER&quot;,[&quot;text&quot;]=&quot;If every note is found,\nwrite your own name in the diary.\nYou are allowed to be whole.&quot;},{[&quot;id&quot;]=&quot;note6&quot;,[&quot;p&quot;]={4.2,0.45,2.12},[&quot;axis&quot;]=&quot;z&quot;,[&quot;title&quot;]=&quot;UNDER THE MIRROR&quot;,[&quot;text&quot;]=&quot;The glass remembers the room.\nSometimes it remembers someone\nwho is no longer standing there.&quot;}},[&quot;endings&quot;]={[&quot;truth&quot;]={[&quot;title&quot;]=&quot;Ending IV · Both our names&quot;,[&quot;text&quot;]=&quot;Mother steps into the room beside you. She tells the child everything she made herself forget.\nThe walls loosen like a held breath. Two voices become one.\nAt breakfast, there are three places at the table.&quot;,[&quot;flags&quot;]={&quot;truth&quot;}},[&quot;escape&quot;]={[&quot;title&quot;]=&quot;Ending V · Outside&quot;,[&quot;text&quot;]=&quot;The telephone rings once. You take Mother’s hand and open the front door.\nBeyond it is a street you recognise. At every window stands your reflection.\nYou keep walking.&quot;,[&quot;flags&quot;]={&quot;called&quot;,&quot;power&quot;}},[&quot;ward&quot;]={[&quot;title&quot;]=&quot;Ending VI · The keeper&quot;,[&quot;text&quot;]=&quot;The mirror steps across the chalk circle. It takes the diary and all the memories it contains.\n“Someone must keep them,” it says.\nYou and Mother leave. At night, every mirror in your new home faces the wall.&quot;,[&quot;flags&quot;]={&quot;mirror&quot;,&quot;ward&quot;}},[&quot;gate&quot;]={[&quot;title&quot;]=&quot;Ending VII · We were here&quot;,[&quot;text&quot;]=&quot;You speak the three words. The gate opens onto a morning that has not happened yet.\nThe house calls after you in Mother’s voice. This time, you do not answer.&quot;,[&quot;flags&quot;]={&quot;note1&quot;,&quot;note2&quot;,&quot;note3&quot;,&quot;gateWords&quot;}},[&quot;well&quot;]={[&quot;title&quot;]=&quot;Ending VIII · The lullaby below&quot;,[&quot;text&quot;]=&quot;The music box sings into the well. A child finishes the song from somewhere far beneath the water.\nWhen you return to the house, the spare room is a cupboard.\nEvery night, a new flower grows beside the well.&quot;,[&quot;flags&quot;]={&quot;note4&quot;,&quot;music&quot;,&quot;wellQuiet&quot;}},[&quot;whole&quot;]={[&quot;title&quot;]=&quot;Ending IX · Your own handwriting&quot;,[&quot;text&quot;]=&quot;You write your own name over both names in the diary.\nThe mirror cracks without breaking. Mother remembers a single child, with every memory intact.\nThe sticky notes disappear. You leave one of your own: “We got out.”&quot;,[&quot;flags&quot;]={&quot;note1&quot;,&quot;note2&quot;,&quot;note3&quot;,&quot;note4&quot;,&quot;note5&quot;,&quot;note6&quot;,&quot;truth&quot;,&quot;mirror&quot;}},[&quot;morning&quot;]={[&quot;title&quot;]=&quot;Ending X · A garden for tomorrow&quot;,[&quot;text&quot;]=&quot;At dawn, every flower faces the house. You invite Mother outside.\nShe names the flowers instead of naming the things she lost.\nFor the first time, the diary has no entry for tomorrow.&quot;,[&quot;flags&quot;]={&quot;planted&quot;,&quot;wellQuiet&quot;}},[&quot;burial&quot;]={[&quot;title&quot;]=&quot;Ending XI · What the earth keeps&quot;,[&quot;text&quot;]=&quot;You leave the memory beneath the roots. The spare room fills with the smell of rain.\nMother remembers love without remembering the room.\nEvery autumn, you find one small brass leaf beneath the tree.&quot;,[&quot;flags&quot;]={&quot;buried&quot;,&quot;note4&quot;}},[&quot;light&quot;]={[&quot;title&quot;]=&quot;Ending XII · Your own shadow&quot;,[&quot;text&quot;]=&quot;The lantern lights a path beyond the garden. You follow the shadow that moves exactly when you do.\nBehind you, the house keeps calling your name.\nYou let the flame answer.&quot;,[&quot;flags&quot;]={&quot;lantern&quot;,&quot;note5&quot;}},[&quot;grid&quot;]={[&quot;title&quot;]=&quot;Ending 25 · A city with its lights on&quot;,[&quot;text&quot;]=&quot;You isolate the circuit feeding the spare room. Along every street, the lamps brighten. Mother calls from a house with one fewer door.&quot;,[&quot;flags&quot;]={&quot;power&quot;}},[&quot;dawn&quot;]={[&quot;title&quot;]=&quot;Ending 26 · The first bus home&quot;,[&quot;text&quot;]=&quot;You sit beside the porter and wait until daylight. When the next bus arrives, the passengers are ordinary strangers. For once, nobody knows your name.&quot;,[&quot;flags&quot;]={&quot;venue:station&quot;}},[&quot;witness&quot;]={[&quot;title&quot;]=&quot;Ending 27 · The witness&quot;,[&quot;text&quot;]=&quot;You watch the film, then tell the archivist exactly what you saw. This time, there is a witness outside the house. Mother can no longer be made to forget.&quot;,[&quot;flags&quot;]={&quot;projectorSeen&quot;,&quot;venue:library&quot;}},[&quot;keeper&quot;]={[&quot;title&quot;]=&quot;Ending 28 · Keep the door closed&quot;,[&quot;text&quot;]=&quot;You choose to remain, with a warning on the fuse box and the lantern beside the door. The house does not stop whispering. You learn when not to listen.&quot;,[&quot;flags&quot;]={&quot;lantern&quot;,&quot;truth&quot;}},[&quot;burn&quot;]={[&quot;title&quot;]=&quot;Ending I · An empty room&quot;,[&quot;text&quot;]=&quot;The photograph and recording prove that you were here. You burn the diary. The door becomes a patch of wallpaper.\nMother finally says your name.\nThat night, you hear a child crying inside the wall.&quot;,[&quot;flags&quot;]={&quot;tomorrowDiary&quot;}},[&quot;enter&quot;]={[&quot;title&quot;]=&quot;Ending II · The remembered&quot;,[&quot;text&quot;]=&quot;You enter the room. The figure has your face at seven years old.\n“I kept everything you couldn’t bear,” it says.\nYou sit beside it. Downstairs, Mother calls both your names.\nFor the first time, you answer together.&quot;,[&quot;flags&quot;]={&quot;tomorrowDiary&quot;}},[&quot;release&quot;]={[&quot;title&quot;]=&quot;Ending III · The spare&quot;,[&quot;text&quot;]=&quot;You unlock the door. Someone wearing your face walks downstairs.\nMother embraces them. “You’re finally home.”\nYou try to follow, but the hallway ends at a bedroom. On its desk is a diary.\nYou pick up the pen.&quot;,[&quot;flags&quot;]={&quot;tomorrowDiary&quot;}}}}}
</ProtectedString></Properties></Item></Item><Item class="ServerScriptService" referent="RBX8607"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX8605"><Properties><string name="Name">SpareRoomServer</string><ProtectedString name="Source">-- ServerScriptService/SpareRoomServer
local Players = game:GetService(&quot;Players&quot;)
-- Death stays final until a free restart or a verified single-use revive is selected.
Players.CharacterAutoLoads = false
local MarketplaceService = game:GetService(&quot;MarketplaceService&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local Lighting = game:GetService(&quot;Lighting&quot;)
local DataStoreService = game:GetService(&quot;DataStoreService&quot;)
local Config = require(ReplicatedStorage:WaitForChild(&quot;SpareRoomConfig&quot;))
local Content=require(ReplicatedStorage:WaitForChild(&quot;SpareRoomContent&quot;))
local world = workspace:WaitForChild(&quot;SpareRoomWorld&quot;)
local items = world:WaitForChild(&quot;Interactables&quot;)
local remote = Instance.new(&quot;RemoteEvent&quot;)
remote.Name = &quot;SpareRoomEvent&quot;
remote.Parent = ReplicatedStorage
-- Keep this allowlist server-side. Never put passwords in a Roblox place.
local ADMIN_USER_IDS = {} -- Example: [123456789] = true
local function isAdmin(player)
 return RunService:IsStudio() or ADMIN_USER_IDS[player.UserId] == true
  or (game.CreatorType == Enum.CreatorType.User and game.CreatorId == player.UserId)
end
local destinations = {
 Upstairs = Vector3.new(0,16,8), House = Vector3.new(0,4,-15), Garden = Vector3.new(0,4,35), Basement = Vector3.new(0,-14,-12),
 Cinema = Vector3.new(-96,4,-79), Archive = Vector3.new(-56,4,-79), Clinic = Vector3.new(-16,4,-79),
 Station = Vector3.new(24,4,-79), Workshop = Vector3.new(64,4,-79), Costumes = Vector3.new(104,4,-79),
 Park = Vector3.new(-85,4,35), School = Vector3.new(85,4,38), Bookshop = Vector3.new(-76,4,-11), Cafe = Vector3.new(76,4,-11),
}
local Revive = require(ReplicatedStorage:WaitForChild(&quot;SpareRoomRevive&quot;))
local states = {}
local prompts = {}
local economy, lobby
local lobbySpawn=Vector3.new(400,4,5)
local function classStats(s) return Config.Classes[s.classId or &quot;Wanderer&quot;] or Config.Classes.Wanderer end
local function value(part, name)
 local v = part:FindFirstChild(name)
 return v and v.Value or &quot;&quot;
end
local function count(set)
 local n = 0
 for _ in pairs(set) do n += 1 end
 return n
end
local function position(player)
 local character = player.Character
 local root = character and character:FindFirstChild(&quot;HumanoidRootPart&quot;)
 return root
end
local function paused(s)
 return not s.started or s.reading ~= nil or s.menu or s.ended ~= nil
end
local function snapshot(player)
 local s = states[player]
 if not s then return end
 local household = {}
 for _, member in ipairs(Players:GetPlayers()) do
  local state = states[member]
  table.insert(household,{name=member.DisplayName,started=state and state.started==true,paused=not state or paused(state)})
 end
 local observed = {}
 for _, a in ipairs(Config.Anomalies) do
  if s.anomalies[a.id] then table.insert(observed, a.title .. &quot; — &quot; .. a.text) end
 end
 local journal = {}
 for id in pairs(s.journal) do
  local e = Config.Endings[id]
  if e then table.insert(journal, e.title) end
 end
 table.sort(journal)
 remote:FireClient(player, &quot;State&quot;, {
  household = household, observed = observed, admin = isAdmin(player), flying = s.flying == true, day = s.day or 1, started = s.started, mode = s.mode, classId=s.classId or &quot;Wanderer&quot;, sanity = s.sanity, stamina = s.stamina,
  diary = count(s.diary), records = count(s.records), rooms = count(s.rooms),
  anomalies = count(s.anomalies), hasKey = s.key, journal = journal,
  sandwich = math.max(0, math.ceil(s.sandwichAt - s.time)),
  ended = s.ended, lost = s.ended == &quot;consumed&quot;,
 })
end
local function saveJournal(player, s)
 if not Config.SaveEndingJournal or not s.canSave then return end
 local copy = table.clone(s.journal)
 task.spawn(function()
  local ok, err = pcall(function()
   DataStoreService:GetDataStore(&quot;SpareRoomRobloxEndings_v1&quot;):UpdateAsync(&quot;u&quot; .. player.UserId, function(old)
    local result = {}
    if typeof(old) == &quot;table&quot; then
     for id, yes in pairs(old) do if yes == true and Config.Endings[id] then result[id] = true end end
    end
    for id in pairs(copy) do result[id] = true end
    return result
   end)
  end)
  if not ok then warn(&quot;The Spare Room: ending journal was not saved: &quot; .. tostring(err)) end
 end)
end
local function finish(player, id)
 local s = states[player]
 local ending = Config.Endings[id]
 if not s or s.ended or not ending then return end
 s.ended = id
 s.journal[id] = true
 if economy and id~=&quot;consumed&quot; and id~=&quot;fallen&quot; then task.spawn(function() economy:award(player,&quot;ending:&quot;..id,40) end) end
 s.sprint = false
 s.active=nil s.flying=false
 if id==&quot;consumed&quot; then
  local humanoid=player.Character and player.Character:FindFirstChildOfClass(&quot;Humanoid&quot;)
  if humanoid then humanoid.Health=0 end
 end
 remote:FireClient(player, &quot;AnomalyEnd&quot;)
 remote:FireClient(player, &quot;Ending&quot;, {id = id, title = ending.title, text = id==&quot;legacy:burn&quot; and not(s.flags.photo and s.flags.tape) and ending.unprotectedText or ending.text})
 snapshot(player)
 saveJournal(player, s)
end
local function damage(player, amount)
 local s = states[player]
 if not s or s.ended then return end
 local loss = amount * Config.Modes[s.mode].damage * classStats(s).damage
 s.sanity = math.max(0, s.sanity - loss)
 if loss &gt; 2 then remote:FireClient(player, &quot;SanityHit&quot;, loss) end
 if s.sanity &lt;= 0 then finish(player, &quot;consumed&quot;) end
end
local function tell(player, text)
 remote:FireClient(player, &quot;Caption&quot;, text)
end
local function reset(player, mode)
 local old = states[player]
 states[player] = {
  classId=economy and economy:class(player) or &quot;Wanderer&quot;, started = true, mode = mode, sanity = 100, stamina = 100, diary = {}, evidence={}, records = {}, rooms = {},
  anomalies = {}, journal = old and old.journal or {}, canSave = old and old.canSave or false,
  flags = {}, key = false, sandwichAt = 0, time = 0, nextAnomaly = Config.Modes[mode].delay,
  active = nil, menu = false, reading = nil, ended = nil, sprint = false, exhausted = false,
  day = 1, flying = false, sequence = old and old.sequence or 0, lastRequest = 0, lastStart = os.clock(),
 }
 remote:FireClient(player, &quot;AnomalyEnd&quot;)
 if not player.Character or not player.Character:FindFirstChildOfClass(&quot;Humanoid&quot;) or player.Character:FindFirstChildOfClass(&quot;Humanoid&quot;).Health &lt;= 0 then
  pcall(function() player:LoadCharacterAsync() end)
 end
 local root = position(player)
 if root then player.Character:PivotTo(CFrame.new(0, 4, -15)) end
 snapshot(player)
end
local function canRevive(player)
 local s=states[player]
 return s~=nil and (s.ended==&quot;consumed&quot; or s.ended==&quot;fallen&quot;) and not s.reviveBusy
end
local function revivePlayer(player)
 local s=states[player]
 if not canRevive(player) then return false end
 s.reviveBusy=true
 local ok=pcall(function() player:LoadCharacterAsync() end)
 if states[player]~=s then return false end
 s.reviveBusy=nil
 if not ok then return false end
 if s.ended~=&quot;consumed&quot; and s.ended~=&quot;fallen&quot; then return false end
 s.ended=nil s.sanity=Config.ReviveSanity s.stamina=100
 s.reading=nil s.confirm=nil s.menu=false s.sprint=false s.flying=false
 s.active=nil s.nextAnomaly=s.time+Config.Modes[s.mode].delay
 local root=position(player)
 if root then player.Character:PivotTo(CFrame.new(0,4,-15)) end
 remote:FireClient(player,&quot;Revived&quot;,&quot;You wake at home. Your discoveries remain. Sanity restored to &quot;..Config.ReviveSanity..&quot;%.&quot;)
 snapshot(player)
 return true
end
local receiptReady=false
local HttpService=game:GetService(&quot;HttpService&quot;)
-- A downloaded/unpublished place may reject DataStore access. Purchases must
-- fail closed without preventing the game and its menu handlers from starting.
local storeOK,reviveStore=pcall(function()
 return DataStoreService:GetDataStore(&quot;SpareRoomReviveCredits_v1&quot;)
end)
if not storeOK then
 warn(&quot;Revive storage unavailable; gameplay remains available: &quot;..tostring(reviveStore))
 reviveStore={UpdateAsync=function() error(&quot;Publish this place and enable supported DataStore access before testing paid revives.&quot;) end}
end
local reviveGate=Revive.new({market=MarketplaceService,productId=Config.ReviveProductId,store=reviveStore,
 ready=function() return receiptReady end, now=os.time, token=function() return HttpService:GenerateGUID(false) end,
 player=function(id) return Players:GetPlayerByUserId(id) end, defer=task.defer,
 canRevive=canRevive,revive=revivePlayer,status=function(player,message)
  if player.Parent==Players then remote:FireClient(player,&quot;ReviveStatus&quot;,message) end
 end})
if Config.ReviveProductId&gt;0 then
 local ok,err=pcall(function()
  MarketplaceService:BindReceiptHandler(Enum.ReceiptType.DeveloperProduct,function(receipt)
   return reviveGate:receipt(receipt) and Enum.ReceiptDecision.Processed or Enum.ReceiptDecision.NotProcessedYet
  end,{Config.ReviveProductId})
 end)
 receiptReady=ok
 if not ok then warn(&quot;Revive receipt handler could not register; purchases disabled: &quot;..tostring(err)) end
end
-- Filtered handler leaves HD Admin and other products' ProcessReceipt handlers intact.
MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId,id)
 local player=Players:GetPlayerByUserId(userId)
 if player then reviveGate:purchaseFinished(player,id) end
end)
-- Currency is separate from revive credits; product filters never overlap.
local Economy=require(ReplicatedStorage:WaitForChild(&quot;SpareRoomEconomy&quot;))
local Lobby=require(ReplicatedStorage:WaitForChild(&quot;SpareRoomLobby&quot;))
local economyOK,economyStore=pcall(function() return DataStoreService:GetDataStore(&quot;SpareRoomMemoryShards_v1&quot;) end)
if not economyOK then economyStore={GetAsync=function() error(&quot;Storage unavailable&quot;) end,UpdateAsync=function() error(&quot;Storage unavailable&quot;) end} end
local products,productIds={},{}
for _,pack in ipairs(Config.ShardPacks) do
 if pack.productId&gt;0 and pack.productId~=Config.ReviveProductId and not products[pack.productId] then
  products[pack.productId]=pack.amount table.insert(productIds,pack.productId)
 end
end
local shardReceiptsReady=false
local function inLobby(player) local s=states[player] return s~=nil and not s.started end
local function economyStatus(player,message)
 if player.Parent==Players then remote:FireClient(player,&quot;EconomyStatus&quot;,message) end
end
economy=Economy.new({store=economyStore,classes=Config.Classes,products=products,market=MarketplaceService,
 player=function(id) return Players:GetPlayerByUserId(id) end,present=function(p) return p.Parent==Players end,
 lobby=inLobby,wait=function() task.wait() end,ready=function() return shardReceiptsReady end,
 send=function(p,data) remote:FireClient(p,&quot;Economy&quot;,data) end,status=economyStatus})
if #productIds&gt;0 then
 local ok,err=pcall(function()
  MarketplaceService:BindReceiptHandler(Enum.ReceiptType.DeveloperProduct,function(info)
   return economy:receipt(info) and Enum.ReceiptDecision.Processed or Enum.ReceiptDecision.NotProcessedYet
  end,productIds)
 end)
 shardReceiptsReady=ok
 if not ok then warn(&quot;Shard checkout disabled: &quot;..tostring(err)) end
end
MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId,id)
 local p=Players:GetPlayerByUserId(userId) if p then economy:closed(p,id) end
end)
lobby=Lobby.new({modes=Config.Modes,available=inLobby,status=economyStatus,
 send=function(p,data) if p.Parent==Players then remote:FireClient(p,&quot;Queue&quot;,data) end end,
 move=function(p,mode)
  local x=mode==&quot;Easy&quot; and 378 or mode==&quot;Intermediate&quot; and 400 or 422
  if p.Character then p.Character:PivotTo(CFrame.new(x,4,-6)) end
 end,
 start=function(p,mode,group)
  p:SetAttribute(&quot;DepartureGroup&quot;,group) reset(p,mode)
 end})
local function returnLobby(player)
 local s=states[player] if not s or s.reviveBusy then return end
 lobby:leave(player)
 s.started=false s.sanity=100 s.stamina=100 s.ended=nil s.reading=nil s.confirm=nil s.menu=false s.sprint=false s.active=nil s.flying=false
 remote:FireClient(player,&quot;AnomalyEnd&quot;)
 local h=player.Character and player.Character:FindFirstChildOfClass(&quot;Humanoid&quot;)
 if not h or h.Health&lt;=0 then pcall(function() player:LoadCharacterAsync() end) end
 if player.Character then player.Character:PivotTo(CFrame.new(lobbySpawn)) end
 snapshot(player) economy:publish(player)
end
local function valid(player, part)
 local s = states[player]
 local root = position(player)
 if not s or not root or not part or not part:IsDescendantOf(items) then return false end
 local role=value(part,&quot;Role&quot;)
 local lobbyItem=role==&quot;lobbyQueue&quot; or role==&quot;lobbyNote&quot; or role==&quot;lobbyShop&quot; or role==&quot;lobbySolo&quot;
 if lobbyItem then
  if s.started or s.reading then return false end
 elseif paused(s) then return false end
 if (root.Position - part.Position).Magnitude &gt; 7.5 then return false end
 local params = RaycastParams.new()
 params.FilterType = Enum.RaycastFilterType.Exclude
 params.FilterDescendantsInstances = {player.Character, workspace:FindFirstChild(&quot;SpareRoomNPCs&quot;)}
 local head = player.Character and player.Character:FindFirstChild(&quot;Head&quot;)
 local origin = head and head.Position or root.Position
 local hit = workspace:Raycast(origin, part.Position - origin, params)
 return hit == nil or hit.Instance == part
end
local function read(player, part, text, cost)
 local s = states[player]
 s.sequence += 1
 s.reading = {id = s.sequence, part = part, cost = cost}
 s.sprint = false
 remote:FireClient(player, &quot;Read&quot;, {id = s.sequence, title = value(part, &quot;Title&quot;), text = text})
end
local function sourceRequirements(s,r)
 if not r then return true end
 local function has(id)
  local n=string.match(id,&quot;^diary(%d+)$&quot;)
  return n and s.diary[tonumber(n)] or s.evidence and s.evidence[id]
 end
 for _,id in ipairs(r.items or {}) do if not has(id) then return false end end
 for _,f in ipairs(r.flags or {}) do if not s.flags[f] then return false end end
 for _,id in ipairs(r.anomalies or {}) do if not s.anomalies[&quot;source:&quot;..id] then return false end end
 local types={photos=&quot;photo&quot;,records=&quot;record&quot;,drawings=&quot;drawing&quot;,letters=&quot;letter&quot;,memories=&quot;memory&quot;,dad=&quot;dad&quot;}
 for key,kind in pairs(types) do
  if r[key] then
   local n=0 for _,item in ipairs(Content.deepItems) do if item.type==kind and has(item.id) then n+=1 end end
   if n&lt;r[key] then return false end
  end
 end
 local witnessed=0 for id in pairs(s.anomalies) do if string.sub(id,1,7)==&quot;source:&quot; then witnessed+=1 end end
 return count(s.diary)&gt;=(r.diary or 0) and witnessed&gt;=(r.anomalyCount or 0)
  and (not r.sanityMin or s.sanity&gt;=r.sanityMin) and (not r.sanityMax or s.sanity&lt;=r.sanityMax)
end
local function roomUnlocked(s,id)
 local items=s.evidence or {}
 if id==&quot;archive&quot; then return items[&quot;key-archive&quot;] end
 if id==&quot;study&quot; then return items[&quot;key-study&quot;] end
 if id==&quot;observation&quot; then return items[&quot;key-observation&quot;] end
 if id==&quot;sealed&quot; then return items[&quot;key-observation&quot;] and s.flags.valve end
 return true
end
local function interact(player, part)
 local s = states[player]
 local role = value(part, &quot;Role&quot;)
 if role==&quot;roomGate&quot; then
  local room=value(part,&quot;Room&quot;)
  if not roomUnlocked(s,room) then tell(player,&quot;The door needs its labelled key&quot;..(room==&quot;sealed&quot; and &quot; and an isolated boiler valve.&quot; or &quot;.&quot;)) return end
  local root=position(player) local side=part.Position.X&gt;0 and 1 or -1
  local inside=root and math.abs(root.Position.X)&gt;4
  player.Character:PivotTo(CFrame.new(inside and 0 or side*8,-14,part.Position.Z))
 elseif role==&quot;lobbyQueue&quot; then
  lobby:join(player,value(part,&quot;Mode&quot;))
 elseif role==&quot;lobbyShop&quot; then
  if lobby.membership[player] then economyStatus(player,&quot;Leave the departure queue before shopping.&quot;)
  else economy:publish(player) remote:FireClient(player,&quot;OpenClassShop&quot;) end
 elseif role==&quot;lobbySolo&quot; then
  local mode=value(part,&quot;Mode&quot;)
  if Config.Modes[mode] then lobby:leave(player) reset(player,mode) end
 elseif role==&quot;lobbyNote&quot; then
  read(player,part,value(part,&quot;Text&quot;),0)
 elseif role==&quot;observe&quot; then
  local options={} for _,a in ipairs(Config.Anomalies) do if a.source and a.room==value(part,&quot;Room&quot;) then table.insert(options,a.id) end end
  if #options&gt;0 and not s.active then s.requestedAnomaly=options[math.random(#options)] s.nextAnomaly=s.time end
 elseif role==&quot;evidence&quot; then
  local id=value(part,&quot;Evidence&quot;) s.evidence=s.evidence or {}
  local first=not s.evidence[id] s.evidence[id]=true
  if id==&quot;key-chamber&quot; then s.key=true end
  read(player,part,value(part,&quot;Text&quot;),first and value(part,&quot;Category&quot;)~=&quot;key&quot; and 2 or 0)
 elseif role == &quot;diary&quot; then
  local n = tonumber(value(part, &quot;Index&quot;))
  if not n or not Config.Diary[n] then return end
  local first = not s.diary[n]
  s.diary[n] = true
  if first then task.spawn(function() economy:award(player,&quot;diary:&quot;..n,2) end) end
  read(player, part, Config.Diary[n], first and (n &gt; 10 and 3 or 1) or 0)
 elseif role == &quot;record&quot; then
  local id = value(part, &quot;Index&quot;)
  local first = not s.records[id]
  s.records[id] = true
  read(player, part, value(part, &quot;Text&quot;), first and 3 or 0)
 elseif role == &quot;story&quot; then
  local flag=value(part,&quot;Flag&quot;)
  local first=not s.flags[flag]
  s.flags[flag]=true
  read(player,part,value(part,&quot;Text&quot;),first and (tonumber(value(part,&quot;Cost&quot;)) or 0) or 0)
 elseif role == &quot;mum&quot; then
  s.flags.mum = true
  read(player, part, &quot;“I remember making up the beds,” Mum says. “Please do not give me an answer just because I cannot find one.”&quot;, 0)
 elseif role == &quot;doll&quot; then
  local first = not s.flags.doll
  s.flags.doll=true
  read(player,part,&quot;A small cloth tag reads: PROPERTY OF THE CHILDREN. Someone has crossed out the final letters, then carefully stitched them back.\n\nMum remembers buying it. She cannot remember how many hands reached for the box.&quot;,first and 4 or 0)
 elseif role == &quot;mirror&quot; then
  local first = not s.flags.mirror
  s.flags.mirror = true
  read(player, part, &quot;There are four height marks in the dust on the frame. Your reflection obscures the smallest one. A scratched line says: KEEP BOTH COPIES.&quot;, first and 5 or 0)
 elseif role == &quot;valve&quot; then
  s.flags.valve = true
  tell(player, &quot;The knocking pipe falls quiet. Someone has corrected the maintenance date twice.&quot;)
 elseif role == &quot;anchor&quot; then
  s.flags.anchor = true
  tell(player, &quot;You keep an ordinary memory close. You do not decide who shared it.&quot;)
 elseif role == &quot;key&quot; then
  s.key = true
  tell(player, &quot;You take the unnumbered key. Its label has been corrected by hand.&quot;)
 elseif role == &quot;sandwich&quot; then
  if s.time &lt; s.sandwichAt then
   tell(player, &quot;The next sandwich is ready in &quot; .. math.ceil(s.sandwichAt - s.time) .. &quot; seconds of active play.&quot;)
  else
   s.sanity = math.min(100, s.sanity + Config.Modes[s.mode].sandwich + classStats(s).food)
   s.sandwichAt = s.time + 120
   tell(player, &quot;You eat the sandwich. The kitchen smells ordinary again.&quot;)
  end
 elseif role == &quot;hatch&quot; or role == &quot;stairs&quot; or role == &quot;exitChamber&quot; then
  local target = role == &quot;hatch&quot; and Vector3.new(0, -14, -12) or role == &quot;stairs&quot; and Vector3.new(0, 4, 17) or Vector3.new(0, -14, 63)
  player.Character:PivotTo(CFrame.new(target))
  remote:FireClient(player, &quot;AnomalyEnd&quot;)
  s.active = nil
  s.nextAnomaly = s.time + 10
 elseif role == &quot;gate&quot; then
  if count(s.diary) &lt; 12 or (count(s.records) &lt; 3 and not sourceRequirements(s,{records=3})) or not s.key then
   tell(player, &quot;The chamber needs 12 diary pages, 3 family records and the unnumbered key.&quot;)
  else
   player.Character:PivotTo(CFrame.new(9, -14, 63))
  end
 elseif role == &quot;ending&quot; then
  local id = value(part, &quot;Ending&quot;)
  local e = Config.Endings[id]
  if not e then return end
  local ready = count(s.diary) &gt;= (e.diary or 0) and count(s.records) &gt;= (e.records or 0)
   and count(s.anomalies) &gt;= (e.anomalies or 0) and (not e.anchor or s.flags.anchor)
   and (not e.valve or s.flags.valve) and (not e.mum or s.flags.mum)
   and (not e.sanityMax or s.sanity &lt;= e.sanityMax)
  ready=ready and sourceRequirements(s,e.requirements)
  if e.dayOnly and (Lighting.ClockTime&lt;7 or Lighting.ClockTime&gt;18) then ready=false end
  for _,flag in ipairs(e.flags or {}) do if not s.flags[flag] then ready=false end end
  if ready then
   s.sequence += 1
   s.confirm = {id = id, nonce = s.sequence, part = part}
   remote:FireClient(player, &quot;Confirm&quot;, {id = id, nonce = s.sequence, title = e.title, text = id==&quot;legacy:burn&quot; and not(s.flags.photo and s.flags.tape) and e.unprotectedText or e.text})
   s.menu = true
  else
   if e.requirements then tell(player,&quot;This ending needs more original evidence, room decisions or witnessed anomalies. Keep exploring the basement stations.&quot;) return end
   if e.flags then tell(player,&quot;Read the room’s hidden note and complete its unfinished task first.&quot;) return end
   tell(player, &quot;Requires diary pages: &quot; .. (e.diary or 0) .. &quot;, records: &quot; .. (e.records or 0) .. &quot;, anomalies: &quot; .. (e.anomalies or 0)
    .. (e.anchor and &quot;; hold the ordinary memory&quot; or &quot;&quot;) .. (e.valve and &quot;; isolate the boiler pipe&quot; or &quot;&quot;)
    .. (e.mum and &quot;; speak with Mum&quot; or &quot;&quot;) .. (e.sanityMax and &quot;; sanity at or below &quot; .. e.sanityMax .. &quot;%&quot; or &quot;&quot;))
  end
 end
 snapshot(player)
end
local atmosphere=Instance.new(&quot;Atmosphere&quot;) atmosphere.Name=&quot;AshfieldHaze&quot;
atmosphere.Density=0.18 atmosphere.Offset=0.05 atmosphere.Color=Color3.fromRGB(191,204,184)
atmosphere.Decay=Color3.fromRGB(91,110,98) atmosphere.Glare=0.12 atmosphere.Haze=1.2 atmosphere.Parent=Lighting
local rays=Instance.new(&quot;SunRaysEffect&quot;) rays.Intensity=0.025 rays.Spread=0.8 rays.Parent=Lighting
Lighting.ClockTime = 8
local worldSeconds=0
local worldDay=1
Lighting.GlobalShadows = true
Lighting.EnvironmentDiffuseScale = 0.35
Lighting.EnvironmentSpecularScale = 0.65
Lighting.ExposureCompensation = -0.15
Lighting.Brightness = 1.5
local grade = Instance.new(&quot;ColorCorrectionEffect&quot;)
grade.Name = &quot;SpareRoomGrade&quot;
grade.TintColor = Color3.fromRGB(225, 233, 221)
grade.Saturation = -0.22
grade.Contrast = 0.12
grade.Parent = Lighting
local bloom = Instance.new(&quot;BloomEffect&quot;)
bloom.Intensity = 0.12
bloom.Size = 24
bloom.Threshold = 1.6
bloom.Parent = Lighting
Lighting.Ambient = Color3.fromRGB(35, 39, 39)
Lighting.OutdoorAmbient = Color3.fromRGB(50, 57, 63)
Lighting.FogColor = Color3.fromRGB(17, 24, 25)
Lighting.FogStart = 110
Lighting.FogEnd = 310
for _, part in ipairs(world:GetDescendants()) do
 if part:IsA(&quot;BasePart&quot;) then
  local material = part:FindFirstChild(&quot;MaterialName&quot;)
  if material and Enum.Material[material.Value] then part.Material = Enum.Material[material.Value] end
  if part.Name == &quot;Lamp&quot; then
   local light = Instance.new(&quot;PointLight&quot;)
   light.Color = Color3.fromRGB(239, 207, 155)
   light.Brightness = part.Position.Y &lt; -5 and 0.65 or 1.1
   light.Range = part.Position.Y &lt; -5 and 17 or 25
   light.Shadows = part.Position.Y &lt; -5 or math.abs(part.Position.X)&lt;25
   light.Parent = part
  end
  local sign = part:FindFirstChild(&quot;Sign&quot;)
  if sign then
   local gui = Instance.new(&quot;SurfaceGui&quot;)
   gui.Face = value(part, &quot;Side&quot;) == &quot;Right&quot; and Enum.NormalId.Right or value(part, &quot;Side&quot;) == &quot;Left&quot; and Enum.NormalId.Left or value(part, &quot;Side&quot;) == &quot;Back&quot; and Enum.NormalId.Back or Enum.NormalId.Front
   gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
   gui.PixelsPerStud = 60
   gui.AlwaysOnTop = false
   gui.Parent = part
   local label = Instance.new(&quot;TextLabel&quot;)
   label.Size = UDim2.fromScale(1, 1)
   label.BackgroundTransparency = 1
   label.TextColor3 = Color3.fromRGB(232, 218, 181)
   local kind = value(part, &quot;Venue&quot;)
   label.Font = (kind == &quot;ARCHIVE&quot; or kind == &quot;BOOKSHOP&quot;) and Enum.Font.Garamond
    or kind == &quot;CINEMA&quot; and Enum.Font.GothamBlack or Enum.Font.GothamMedium
   local padding = Instance.new(&quot;UIPadding&quot;)
   padding.PaddingLeft = UDim.new(0.05, 0)
   padding.PaddingRight = UDim.new(0.05, 0)
   padding.PaddingTop = UDim.new(0.12, 0)
   padding.PaddingBottom = UDim.new(0.12, 0)
   padding.Parent = label
   label.TextScaled = true
   label.TextWrapped = true
   label.Text = sign.Value
   label.Parent = gui
  end
 end
end
for _, part in ipairs(items:GetChildren()) do
 if part:IsA(&quot;BasePart&quot;) then
  local prompt = Instance.new(&quot;ProximityPrompt&quot;)
  prompt.Style = Enum.ProximityPromptStyle.Default
  prompt.ActionText = value(part, &quot;Action&quot;)
  prompt.ObjectText = value(part, &quot;Title&quot;)
  prompt.KeyboardKeyCode = Enum.KeyCode.E
  prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
  prompt.MaxActivationDistance = 6
  prompt.RequiresLineOfSight = true
  prompt.HoldDuration = 0.8
  prompt.ClickablePrompt = true
  prompt.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
  prompt.Parent = part
  prompts[part] = prompt
  -- Roblox owns hold progress. Validate the completed trigger independently.
  -- A second replicated hold-start clock can reject otherwise completed holds.
  prompt.Triggered:Connect(function(player)
   if not prompt.Enabled or not valid(player, part) then return end
   local state = states[player]
   local now = os.clock()
   if now - (state.lastInteraction or -10) &lt; 0.35 then return end
   state.lastInteraction = now
   interact(player, part)
  end)
 end
end
local function joined(player)
 states[player] = {
  started = false, mode = &quot;Easy&quot;, sanity = 100, stamina = 100, diary = {}, evidence={}, records = {}, rooms = {},
  anomalies = {}, journal = {}, flags = {}, time = 0, sandwichAt = 0, sequence = 0, nextAnomaly = 45, lastRequest = 0,
 }
 task.spawn(function() economy:load(player) end)
 if Config.SaveEndingJournal then
  task.spawn(function()
   local ok, saved = pcall(function() return DataStoreService:GetDataStore(&quot;SpareRoomRobloxEndings_v1&quot;):GetAsync(&quot;u&quot; .. player.UserId) end)
   local s = states[player]
   if not s then return end
   s.canSave = ok
   if ok and typeof(saved) == &quot;table&quot; then for id, yes in pairs(saved) do if yes == true and Config.Endings[id] then s.journal[id] = true end end end
   snapshot(player)
  end)
 end
 player.CharacterAdded:Connect(function(character)
  local humanoid = character:WaitForChild(&quot;Humanoid&quot;)
  humanoid.UseJumpPower = true
  humanoid.JumpPower = 45
  humanoid.Died:Connect(function()
   local state=states[player]
   if not state or state.ended then return end
   if not state.started then
    task.delay(2,function()
     if states[player]==state and not state.started and player.Parent==Players then pcall(function() player:LoadCharacterAsync() end) end
    end)
    return
   end
   finish(player,&quot;fallen&quot;)
  end)
  local state=states[player]
  if state and (state.ended==&quot;consumed&quot; or state.ended==&quot;fallen&quot;) and not state.reviveBusy then humanoid.Health=0 return end
  task.wait(0.1)
  if character.Parent then character:PivotTo(CFrame.new(state and state.started and Vector3.new(0,4,-15) or lobbySpawn)) end
 end)
 if not player.Character then task.defer(function() pcall(function() player:LoadCharacterAsync() end) end) end
end
Players.PlayerAdded:Connect(joined)
for _, player in ipairs(Players:GetPlayers()) do joined(player) end
Players.PlayerRemoving:Connect(function(player)
 local s = states[player]
 if s then saveJournal(player, s) end
 lobby:leave(player) economy:forget(player)
 states[player] = nil
 reviveGate:forget(player)
end)
game:BindToClose(function()
 if not Config.SaveEndingJournal then return end
 for player, s in pairs(states) do
  if s.canSave then
   pcall(function()
    DataStoreService:GetDataStore(&quot;SpareRoomRobloxEndings_v1&quot;):UpdateAsync(&quot;u&quot; .. player.UserId, function(old)
     local result = typeof(old) == &quot;table&quot; and old or {}
     for id in pairs(s.journal) do result[id] = true end
     return result
    end)
   end)
  end
 end
end)
remote.OnServerEvent:Connect(function(player, action, data)
 local s = states[player]
 if not s or typeof(action) ~= &quot;string&quot; then return end
 local now = os.clock()
 if action == &quot;Revive&quot; then
  if now-(s.lastReviveRequest or -10)&lt;2 then return end
  s.lastReviveRequest=now
  reviveGate:request(player)
  return
 end
 if action == &quot;Admin&quot; then
  if not isAdmin(player) or not s.started or s.ended or typeof(data) ~= &quot;table&quot; then return end
  if now - (s.lastAdmin or 0) &lt; 0.3 then return end
  s.lastAdmin = now
  local root = position(player)
  if data.command == &quot;Teleport&quot; and typeof(data.value) == &quot;string&quot; and destinations[data.value] and root then
   player.Character:PivotTo(CFrame.new(destinations[data.value]))
   remote:FireClient(player, &quot;AnomalyEnd&quot;)
   s.active = nil
  elseif data.command == &quot;Sanity&quot; and typeof(data.value) == &quot;number&quot; and (data.value == 10 or data.value == -10) then
   if data.value &lt; 0 then damage(player, 10) else s.sanity = math.min(100, s.sanity + 10) end
  elseif data.command == &quot;Fly&quot; then
   s.flying = not s.flying
  elseif data.command == &quot;Day&quot; then
   s.day = (s.day or 1) + 1
   s.time += 1200
   tell(player, &quot;Admin: advanced to day &quot; .. s.day .. &quot;.&quot;)
  elseif data.command == &quot;Clear&quot; then
   s.active = nil
   s.nextAnomaly = s.time + Config.Modes[s.mode].delay
   remote:FireClient(player, &quot;AnomalyEnd&quot;)
  elseif data.command == &quot;Anomaly&quot; and typeof(data.value) == &quot;string&quot; then
   for _, a in ipairs(Config.Anomalies) do
    if a.id == data.value then
     if a.id==&quot;watcher&quot; or a.id==&quot;doll&quot; or a.id==&quot;family&quot; then
      local templates=ReplicatedStorage:FindFirstChild(&quot;SpareRoomAvatarTemplates&quot;)
      if not templates or not templates:FindFirstChild(a.id==&quot;doll&quot; and &quot;Doll&quot; or &quot;Watcher&quot;) then
       tell(player,&quot;The house is still preparing its visitors. Try this avatar anomaly again shortly.&quot;)
       return
      end
     end
     -- Use the same floor/clearance checks as natural anomalies.
     s.adminAnomaly = a.id
     s.nextAnomaly = s.time
     s.active = nil
     break
    end
   end
  end
  snapshot(player)
  return
 end
 if action==&quot;Lobby&quot; or action==&quot;EnterLobby&quot; then returnLobby(player) return end
 if action==&quot;Queue&quot; then
  if now-(s.lastLobbyRequest or -10)&lt;0.4 then return end s.lastLobbyRequest=now
  if data==&quot;Leave&quot; then lobby:leave(player) elseif typeof(data)==&quot;string&quot; then lobby:join(player,data) end return
 end
 if action==&quot;Class&quot; or action==&quot;BuyShards&quot; or action==&quot;ReloadEconomy&quot; then
  if now-(s.lastEconomyRequest or -10)&lt;1 then return end s.lastEconomyRequest=now
  if not inLobby(player) or lobby.membership[player] then economyStatus(player,&quot;Leave the departure queue before changing classes or shopping.&quot;) return end
  if action==&quot;Class&quot; and typeof(data)==&quot;string&quot; then economy:unlock(player,data)
  elseif action==&quot;BuyShards&quot; and typeof(data)==&quot;number&quot; then economy:buy(player,data)
  elseif action==&quot;ReloadEconomy&quot; then economy:load(player) end return
 end
 if action == &quot;Ready&quot; then snapshot(player) economy:publish(player) lobby:send(player) return end
 if action == &quot;Sprint&quot; then s.sprint = data == true return end
 if action == &quot;Start&quot; then
  if s.reviveBusy then return end
  if now - (s.lastStart or -10) &lt; 2 then return end
  s.lastStart = now
 end
 if action == &quot;Start&quot; then
  if not s.started and typeof(data) == &quot;string&quot; and Config.Modes[data] then lobby:leave(player) reset(player, data) end
 elseif action == &quot;ReadClosed&quot; then
  if s.reading and data == s.reading.id then
   local cost = s.reading.cost
   s.reading = nil
   damage(player, cost)
   snapshot(player)
  end
 elseif action == &quot;Pause&quot; then
  if s.started and not s.ended and not s.reading then s.menu = data == true end
 elseif action == &quot;Finish&quot; then
  local c = s.confirm
  if c and data == c.nonce then
   s.menu = false
   s.confirm = nil
   local root = position(player)
   local e=Config.Endings[c.id]
   local allowed=e and sourceRequirements(s,e.requirements)
   for _,flag in ipairs(e and e.flags or {}) do if not s.flags[flag] then allowed=false end end
   if e and e.dayOnly and (Lighting.ClockTime&lt;7 or Lighting.ClockTime&gt;18) then allowed=false end
   if root and allowed and (root.Position - c.part.Position).Magnitude &lt; 8 then finish(player, c.id) end
  end
 elseif action == &quot;CancelEnding&quot; then s.confirm = nil s.menu = false end
end)
-- Each natural anomaly appears once before the next shuffled set begins.
local function nextNaturalAnomaly(s)
 if not s.anomalyBag or #s.anomalyBag == 0 then
  s.anomalyBag = {}
  for _, a in ipairs(Config.Anomalies) do table.insert(s.anomalyBag, a) end
  for i = #s.anomalyBag, 2, -1 do
   local j = math.random(i)
   s.anomalyBag[i], s.anomalyBag[j] = s.anomalyBag[j], s.anomalyBag[i]
  end
  if #s.anomalyBag &gt; 1 and s.anomalyBag[#s.anomalyBag].id == s.lastNatural then
   s.anomalyBag[1], s.anomalyBag[#s.anomalyBag] = s.anomalyBag[#s.anomalyBag], s.anomalyBag[1]
  end
 end
 local a = table.remove(s.anomalyBag)
 s.lastNatural = a.id
 return a
end
local function eventPoint(player)
 local root = position(player)
 if not root then return nil end
 local params = RaycastParams.new()
 params.FilterType = Enum.RaycastFilterType.Exclude
 params.FilterDescendantsInstances = {player.Character, workspace:FindFirstChild(&quot;SpareRoomNPCs&quot;)}
 for _, offset in ipairs({Vector3.new(4, 0, 0), Vector3.new(-4, 0, 0), Vector3.new(0, 0, 4), Vector3.new(0, 0, -4)}) do
  if not workspace:Raycast(root.Position, offset, params) then
   local down = workspace:Raycast(root.Position + offset, Vector3.new(0, -8, 0), params)
   if down then
    local point = down.Position + Vector3.new(0, 0.05, 0)
    local overlap = OverlapParams.new()
    overlap.FilterType = Enum.RaycastFilterType.Exclude
    overlap.FilterDescendantsInstances = {player.Character}
    local clear = true
    for _, part in ipairs(workspace:GetPartBoundsInBox(CFrame.new(point + Vector3.new(0, 5.5, 0)), Vector3.new(4.5, 10.8, 5), overlap)) do
     if part.CanCollide then clear = false break end
    end
    if clear then return point end
   end
  end
 end
 return nil
end
local accumulator = 0
local lobbyAccumulator=0
RunService.Heartbeat:Connect(function(dt)
 -- One shared 12-minute day: keeps advancing while reading or in the safe lobby.
 worldSeconds+=dt
 worldDay=math.floor((8+worldSeconds/30)/24)+1
 local hour=(8+worldSeconds/30)%24
 Lighting.ClockTime=hour
 local daylight=math.clamp(math.sin((hour-6)/12*math.pi),0,1)
 Lighting.Brightness=1.2+daylight*1.3
 Lighting.OutdoorAmbient=Color3.fromRGB(48+daylight*65,55+daylight*65,63+daylight*62)
 Lighting.ExposureCompensation=-0.1+daylight*0.15
 lobbyAccumulator+=dt
 if lobbyAccumulator&gt;=0.5 then local elapsed=lobbyAccumulator lobbyAccumulator=0 lobby:step(elapsed) end
 accumulator += dt
 for player, s in pairs(states) do
  local root = position(player)
  local humanoid = player.Character and player.Character:FindFirstChildOfClass(&quot;Humanoid&quot;)
  if humanoid then
   local locked = s.started and paused(s) or (not s.started and s.reading~=nil)
   local moving = root and Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude &gt; 1
   if not locked then
    if s.stamina &gt;= 25 then s.exhausted = false end
    local sprinting = s.sprint and not s.exhausted and moving
    s.stamina = math.clamp(s.stamina + (sprinting and -26*classStats(s).stamina or 18*classStats(s).recovery) * dt, 0, 100)
    if s.stamina == 0 then s.exhausted = true end
    humanoid.WalkSpeed = sprinting and 20 or 12
   else humanoid.WalkSpeed = 0 end
   humanoid.JumpPower = locked and 0 or 45
  end
  if not paused(s) then
   s.time += dt
   local mode = Config.Modes[s.mode]
   s.sanity = math.max(0, s.sanity - mode.drain * classStats(s).drain * dt)
   if s.sanity &lt;= 0 then finish(player, &quot;consumed&quot;) continue end
   if root then
    local row = math.floor((root.Position.Z + 18) / 18)
    if root.Position.Y &lt; -6 and row &gt;= 0 and row &lt; 5 and math.abs(root.Position.X) &gt; 4 and math.abs(root.Position.X) &lt; 28 then
     s.rooms[row * 2 + (root.Position.X &gt; 0 and 2 or 1)] = true
    end
    if not s.active and s.time &gt;= s.nextAnomaly then
     local point = eventPoint(player)
     if point then
      s.sequence += 1
      local a = nil
      if s.adminAnomaly or s.requestedAnomaly then
       local requested=s.adminAnomaly or s.requestedAnomaly
       for _, candidate in ipairs(Config.Anomalies) do if candidate.id == requested then a = candidate break end end
       s.adminAnomaly = nil s.requestedAnomaly=nil
      else a = nextNaturalAnomaly(s) end
      local templates=ReplicatedStorage:FindFirstChild(&quot;SpareRoomAvatarTemplates&quot;)
      if (a.id==&quot;watcher&quot; or a.id==&quot;doll&quot; or a.id==&quot;family&quot;) and (not templates or not templates:FindFirstChild(a.id==&quot;doll&quot; and &quot;Doll&quot; or &quot;Watcher&quot;)) then
       a=Config.Anomalies[3] -- API avatar creation may still be loading; retry through the next bag.
      end
      s.active = {elapsed = 0, duration = a.source and 18 or 14, floor = root.Position.Y &lt; -6 and &quot;below&quot; or &quot;above&quot;}
      s.anomalies[a.id] = true
      remote:FireClient(player, &quot;Anomaly&quot;, {id = a.visualId or a.id, title = a.title, text = a.text, position = point, duration = s.active.duration})
      if not a.source then damage(player, 2.5) end
     else s.nextAnomaly = s.time + 8 if s.adminAnomaly then tell(player, &quot;Move to an open floor area so the anomaly can appear safely.&quot;) end end
    end
   end
   if s.active then
    s.active.elapsed += dt
    if not root or (root.Position.Y &lt; -6 and &quot;below&quot; or &quot;above&quot;) ~= s.active.floor or s.active.elapsed &gt;= s.active.duration then
     s.active = nil
     s.nextAnomaly = s.time + mode.delay
     remote:FireClient(player, &quot;AnomalyEnd&quot;)
    end
   end
  end
  if accumulator &gt;= 0.5 then
   remote:FireClient(player,&quot;WorldClock&quot;,{hour=Lighting.ClockTime,day=worldDay})
   snapshot(player)
  end
 end
 if accumulator &gt;= 0.5 then accumulator = 0 end
end)

</ProtectedString><bool name="Disabled">false</bool></Properties></Item><Item class="Script" referent="RBX8606"><Properties><string name="Name">SpareRoomNPCs</string><ProtectedString name="Source">-- Shared, server-owned residents. Individual player menus never freeze the town.
local Players=game:GetService(&quot;Players&quot;)
local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local Physics=game:GetService(&quot;PhysicsService&quot;)
local Pathfinding=game:GetService(&quot;PathfindingService&quot;)
local Content=require(RS:WaitForChild(&quot;SpareRoomContent&quot;))
local Factory=require(RS:WaitForChild(&quot;SpareRoomAvatars&quot;))
local folder=Instance.new(&quot;Folder&quot;) folder.Name=&quot;SpareRoomNPCs&quot; folder.Parent=workspace
local templates=Instance.new(&quot;Folder&quot;) templates.Name=&quot;SpareRoomAvatarTemplates&quot; templates.Parent=RS
for _,name in ipairs({&quot;Residents&quot;,&quot;Explorers&quot;}) do pcall(function() Physics:RegisterCollisionGroup(name) end) end
Physics:CollisionGroupSetCollidable(&quot;Residents&quot;,&quot;Explorers&quot;,false)
Physics:CollisionGroupSetCollidable(&quot;Residents&quot;,&quot;Residents&quot;,false)
Physics:CollisionGroupSetCollidable(&quot;Explorers&quot;,&quot;Explorers&quot;,false)
local function setupPlayer(player)
 local function character(model)
  local function apply(p) if p:IsA(&quot;BasePart&quot;) then p.CollisionGroup=&quot;Explorers&quot; end end
  for _,p in ipairs(model:GetDescendants()) do apply(p) end
  model.DescendantAdded:Connect(apply)
 end
 player.CharacterAdded:Connect(character)
 if player.Character then character(player.Character) end
end
Players.PlayerAdded:Connect(setupPlayer)
for _,p in ipairs(Players:GetPlayers()) do setupPlayer(p) end
local function setup(model,point,anchored)
 model.Parent=folder
 Factory.place(model,point)
 local root=model.PrimaryPart
 root.Anchored=anchored
 if not anchored then root.CanCollide=true root:SetNetworkOwner(nil) end
 for _,p in ipairs(model:GetDescendants()) do if p:IsA(&quot;BasePart&quot;) then p.CollisionGroup=&quot;Residents&quot; end end
 return model:FindFirstChildOfClass(&quot;Humanoid&quot;)
end
local green=Color3.fromRGB(77,100,87)
local dark=Color3.fromRGB(44,49,49)
local mumRandom=Random.new()
local styles={
 Factory.randomStyle(&quot;Mum&quot;,&quot;Female&quot;,mumRandom),
 {name=&quot;Watcher&quot;,shirt=Color3.fromRGB(15,19,19),pants=Color3.fromRGB(12,16,17),skin=Color3.fromRGB(33,39,37),faceless=true,watcher=true,width=0.7,scale=1.75},
 {name=&quot;Doll&quot;,shirt=Color3.fromRGB(125,88,86),pants=Color3.fromRGB(162,150,122),skin=Color3.fromRGB(203,192,165),scale=0.48},
}
local function naturalAnimation(model,h)
 local animator=h:FindFirstChildOfClass(&quot;Animator&quot;) or Instance.new(&quot;Animator&quot;,h)
 local r15=h.RigType==Enum.HumanoidRigType.R15
 local ids=r15 and {idle=507766666,walk=507777826} or {idle=180435571,walk=180426354}
 local tracks={}
 for name,id in pairs(ids) do
  local anim=Instance.new(&quot;Animation&quot;) anim.AnimationId=&quot;rbxassetid://&quot;..id
  local ok,track=pcall(function() return animator:LoadAnimation(anim) end)
  anim:Destroy()
  if ok then track.Looped=true track.Priority=name==&quot;walk&quot; and Enum.AnimationPriority.Movement or Enum.AnimationPriority.Idle tracks[name]=track end
 end
 if tracks.idle then tracks.idle:Play(0.25,1,0.9+math.random()*0.2) end
 local walking=false
 h.Running:Connect(function(speed)
  local moving=speed&gt;0.5
  if moving~=walking then
   walking=moving
   if tracks.walk then if moving then tracks.walk:Play(0.2) else tracks.walk:Stop(0.25) end end
   if tracks.idle then if moving then tracks.idle:Stop(0.2) else tracks.idle:Play(0.25) end end
  end
  if moving and tracks.walk then tracks.walk:AdjustSpeed(math.clamp(speed/9,0.55,1.3)) end
 end)
 task.spawn(function()
  for _=1,10 do
   if tracks.walk and tracks.idle and tracks.walk.Length&gt;0 and tracks.idle.Length&gt;0 then model:SetAttribute(&quot;UsingAnimator&quot;,true) return end
   task.wait(0.5)
  end
 end)
end
local function walkRoute(model,h,route,rng)
 local root=model.PrimaryPart
 h.WalkSpeed=rng:NextNumber(4.8,7.6)
 while model.Parent and h.Health&gt;0 do
  while os.clock()&lt;(model:GetAttribute(&quot;TalkingUntil&quot;) or 0) do task.wait(0.25) end
  local target=route[rng:NextInteger(1,#route)]
  local path=Pathfinding:CreatePath({AgentRadius=1.5,AgentHeight=5,AgentCanJump=false,WaypointSpacing=5})
  local ok=pcall(function() path:ComputeAsync(root.Position,target) end)
  model:SetAttribute(&quot;Activity&quot;,&quot;Walking&quot;)
  if ok and path.Status==Enum.PathStatus.Success then
   for _,waypoint in ipairs(path:GetWaypoints()) do
    if not model.Parent then return end
    if os.clock()&lt;(model:GetAttribute(&quot;TalkingUntil&quot;) or 0) then break end
    h:MoveTo(waypoint.Position)
    if not h.MoveToFinished:Wait() then break end
   end
  else h:MoveTo(root.Position) end
  model:SetAttribute(&quot;Activity&quot;,&quot;Resting&quot;)
  task.wait(rng:NextNumber(2.5,8))
 end
end
-- Mum has her own kitchen routine; the Watcher and doll retain their uncanny stillness.
for i,style in ipairs(styles) do
 task.spawn(function()
  local model=Factory.create(style)
  local template=model:Clone() template.Name=style.name template.Parent=templates
  local point=i==1 and Vector3.new(-14,0,-2.1) or i==2 and Vector3.new(0,0,55) or Vector3.new(-16,3.35,16)
  local h=setup(model,point,i~=1)
  model:SetAttribute(&quot;Role&quot;,style.name)
  if i==1 then
   model:SetAttribute(&quot;NaturalResident&quot;,true)
   naturalAnimation(model,h)
   local anchor=workspace:WaitForChild(&quot;SpareRoomWorld&quot;):WaitForChild(&quot;Interactables&quot;):WaitForChild(&quot;MumConversation&quot;)
   local prompt=anchor:WaitForChild(&quot;ProximityPrompt&quot;)
   prompt.PromptButtonHoldBegan:Connect(function() model:SetAttribute(&quot;TalkingUntil&quot;,os.clock()+4) h:MoveTo(model.PrimaryPart.Position) end)
   task.spawn(function()
    while model.Parent do
     local head=model:FindFirstChild(&quot;Head&quot;)
     if head then anchor.Position=head.Position+Vector3.new(0,0,-0.7) end
     task.wait(0.1)
    end
   end)
   task.wait(0.35)
   walkRoute(model,h,{Vector3.new(-18,0,-10),Vector3.new(-10,0,-10),Vector3.new(-14,0,-2)},mumRandom)
  end
 end)
end
for i=1,8 do
 task.spawn(function()
  local x=-110+(i-1)*30
  local z=i%2==0 and -57 or -33
  local rng=Random.new()
  local gender=i%2==0 and &quot;Female&quot; or &quot;Male&quot;
  local model=Factory.create(Factory.randomStyle(&quot;Resident &quot;..i,gender,rng))
  model:SetAttribute(&quot;NaturalResident&quot;,true)
  model:SetAttribute(&quot;Role&quot;,&quot;Citizen&quot;) model:SetAttribute(&quot;Phase&quot;,i)
  local h=setup(model,Vector3.new(x,0,z),false)
  naturalAnimation(model,h)
  local head=model:FindFirstChild(&quot;Head&quot;)
  if head then
   local prompt=Instance.new(&quot;ProximityPrompt&quot;)
   prompt.ActionText=&quot;Speak with resident&quot; prompt.ObjectText=&quot;Neighbour&quot;
   prompt.HoldDuration=0.8 prompt.MaxActivationDistance=6 prompt.RequiresLineOfSight=true
   prompt.Style=Enum.ProximityPromptStyle.Default prompt.ClickablePrompt=true prompt.Parent=head
   prompt.PromptButtonHoldBegan:Connect(function()
    model:SetAttribute(&quot;TalkingUntil&quot;,os.clock()+4)
    h:MoveTo(model.PrimaryPart.Position)
   end)
   local last={}
   local lines={
    &quot;Your mother used to take the long way home. There were more hands to hold.&quot;,
    &quot;The station kept a family ticket. Nobody agrees how many seats it covered.&quot;,
    &quot;That house has always had the same windows. I count them every evening.&quot;,
    &quot;Someone returned a library book with two different names inside it.&quot;,
    &quot;I remember a small red bicycle. Perhaps it belonged to another street.&quot;,
    &quot;The shop stopped selling that doll years ago. Please do not ask how many they made.&quot;,
    &quot;There is an extra signature on your household account. It was never added.&quot;,
    &quot;If you see someone waiting in the garden, do not give them a name for my sake.&quot;,
   }
   prompt.Triggered:Connect(function(player)
    local root=player.Character and player.Character:FindFirstChild(&quot;HumanoidRootPart&quot;)
    if not root or (root.Position-head.Position).Magnitude&gt;7.5 or os.clock()-(last[player.UserId] or -10)&lt;2 then return end
    last[player.UserId]=os.clock()
    local remote=RS:FindFirstChild(&quot;SpareRoomEvent&quot;)
    if remote then remote:FireClient(player,&quot;Caption&quot;,lines[i]) end
   end)
  end
  task.wait(0.35)
  walkRoute(model,h,{Vector3.new(math.max(-120,x-22),0,z),Vector3.new(math.min(120,x+22),0,z),Vector3.new(x,0,z)},rng)
 end)
end

-- Six named residents from the original city, with independent Roblox avatar routines.
for i,resident in ipairs(Content.residents) do
 task.spawn(function()
  local venue for _,p in ipairs(Content.cityPlaces) do if p.id==resident.id then venue=p break end end
  if not venue then return end
  local rng=Random.new() local gender=i%2==0 and &quot;Female&quot; or &quot;Male&quot;
  local model=Factory.create(Factory.randomStyle(resident.name,gender,rng))
  model:SetAttribute(&quot;NaturalResident&quot;,true) model:SetAttribute(&quot;Role&quot;,&quot;Citizen&quot;)
  local point=Vector3.new(venue.x,0,venue.z+19)
  local h=setup(model,point,false) naturalAnimation(model,h)
  local head=model:FindFirstChild(&quot;Head&quot;)
  if head then
   local prompt=Instance.new(&quot;ProximityPrompt&quot;) prompt.ObjectText=resident.name prompt.ActionText=&quot;Speak&quot;
   prompt.HoldDuration=.8 prompt.MaxActivationDistance=6 prompt.RequiresLineOfSight=true prompt.Parent=head
   prompt.Triggered:Connect(function(player)
    local root=player.Character and player.Character:FindFirstChild(&quot;HumanoidRootPart&quot;)
    if root and (root.Position-head.Position).Magnitude&lt;7.5 then
     model:SetAttribute(&quot;TalkingUntil&quot;,os.clock()+5)
     local remote=RS:FindFirstChild(&quot;SpareRoomEvent&quot;) if remote then remote:FireClient(player,&quot;Caption&quot;,venue.clue) end
    end
   end)
  end
  walkRoute(model,h,{point,point+Vector3.new(8,0,0),point-Vector3.new(8,0,0)},rng)
 end)
end
for i,id in ipairs({&quot;Wanderer&quot;,&quot;Archivist&quot;,&quot;Courier&quot;,&quot;Caretaker&quot;}) do
 task.spawn(function()
  local model=Factory.create(Factory.randomStyle(id,i%2==0 and &quot;Female&quot; or &quot;Male&quot;,Random.new(i*73)))
  local h=setup(model,Vector3.new(335+(i-1)*8,1,46),true)
  h.DisplayName=id model:SetAttribute(&quot;Role&quot;,&quot;ClassDisplay&quot;)
  naturalAnimation(model,h)
 end)
end
