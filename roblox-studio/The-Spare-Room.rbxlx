opSurface">0</token><token name="BottomSurface">0</token></Properties><Item class="StringValue" referent="RBX1339"><Properties><string name="Name">MaterialName</string><string name="Value">Wood</string></Properties></Item><Item class="StringValue" referent="RBX1340"><Properties><string name="Name">Role</string><string name="Value">ending</string></Properties></Item><Item class="StringValue" referent="RBX1341"><Properties><string name="Name">Title</string><string name="Value">A decision · names</string></Properties></Item><Item class="StringValue" referent="RBX1342"><Properties><string name="Name">Action</string><string name="Value">Consider this ending</string></Properties></Item><Item class="StringValue" referent="RBX1343"><Properties><string name="Name">Ending</string><string name="Value">names</string></Properties></Item></Item><Item class="Part" referent="RBX1360"><Properties><string name="Name">SealDecision</string><CoordinateFrame name="CFrame"><X>-23</X><Y>-14.5</Y><Z>48</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1.4</X><Y>0.15</Y><Z>1</Z></Vector3><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">true</bool><float name="Transparency">0</float><Color3uint8 name="Color3uint8">13483670</Color3uint8><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties><Item class="StringValue" referent="RBX1355"><Properties><string name="Name">MaterialName</string><string name="Value">Wood</string></Properties></Item><Item class="StringValue" referent="RBX1356"><Properties><string name="Name">Role</string><string name="Value">ending</string></Properties></Item><Item class="StringValue" referent="RBX1357"><Properties><string name="Name">Title</string><string name="Value">A decision · seal</string></Properties></Item><Item class="StringValue" referent="RBX1358"><Properties><string name="Name">Action</string><string name="Value">Consider this ending</string></Properties></Item><Item class="StringValue" referent="RBX1359"><Properties><string name="Name">Ending</string><string name="Value">seal</string></Properties></Item></Item><Item class="Part" referent="RBX1376"><Properties><string name="Name">GlassDecision</string><CoordinateFrame name="CFrame"><X>23</X><Y>-14.5</Y><Z>48</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1.4</X><Y>0.15</Y><Z>1</Z></Vector3><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">true</bool><float name="Transparency">0</float><Color3uint8 name="Color3uint8">13483670</Color3uint8><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties><Item class="StringValue" referent="RBX1371"><Properties><string name="Name">MaterialName</string><string name="Value">Wood</string></Properties></Item><Item class="StringValue" referent="RBX1372"><Properties><string name="Name">Role</string><string name="Value">ending</string></Properties></Item><Item class="StringValue" referent="RBX1373"><Properties><string name="Name">Title</string><string name="Value">A decision · glass</string></Properties></Item><Item class="StringValue" referent="RBX1374"><Properties><string name="Name">Action</string><string name="Value">Consider this ending</string></Properties></Item><Item class="StringValue" referent="RBX1375"><Properties><string name="Name">Ending</string><string name="Value">glass</string></Properties></Item></Item><Item class="Part" referent="RBX1392"><Properties><string name="Name">TomorrowDecision</string><CoordinateFrame name="CFrame"><X>23</X><Y>-14.5</Y><Z>66</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1.4</X><Y>0.15</Y><Z>1</Z></Vector3><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">true</bool><float name="Transparency">0</float><Color3uint8 name="Color3uint8">13483670</Color3uint8><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties><Item class="StringValue" referent="RBX1387"><Properties><string name="Name">MaterialName</string><string name="Value">Wood</string></Properties></Item><Item class="StringValue" referent="RBX1388"><Properties><string name="Name">Role</string><string name="Value">ending</string></Properties></Item><Item class="StringValue" referent="RBX1389"><Properties><string name="Name">Title</string><string name="Value">A decision · tomorrow</string></Properties></Item><Item class="StringValue" referent="RBX1390"><Properties><string name="Name">Action</string><string name="Value">Consider this ending</string></Properties></Item><Item class="StringValue" referent="RBX1391"><Properties><string name="Name">Ending</string><string name="Value">tomorrow</string></Properties></Item></Item></Item></Item></Item><Item class="ReplicatedStorage" referent="RBX1422"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="ModuleScript" referent="RBX1421"><Properties><string name="Name">SpareRoomConfig</string><ProtectedString name="Source">-- The Spare Room: Roblox Studio starter. All positions use Roblox studs.
return {
 Version = &quot;Roblox prototype 0.1&quot;,
 SaveEndingJournal = false, -- Enable only after publishing and configuring DataStore access.
 Modes = {
  Easy = {drain = 0.025, damage = 0.75, sandwich = 15, delay = 45},
  Intermediate = {drain = 0.045, damage = 1, sandwich = 12, delay = 34},
  Hard = {drain = 0.07, damage = 1.25, sandwich = 10, delay = 25},
 },
 Diary = {
  &quot;Mum put four plates out. I counted them because I was learning fours. She said I was getting good at numbers.&quot;,
  &quot;Dad fixed the kitchen chair. He told us not to stand on it while the glue was drying. We all promised separately.&quot;,
  &quot;We measured our heights beside the little beds. My line was crooked. Someone drew a sun over it.&quot;,
  &quot;The spare room is for visitors. I asked why our coats were in its cupboard. Mum said cupboards do not belong to rooms.&quot;,
  &quot;We played a game where nobody could say their own name. Dad forgot the rules halfway through and looked frightened.&quot;,
  &quot;There was knocking after tea. It copied the number of people at the table. I did not tell anyone I counted five.&quot;,
  &quot;Mum and Dad argued about which photograph to keep. Both photographs looked ordinary until they were beside each other.&quot;,
  &quot;My school report has the wrong first name. The teacher says it is the name she has always used.&quot;,
  &quot;Someone moved my bed. The marks in the carpet say it has never been anywhere else.&quot;,
  &quot;Dad wrote a list of everything in the house. He left spaces between the names. Mum folded the spaces out.&quot;,
  &quot;The boiler answers if I tap three times. It waits until the house is quiet before adding a fourth.&quot;,
  &quot;My sibling says we never had a red bicycle. There is a photograph of us carrying it together.&quot;,
  &quot;Mum remembered an extra lunchbox this morning. By the time she found the lid, she could not remember why.&quot;,
  &quot;There is a room number on the maintenance sheet that does not appear on the plan. Its inspection is signed.&quot;,
  &quot;Dad's coat was warm when I found it. Mum says the man in the photograph is a visitor. She cannot say when he visited.&quot;,
  &quot;I can remember two people teaching me the same song. The words disagree. Both voices sound like home.&quot;,
  &quot;The little bed has my handwriting underneath. I have grown too tall to reach it without lying on the floor.&quot;,
  &quot;I asked how many children lived here. Mum said that was a cruel question. Later she asked me the same thing.&quot;,
  &quot;I am keeping both copies. If one of them disappears, please do not decide that the other one was always right.&quot;,
  &quot;I left the last page unfinished. There should be somewhere for tomorrow to go. You do not have to give us faces.&quot;,
 },
 Anomalies = {
  {id = &quot;coat&quot;, title = &quot;Small Shoulders&quot;, text = &quot;A child's coat rises as though someone is inside it. Then it hangs empty.&quot;},
  {id = &quot;steps&quot;, title = &quot;One Step More&quot;, text = &quot;Footprints continue after the person making them should have stopped.&quot;},
  {id = &quot;clock&quot;, title = &quot;The Uncounted Minute&quot;, text = &quot;The clock moves backwards. The house keeps its own time.&quot;},
  {id = &quot;chair&quot;, title = &quot;One More Place&quot;, text = &quot;There is an extra chair. Its legs are free of dust.&quot;},
 },
 Endings = {
  morning = {title = &quot;An Ordinary Morning&quot;, text = &quot;You keep one ordinary memory without deciding whose it was. Mum puts the kettle on.&quot;, diary = 2, anchor = true},
  names = {title = &quot;Names Without Faces&quot;, text = &quot;You preserve both records. Neither is declared a mistake. There is room for an answer later.&quot;, diary = 6, records = 2},
  seal = {title = &quot;Maintained in Absence&quot;, text = &quot;You renew the inspection seal. The earlier signatures remain beneath yours.&quot;, diary = 10, valve = true},
  tomorrow = {title = &quot;Somewhere for Tomorrow&quot;, text = &quot;You leave the final page unfinished. The house remembers a larger family, but offers no explanation.&quot;, diary = 20, records = 3, mum = true},
  glass = {title = &quot;The Far Side of the Glass&quot;, text = &quot;You cover the observation pane. The reflection continues arranging places on the other side.&quot;, anomalies = 3, sanityMax = 45},
  consumed = {title = &quot;YOUR SANITY GOT CONSUMED&quot;, text = &quot;The house keeps the memory you could no longer hold.&quot;},
 },
 Rooms = {&quot;Storage Room&quot;, &quot;Boiler Room&quot;, &quot;Maintenance Tunnel&quot;, &quot;Archive Room&quot;, &quot;Forgotten Family Room&quot;, &quot;Hidden Study&quot;, &quot;Sealed Corridor&quot;, &quot;Observation Room&quot;, &quot;Former Children's Area&quot;, &quot;Locked Chamber&quot;},
}
</ProtectedString></Properties></Item></Item><Item class="ServerScriptService" referent="RBX1424"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX1423"><Properties><string name="Name">SpareRoomServer</string><ProtectedString name="Source">-- ServerScriptService/SpareRoomServer
local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local Lighting = game:GetService(&quot;Lighting&quot;)
local DataStoreService = game:GetService(&quot;DataStoreService&quot;)
local Config = require(ReplicatedStorage:WaitForChild(&quot;SpareRoomConfig&quot;))
local world = workspace:WaitForChild(&quot;SpareRoomWorld&quot;)
local items = world:WaitForChild(&quot;Interactables&quot;)
local remote = Instance.new(&quot;RemoteEvent&quot;)
remote.Name = &quot;SpareRoomEvent&quot;
remote.Parent = ReplicatedStorage
local states = {}
local prompts = {}
local holds = {}
local function value(part, name)
 local v = part:FindFirstChild(name)
 return v and v.Value or &quot;&quot;
end
local function count(set)
 local n = 0
 for _ in pairs(set) do n += 1 end
 return n
end
local function position(player)
 local character = player.Character
 local root = character and character:FindFirstChild(&quot;HumanoidRootPart&quot;)
 return root
end
local function paused(s)
 return not s.started or s.reading ~= nil or s.menu or s.ended ~= nil
end
local function snapshot(player)
 local s = states[player]
 if not s then return end
 local journal = {}
 for id in pairs(s.journal) do
  local e = Config.Endings[id]
  if e then table.insert(journal, e.title) end
 end
 table.sort(journal)
 remote:FireClient(player, &quot;State&quot;, {
  started = s.started, mode = s.mode, sanity = s.sanity, stamina = s.stamina,
  diary = count(s.diary), records = count(s.records), rooms = count(s.rooms),
  anomalies = count(s.anomalies), hasKey = s.key, journal = journal,
  sandwich = math.max(0, math.ceil(s.sandwichAt - s.time)),
  ended = s.ended, lost = s.ended == &quot;consumed&quot;,
 })
end
local function saveJournal(player, s)
 if not Config.SaveEndingJournal or not s.canSave then return end
 local copy = table.clone(s.journal)
 task.spawn(function()
  local ok, err = pcall(function()
   DataStoreService:GetDataStore(&quot;SpareRoomRobloxEndings_v1&quot;):UpdateAsync(&quot;u&quot; .. player.UserId, function(old)
    local result = {}
    if typeof(old) == &quot;table&quot; then
     for id, yes in pairs(old) do if yes == true and Config.Endings[id] then result[id] = true end end
    end
    for id in pairs(copy) do result[id] = true end
    return result
   end)
  end)
  if not ok then warn(&quot;The Spare Room: ending journal was not saved: &quot; .. tostring(err)) end
 end)
end
local function finish(player, id)
 local s = states[player]
 local ending = Config.Endings[id]
 if not s or s.ended or not ending then return end
 s.ended = id
 s.journal[id] = true
 s.sprint = false
 remote:FireClient(player, &quot;AnomalyEnd&quot;)
 remote:FireClient(player, &quot;Ending&quot;, {id = id, title = ending.title, text = ending.text})
 snapshot(player)
 saveJournal(player, s)
end
local function damage(player, amount)
 local s = states[player]
 if not s or s.ended then return end
 local loss = amount * Config.Modes[s.mode].damage
 s.sanity = math.max(0, s.sanity - loss)
 if loss &gt; 2 then remote:FireClient(player, &quot;SanityHit&quot;, loss) end
 if s.sanity &lt;= 0 then finish(player, &quot;consumed&quot;) end
end
local function tell(player, text)
 remote:FireClient(player, &quot;Caption&quot;, text)
end
local function reset(player, mode)
 local old = states[player]
 states[player] = {
  started = true, mode = mode, sanity = 100, stamina = 100, diary = {}, records = {}, rooms = {},
  anomalies = {}, journal = old and old.journal or {}, canSave = old and old.canSave or false,
  flags = {}, key = false, sandwichAt = 0, time = 0, nextAnomaly = Config.Modes[mode].delay,
  active = nil, menu = false, reading = nil, ended = nil, sprint = false, exhausted = false,
  sequence = old and old.sequence or 0, lastRequest = 0, lastStart = os.clock(),
 }
 holds[player] = {}
 remote:FireClient(player, &quot;AnomalyEnd&quot;)
 if not player.Character or not player.Character:FindFirstChildOfClass(&quot;Humanoid&quot;) or player.Character:FindFirstChildOfClass(&quot;Humanoid&quot;).Health &lt;= 0 then
  player:LoadCharacter()
 end
 local root = position(player)
 if root then player.Character:PivotTo(CFrame.new(0, 4, -11)) end
 snapshot(player)
end
local function valid(player, part)
 local s = states[player]
 local root = position(player)
 if not s or paused(s) or not root or not part:IsDescendantOf(items) then return false end
 if (root.Position - part.Position).Magnitude &gt; 7.5 then return false end
 local params = RaycastParams.new()
 params.FilterType = Enum.RaycastFilterType.Exclude
 params.FilterDescendantsInstances = {player.Character}
 local hit = workspace:Raycast(root.Position, part.Position - root.Position, params)
 return hit == nil or hit.Instance == part
end
local function read(player, part, text, cost)
 local s = states[player]
 s.sequence += 1
 s.reading = {id = s.sequence, part = part, cost = cost}
 s.sprint = false
 remote:FireClient(player, &quot;Read&quot;, {id = s.sequence, title = value(part, &quot;Title&quot;), text = text})
end
local function interact(player, part)
 local s = states[player]
 local role = value(part, &quot;Role&quot;)
 if role == &quot;diary&quot; then
  local n = tonumber(value(part, &quot;Index&quot;))
  if not n or not Config.Diary[n] then return end
  local first = not s.diary[n]
  s.diary[n] = true
  read(player, part, Config.Diary[n], first and (n &gt; 10 and 3 or 1) or 0)
 elseif role == &quot;record&quot; then
  local id = value(part, &quot;Index&quot;)
  local first = not s.records[id]
  s.records[id] = true
  read(player, part, value(part, &quot;Text&quot;), first and 3 or 0)
 elseif role == &quot;mum&quot; then
  s.flags.mum = true
  read(player, part, &quot;“I remember making up the beds,” Mum says. “Please do not give me an answer just because I cannot find one.”&quot;, 0)
 elseif role == &quot;mirror&quot; then
  local first = not s.flags.mirror
  s.flags.mirror = true
  read(player, part, &quot;There are four height marks in the dust on the frame. Your reflection obscures the smallest one. A scratched line says: KEEP BOTH COPIES.&quot;, first and 5 or 0)
 elseif role == &quot;valve&quot; then
  s.flags.valve = true
  tell(player, &quot;The knocking pipe falls quiet. Someone has corrected the maintenance date twice.&quot;)
 elseif role == &quot;anchor&quot; then
  s.flags.anchor = true
  tell(player, &quot;You keep an ordinary memory close. You do not decide who shared it.&quot;)
 elseif role == &quot;key&quot; then
  s.key = true
  tell(player, &quot;You take the unnumbered key. Its label has been corrected by hand.&quot;)
 elseif role == &quot;sandwich&quot; then
  if s.time &lt; s.sandwichAt then
   tell(player, &quot;The next sandwich is ready in &quot; .. math.ceil(s.sandwichAt - s.time) .. &quot; seconds of active play.&quot;)
  else
   s.sanity = math.min(100, s.sanity + Config.Modes[s.mode].sandwich)
   s.sandwichAt = s.time + 120
   tell(player, &quot;You eat the sandwich. The kitchen smells ordinary again.&quot;)
  end
 elseif role == &quot;hatch&quot; or role == &quot;stairs&quot; or role == &quot;exitChamber&quot; then
  local target = role == &quot;hatch&quot; and Vector3.new(0, -14, -12) or role == &quot;stairs&quot; and Vector3.new(0, 4, 17) or Vector3.new(0, -14, 63)
  player.Character:PivotTo(CFrame.new(target))
  remote:FireClient(player, &quot;AnomalyEnd&quot;)
  s.active = nil
  s.nextAnomaly = s.time + 10
 elseif role == &quot;gate&quot; then
  if count(s.diary) &lt; 12 or count(s.records) &lt; 3 or not s.key then
   tell(player, &quot;The chamber needs 12 diary pages, 3 family records and the unnumbered key.&quot;)
  else
   player.Character:PivotTo(CFrame.new(9, -14, 63))
  end
 elseif role == &quot;ending&quot; then
  local id = value(part, &quot;Ending&quot;)
  local e = Config.Endings[id]
  if not e then return end
  local ready = count(s.diary) &gt;= (e.diary or 0) and count(s.records) &gt;= (e.records or 0)
   and count(s.anomalies) &gt;= (e.anomalies or 0) and (not e.anchor or s.flags.anchor)
   and (not e.valve or s.flags.valve) and (not e.mum or s.flags.mum)
   and (not e.sanityMax or s.sanity &lt;= e.sanityMax)
  if ready then
   s.sequence += 1
   s.confirm = {id = id, nonce = s.sequence, part = part}
   remote:FireClient(player, &quot;Confirm&quot;, {id = id, nonce = s.sequence, title = e.title, text = e.text})
   s.menu = true
  else
   tell(player, &quot;Requires diary pages: &quot; .. (e.diary or 0) .. &quot;, records: &quot; .. (e.records or 0) .. &quot;, anomalies: &quot; .. (e.anomalies or 0)
    .. (e.anchor and &quot;; hold the ordinary memory&quot; or &quot;&quot;) .. (e.valve and &quot;; isolate the boiler pipe&quot; or &quot;&quot;)
    .. (e.mum and &quot;; speak with Mum&quot; or &quot;&quot;) .. (e.sanityMax and &quot;; sanity at or below &quot; .. e.sanityMax .. &quot;%&quot; or &quot;&quot;))
  end
 end
 snapshot(player)
end
Lighting.ClockTime = 0
Lighting.Brightness = 1
Lighting.Ambient = Color3.fromRGB(35, 39, 39)
Lighting.OutdoorAmbient = Color3.fromRGB(50, 57, 63)
Lighting.FogColor = Color3.fromRGB(17, 24, 25)
Lighting.FogStart = 65
Lighting.FogEnd = 170
for _, part in ipairs(world:GetDescendants()) do
 if part:IsA(&quot;BasePart&quot;) then
  local material = part:FindFirstChild(&quot;MaterialName&quot;)
  if material and Enum.Material[material.Value] then part.Material = Enum.Material[material.Value] end
  if part.Name == &quot;Lamp&quot; then
   local light = Instance.new(&quot;PointLight&quot;)
   light.Color = Color3.fromRGB(239, 207, 155)
   light.Brightness = part.Position.Y &lt; -5 and 0.65 or 1.1
   light.Range = part.Position.Y &lt; -5 and 17 or 25
   light.Shadows = true
   light.Parent = part
  end
  local sign = part:FindFirstChild(&quot;Sign&quot;)
  if sign then
   local gui = Instance.new(&quot;SurfaceGui&quot;)
   gui.Face = value(part, &quot;Side&quot;) == &quot;Right&quot; and Enum.NormalId.Right or value(part, &quot;Side&quot;) == &quot;Left&quot; and Enum.NormalId.Left or Enum.NormalId.Front
   gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
   gui.PixelsPerStud = 60
   gui.AlwaysOnTop = false
   gui.Parent = part
   local label = Instance.new(&quot;TextLabel&quot;)
   label.Size = UDim2.fromScale(1, 1)
   label.BackgroundTransparency = 1
   label.TextColor3 = Color3.fromRGB(232, 218, 181)
   label.Font = Enum.Font.Gotham
   label.TextScaled = true
   label.TextWrapped = true
   label.Text = sign.Value
   label.Parent = gui
  end
 end
end
for _, part in ipairs(items:GetChildren()) do
 if part:IsA(&quot;BasePart&quot;) then
  local prompt = Instance.new(&quot;ProximityPrompt&quot;)
  prompt.ActionText = value(part, &quot;Action&quot;)
  prompt.ObjectText = value(part, &quot;Title&quot;)
  prompt.KeyboardKeyCode = Enum.KeyCode.E
  prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
  prompt.MaxActivationDistance = 6
  prompt.RequiresLineOfSight = true
  prompt.HoldDuration = 0.8
  prompt.ClickablePrompt = true
  prompt.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
  prompt.Parent = part
  prompts[part] = prompt
  prompt.PromptButtonHoldBegan:Connect(function(player)
   if valid(player, part) then
    holds[player] = holds[player] or {}
    holds[player][part] = os.clock()
   end
  end)
  prompt.Triggered:Connect(function(player)
   local start = holds[player] and holds[player][part]
   if not start or os.clock() - start &lt; 0.65 or os.clock() - start &gt; 8 then return end
   holds[player][part] = nil
   if prompt.Enabled and valid(player, part) then interact(player, part) end
  end)
 end
end
local function joined(player)
 states[player] = {
  started = false, mode = &quot;Easy&quot;, sanity = 100, stamina = 100, diary = {}, records = {}, rooms = {},
  anomalies = {}, journal = {}, flags = {}, time = 0, sandwichAt = 0, sequence = 0, nextAnomaly = 45, lastRequest = 0,
 }
 holds[player] = {}
 if Config.SaveEndingJournal then
  task.spawn(function()
   local ok, saved = pcall(function() return DataStoreService:GetDataStore(&quot;SpareRoomRobloxEndings_v1&quot;):GetAsync(&quot;u&quot; .. player.UserId) end)
   local s = states[player]
   if not s then return end
   s.canSave = ok
   if ok and typeof(saved) == &quot;table&quot; then for id, yes in pairs(saved) do if yes == true and Config.Endings[id] then s.journal[id] = true end end end
   snapshot(player)
  end)
 end
 player.CharacterAdded:Connect(function(character)
  local humanoid = character:WaitForChild(&quot;Humanoid&quot;)
  humanoid.UseJumpPower = true
  humanoid.JumpPower = 45
  task.wait(0.1)
  if character.Parent then character:PivotTo(CFrame.new(0, 4, -11)) end
 end)
end
Players.PlayerAdded:Connect(joined)
for _, player in ipairs(Players:GetPlayers()) do joined(player) end
Players.PlayerRemoving:Connect(function(player)
 local s = states[player]
 if s then saveJournal(player, s) end
 states[player] = nil
 holds[player] = nil
end)
game:BindToClose(function()
 if not Config.SaveEndingJournal then return end
 for player, s in pairs(states) do
  if s.canSave then
   pcall(function()
    DataStoreService:GetDataStore(&quot;SpareRoomRobloxEndings_v1&quot;):UpdateAsync(&quot;u&quot; .. player.UserId, function(old)
     local result = typeof(old) == &quot;table&quot; and old or {}
     for id in pairs(s.journal) do result[id] = true end
     return result
    end)
   end)
  end
 end
end)
remote.OnServerEvent:Connect(function(player, action, data)
 local s = states[player]
 if not s or typeof(action) ~= &quot;string&quot; then return end
 local now = os.clock()
 if action == &quot;Ready&quot; then snapshot(player) return end
 if action == &quot;Sprint&quot; then s.sprint = data == true return end
 if action == &quot;Start&quot; then
  if now - (s.lastStart or -10) &lt; 2 then return end
  s.lastStart = now
 end
 if action == &quot;Start&quot; then
  if typeof(data) == &quot;string&quot; and Config.Modes[data] then reset(player, data) end
 elseif action == &quot;ReadClosed&quot; then
  if s.reading and data == s.reading.id then
   local cost = s.reading.cost
   s.reading = nil
   damage(player, cost)
   snapshot(player)
  end
 elseif action == &quot;Pause&quot; then
  if s.started and not s.ended and not s.reading then s.menu = data == true end
 elseif action == &quot;Finish&quot; then
  local c = s.confirm
  if c and data == c.nonce then
   s.menu = false
   s.confirm = nil
   local root = position(player)
   if root and (root.Position - c.part.Position).Magnitude &lt; 8 then finish(player, c.id) end
  end
 elseif action == &quot;CancelEnding&quot; then s.confirm = nil s.menu = false end
end)
local function eventPoint(player)
 local root = position(player)
 if not root then return nil end
 local params = RaycastParams.new()
 params.FilterType = Enum.RaycastFilterType.Exclude
 params.FilterDescendantsInstances = {player.Character}
 for _, offset in ipairs({Vector3.new(4, 0, 0), Vector3.new(-4, 0, 0), Vector3.new(0, 0, 4), Vector3.new(0, 0, -4)}) do
  if not workspace:Raycast(root.Position, offset, params) then
   local down = workspace:Raycast(root.Position + offset, Vector3.new(0, -8, 0), params)
   if down then
    local point = down.Position + Vector3.new(0, 0.05, 0)
    local overlap = OverlapParams.new()
    overlap.FilterType = Enum.RaycastFilterType.Exclude
    overlap.FilterDescendantsInstances = {player.Character}
    local clear = true
    for _, part in ipairs(workspace:GetPartBoundsInBox(CFrame.new(point + Vector3.new(0, 2, 0)), Vector3.new(4, 4, 5), overlap)) do
     if part.CanCollide then clear = false break end
    end
    if clear then return point end
   end
  end
 end
 return nil
end
local accumulator = 0
RunService.Heartbeat:Connect(function(dt)
 accumulator += dt
 for player, s in pairs(states) do
  local root = position(player)
  local humanoid = player.Character and player.Character:FindFirstChildOfClass(&quot;Humanoid&quot;)
  if humanoid then
   local locked = paused(s)
   local moving = root and Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude &gt; 1
   if not locked then
    if s.stamina &gt;= 25 then s.exhausted = false end
    local sprinting = s.sprint and not s.exhausted and moving
    s.stamina = math.clamp(s.stamina + (sprinting and -26 or 18) * dt, 0, 100)
    if s.stamina == 0 then s.exhausted = true end
    humanoid.WalkSpeed = sprinting and 20 or 12
   else humanoid.WalkSpeed = 0 end
   humanoid.JumpPower = locked and 0 or 45
  end
  if not paused(s) then
   s.time += dt
   local mode = Config.Modes[s.mode]
   s.sanity = math.max(0, s.sanity - mode.drain * dt)
   if s.sanity &lt;= 0 then finish(player, &quot;consumed&quot;) end
   if root and root.Position.Y &lt; -6 then
    local row = math.floor((root.Position.Z + 18) / 18)
    if row &gt;= 0 and row &lt; 5 and math.abs(root.Position.X) &gt; 4 and math.abs(root.Position.X) &lt; 28 then
     s.rooms[row * 2 + (root.Position.X &gt; 0 and 2 or 1)] = true
    end
    if not s.active and s.time &gt;= s.nextAnomaly then
     local point = eventPoint(player)
     if point then
      s.sequence += 1
      local a = Config.Anomalies[(s.sequence % #Config.Anomalies) + 1]
      s.active = {elapsed = 0}
      s.anomalies[a.id] = true
      remote:FireClient(player, &quot;Anomaly&quot;, {id = a.id, title = a.title, text = a.text, position = point})
      damage(player, 2.5)
     else s.nextAnomaly = s.time + 8 end
    end
   end
   if s.active then
    s.active.elapsed += dt
    if not root or root.Position.Y &gt; -6 or s.active.elapsed &gt;= 12 then
     s.active = nil
     s.nextAnomaly = s.time + mode.delay
     remote:FireClient(player, &quot;AnomalyEnd&quot;)
    end
   end
  end
  if accumulator &gt;= 0.5 then snapshot(player) end
 end
 if accumulator &gt;= 0.5 then accumulator = 0 end
end)
