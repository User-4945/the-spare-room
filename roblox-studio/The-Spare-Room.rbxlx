text(title, &quot;BENEATH THE HOUSE\nThere was always something underneath.\n\nRoblox Studio starter · six ending paths&quot;, UDim2.fromScale(0.1, 0.27), UDim2.fromScale(0.8, 0.2), 19)
for i, mode in ipairs({&quot;Easy&quot;, &quot;Intermediate&quot;, &quot;Hard&quot;}) do
