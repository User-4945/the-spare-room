="Value">Descend beneath the house</string></Properties></Item></Item><Item class="Part" referent="RBX647"><Properties><string name="Name">StudyNote</string><CoordinateFrame name="CFrame"><X>-17.5</X><Y>15.4</Y><Z>-7</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1.1</X><Y>0.12</Y><Z>0.85</Z></Vector3><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">true</bool><float name="Transparency">0</float><token name="Material">512</token><Color3uint8 name="Color3uint8">13483670</Color3uint8><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties><Item class="StringValue" referent="RBX640"><Properties><string name="Name">MaterialName</string><string name="Value">Wood</string></Properties></Item><Item class="StringValue" referent="RBX641"><Properties><string name="Name">Role</string><string name="Value">story</string></Properties></Item><Item class="StringValue" referent="RBX642"><Properties><string name="Name">Title</string><string name="Value">THE HOUSE WAS DRAWN</string></Properties></Item><Item class="StringValue" referent="RBX643"><Properties><string name="Name">Action</string><string name="Value">Read study note</string></Properties></Item><Item class="StringValue" referent="RBX644"><Properties><string name="Name">Flag</string><string name="Value">note_study</string></Properties></Item><Item class="StringValue" referent="RBX645"><Properties><string name="Name">Text</string><string name="Value">The blueprint is under the study lamp. Erase the spare room, not the house. One line is holding us here.</string></Properties></Item><Item class="StringValue" referent="RBX646"><Properties><string name="Name">Cost</string><string name="Value">2</string></Properties></Item></Item><Item class="Part" referent="RBX655"><Properties><string name="Name">Blueprint</string><Coordinate