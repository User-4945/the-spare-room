local function openMap()
 if blocked() then return end
 modalReason=&quot;map&quot;
 heading.Text=&quot;ASHFIELD / DISTRICT GUIDE&quot;
 local root=player.Character and player.Character:FindFirstChild(&quot;HumanoidRootPart&quot;)
 local location=root and root.Position.Y &lt; -6 and &quot;Beneath the house&quot; or root and root.Position.Y&gt;12 and &quot;Upstairs&quot; or &quot;House and district&quot;
 body.Text=&quot;YOU ARE: &quot;..location..&quot;\n\nLeave through the house's front entrance. Follow the path to the road.\n\nACROSS THE ROAD — west to east\nThe Palladium cinema · Municipal Archive · St. Agnes Clinic · Ashfield Station · Ward &amp; Sons · Velvet &amp; Ash\n\nON THE HOUSE SIDE\nThe Second Copy bookshop to the west. The Empty Chair cafe to the east.\n\nNEW PLACES\nAshfield Memorial Park is southwest of the house. Ashfield Primary School is southeast. Follow the side footpaths from the pavement and read the memorial, drawings and school records.\n\nAT HOME\nClimb the hall staircase to the study, nursery, loft and family bedroom. Look for hidden notes and unfinished tasks. The garden is behind the house. The maintenance hatch at the end of the hallway leads below. Use the return stairs to come home.\n\nPlaces change what you notice. Read the correspondence in every venue. Follow the north boulevard through the boundary opening to explore all 20 original city destinations.&quot;
 closeButton.Text=&quot;Fold the map&quot;
 chooseButton.Visible=false
 modal.Visible=true
 remote:FireServer(&quot;Pause&quot;,true)
end
