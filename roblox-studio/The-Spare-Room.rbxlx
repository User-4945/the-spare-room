string></Properties></Item><Item class="StringValue" referent="RBX736"><Properties><string name="Name">Title</string><string name="Value">The stopped clock</string></Properties></Item><Item class="StringValue" referent="RBX737"><Properties><string name="Name">Action</string><string name="Value">Wind the nursery clock</string></Properties></Item><Item class="StringValue" referent="RBX738"><Properties><string name="Name">Flag</string><string name="Value">clock</string></Properties></Item><Item class="StringValue" referent="RBX739"><Properties><string name="Name">Text</string><string name="Value">The spring resists, then catches. Tick. Tick. You remember a line of the lullaby that Mum has never sung.</string></Properties></Item><Item class="StringValue" referent="RBX740"><Properties><string name="Name">Cost</string><string name="Value">3</string></Properties></Item></Item><Item class="Part" referent="RBX747"><Properties><string name="Name">LullabyEnding</string><CoordinateFrame name="CFrame"><X>13</X><Y>15</Y><Z>-9.5</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1</X><Y>0.2</Y><Z>0.8</Z></Vector3><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">true</bool><float name="Transparency">0</float><token name="Material">512</token><Color3uint8 name="Color3uint8">13483670</Color3uint8><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties><Item class="StringValue" referent="RBX742"><Properties><string name="Name">MaterialName</string><string name="Value">Wood</string></Properties></Item><Item class="StringValue" referent="RBX743"><Properties><string name="Name">Role</string><string name="Value">ending</string></Properties></Item><Item class="StringValue" referent="RBX744"><Properties><string name="Name">Title</string><string name="Value">An unfinished lullaby</string><