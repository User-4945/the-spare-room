 local location=root and root.Position.Y &lt; -6 and &quot;Beneath the house&quot; or &quot;House and district&quot;
 body.Text=&quot;YOU ARE: &quot;..location..&quot;\n\nLeave through the house's front entrance. Follow the path to the road.\n\nACROSS THE ROAD — west to east\nThe Palladium cinema · Municipal Archive · St. Agnes Clinic · Ashfield Station · Ward &amp; Sons · Velvet &amp; Ash\n\nON THE HOUSE SIDE\nThe Second Copy bookshop to the west. The Empty Chair cafe to the east.\n\nAT HOME\nThe garden is behind the house. The maintenance hatch at the end of the hallway leads below. Use the return stairs to come home.\n\nPlaces change what you notice. Read the correspondence in every venue.&quot;
 closeButton.Text=&quot;Fold the map&quot;
 chooseButton.Visible=false
 modal.Visible=true
 remote:FireServer(&quot;Pause&quot;,true)
end
