="Value">CLINIC: The household account still lists four names. A clerk has written: do not correct the original. The delivery address has no room number.</string></Properties></Item></Item><Item class="Part" referent="RBX2082"><Properties><string name="Name">DistrictRecordRAILWAY</string><CoordinateFrame name="CFrame"><X>24</X><Y>3.5</Y><Z>-76</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1.3</X><Y>0.12</Y><Z>0.9</Z></Vector3><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">true</bool><float name="Transparency">0</float><token name="Material">512</token><Color3uint8 name="Color3uint8">13483670</Color3uint8><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties><Item class="StringValue" referent="RBX2076"><Properties><string name="Name">MaterialName</string><string name="Value">Wood</string></Properties></Item><Item class="StringValue" referent="RBX2077"><Properties><string name="Name">Role</string><string name="Value">record</string></Properties></Item><Item class="StringValue" referent="RBX2078"><Properties><string name="Name">Title</string><string name="Value">ASHFIELD STATION · correspondence</string></Properties></Item><Item class="StringValue" referent="RBX2079"><Properties><string name="Name">Action</string><string name="Value">Read correspondence</string></Properties></Item><Item class="StringValue" referent="RBX2080"><Properties><string name="Name">Index</string><string name="Value">RAILWAY</string></Properties></Item><Item class="StringValue" referent="RBX2081"><Properties><string name="Name">Text</string><string name="Value">RAILWAY: The household account still lists four names. A clerk has written: do not correct the original. The delivery address has no room number.</string></Properties></Item></Item><Item class="Part" referent="RBX2222"><Properties><string name="Name">DistrictRecordWORKSHOP</string><CoordinateFrame name="CFrame"><X>64</X><Y>3.5</Y><Z>-76</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1.3</X><Y>0.12</Y><Z>0.9</Z></Vector3><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">true</bool><float name="Transparency">0</float><token name="Material">512</token><Color3uint8 name="Color3uint8">13483670</Color3uint8><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties><Item class="StringValue" referent="RBX2216"><Properties><string name="Name">MaterialName</string><string name="Value">Wood</string></Properties></Item><Item class="StringValue" referent="RBX2217"><Properties><string name="Name">Role</string><string name="Value">record</string></Properties></Item><Item class="StringValue" referent="RBX2218"><Properties><string name="Name">Title</string><string name="Value">WARD &amp; SONS · correspondence</string></Properties></Item><Item class="StringValue" referent="RBX2219"><Properties><string name="Name">Action</string><string name="Value">Read correspondence</string></Properties></Item><Item class="StringValue" referent="RBX2220"><Properties><string name="Name">Index</string><string name="Value">WORKSHOP</string></Properties></Item><Item class="StringValue" referent="RBX2221"><Properties><string name="Name">Text</string><string name="Value">WORKSHOP: The household account still lists four names. A clerk has written: do not correct the original. The delivery address has no room number.</string></Properties></Item></Item><Item class="Part" referent="RBX2358"><Properties><string name="Name">DistrictRecordCOSTUME SHOP</string><CoordinateFrame name="CFrame"><X>104</X><Y>3.5</Y><Z>-76</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1.3</X><Y>0.12</Y><Z>0.9</Z></Vector3><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">true</bool><float name="Transparency">0</float><token name="Material">512</token><Color3uint8 name="Color3uint8">13483670</Color3uint8><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties><Item class="StringValue" referent="RBX2352"><Properties><string name="Name">MaterialName</string><string name="Value">Wood</string></Properties></Item><Item class="StringValue" referent="RBX2353"><Properties><string name="Name">Role</string><string name="Value">record</string></Properties></Item><Item class="StringValue" referent="RBX2354"><Properties><string name="Name">Title</string><string name="Value">VELVET &amp; ASH · correspondence</string></Properties></Item><Item class="StringValue" referent="RBX2355"><Properties><string name="Name">Action</string><string name="Value">Read correspondence</string></Properties></Item><Item class="StringValue" referent="RBX2356"><Properties><string name="Name">Index</string><string name="Value">COSTUME SHOP</string></Properties></Item><Item class="StringValue" referent="RBX2357"><Properties><string name="Name">Text</string><string name="Value">COSTUME SHOP: The household account still lists four names. A clerk has written: do not correct the original. The delivery address has no room number.</string></Properties></Item></Item><Item class="Part" referent="RBX2494"><Properties><string name="Name">DistrictRecordBOOKSHOP</string><CoordinateFrame name="CFrame"><X>-76</X><Y>3.5</Y><Z>-8</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1.3</X><Y>0.12</Y><Z>0.9</Z></Vector3><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">true</bool><float name="Transparency">0</float><token name="Material">512</token><Color3uint8 name="Color3uint8">13483670</Color3uint8><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties><Item class="StringValue" referent="RBX2488"><Properties><string name="Name">MaterialName</string><string name="Value">Wood</string></Properties></Item><Item class="StringValue" referent="RBX2489"><Properties><string name="Name">Role</string><string name="Value">record</string></Properties></Item><Item class="StringValue" referent="RBX2490"><Properties><string name="Name">Title</string><string name="Value">THE SECOND COPY · correspondence</string></Properties></Item><Item class="StringValue" referent="RBX2491"><Properties><string name="Name">Action</string><string name="Value">Read correspondence</string></Properties></Item><Item class="StringValue" referent="RBX2492"><Properties><string name="Name">Index</string><string name="Value">BOOKSHOP</string></Properties></Item><Item class="StringValue" referent="RBX2493"><Properties><string name="Name">Text</string><string name="Value">BOOKSHOP: The household account still lists four names. A clerk has written: do not correct the original. The delivery address has no room number.</string></Properties></Item></Item><Item class="Part" referent="RBX2630"><Properties><string name="Name">DistrictRecordCAFE</string><CoordinateFrame name="CFrame"><X>76</X><Y>3.5</Y><Z>-8</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1.3</X><Y>0.12</Y><Z>0.9</Z></Vector3><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">true</bool><float name="Transparency">0</float><token name="Material">512</token><Color3uint8 name="Color3uint8">13483670</Color3uint8><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties><Item class="StringValue" referent="RBX2624"><Properties><string name="Name">MaterialName</string><string name="Value">Wood</string></Properties></Item><Item class="StringValue" referent="RBX2625"><Properties><string name="Name">Role</string><string name="Value">record</string></Properties></Item><Item class="StringValue" referent="RBX2626"><Properties><string name="Name">Title</string><string name="Value">THE EMPTY CHAIR · correspondence</string></Properties></Item><Item class="StringValue" referent="RBX2627"><Properties><string name="Name">Action</string><string name="Value">Read correspondence</string></Properties></Item><Item class="StringValue" referent="RBX2628"><Properties><string name="Name">Index</string><string name="Value">CAFE</string></Properties></Item><Item class="StringValue" referent="RBX2629"><Properties><string name="Name">Text</string><string name="Value">CAFE: The household account still lists four names. A clerk has written: do not correct the original. The delivery address has no room number.</string></Properties></Item></Item></Item></Item></Item><Item class="ReplicatedStorage" referent="RBX2804"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="ModuleScript" referent="RBX2803"><Properties><string name="Name">SpareRoomConfig</string><ProtectedString name="Source">-- The Spare Room: Roblox Studio starter. All positions use Roblox studs.
return {
 Version = &quot;Roblox prototype 0.3&quot;,
 SaveEndingJournal = false, -- Enable only after publishing and configuring DataStore access.
 Modes = {
  Easy = {drain = 0.025, damage = 0.75, sandwich = 15, delay = 45},
  Intermediate = {drain = 0.045, damage = 1, sandwich = 12, delay = 34},
  Hard = {drain = 0.07, damage = 1.25, sandwich = 10, delay = 25},
 },
 Diary = {
  &quot;Mum put four plates out. I counted them because I was learning fours. She said I was getting good at numbers.&quot;,
  &quot;Dad fixed the kitchen chair. He told us not to stand on it while the glue was drying. We all promised separately.&quot;,
  &quot;We measured our heights beside the little beds. My line was crooked. Someone drew a sun over it.&quot;,
  &quot;The spare room is for visitors. I asked why our coats were in its cupboard. Mum said cupboards do not belong to rooms.&quot;,
  &quot;We played a game where nobody could say their own name. Dad forgot the rules halfway through and looked frightened.&quot;,
  &quot;There was knocking after tea. It copied the number of people at the table. I did not tell anyone I counted five.&quot;,
  &quot;Mum and Dad argued about which photograph to keep. Both photographs looked ordinary until they were beside each other.&quot;,
  &quot;My school report has the wrong first name. The teacher says it is the name she has always used.&quot;,
  &quot;Someone moved my bed. The marks in the carpet say it has never been anywhere else.&quot;,
  &quot;Dad wrote a list of everything in the house. He left spaces between the names. Mum folded the spaces out.&quot;,
  &quot;The boiler answers if I tap three times. It waits until the house is quiet before adding a fourth.&quot;,
  &quot;My sibling says we never had a red bicycle. There is a photograph of us carrying it together.&quot;,
  &quot;Mum remembered an extra lunchbox this morning. By the time she found the lid, she could not remember why.&quot;,
  &quot;There is a room number on the maintenance sheet that does not appear on the plan. Its inspection is signed.&quot;,
  &quot;Dad's coat was warm when I found it. Mum says the man in the photograph is a visitor. She cannot say when he visited.&quot;,
  &quot;I can remember two people teaching me the same song. The words disagree. Both voices sound like home.&quot;,
  &quot;The little bed has my handwriting underneath. I have grown too tall to reach it without lying on the floor.&quot;,
  &quot;I asked how many children lived here. Mum said that was a cruel question. Later she asked me the same thing.&quot;,
  &quot;I am keeping both copies. If one of them disappears, please do not decide that the other one was always right.&quot;,
  &quot;I left the last page unfinished. There should be somewhere for tomorrow to go. You do not have to give us faces.&quot;,
 },
 Anomalies = {
  {id = &quot;pages&quot;, title = &quot;The Unfinished Sentence&quot;, text = &quot;Loose pages circle an empty space. Every line ends before the same name.&quot;},
  {id = &quot;door&quot;, title = &quot;A Room Short&quot;, text = &quot;A door stands without a wall. Someone has polished the handle from the other side.&quot;},
  {id = &quot;family&quot;, title = &quot;The Family Arrangement&quot;, text = &quot;Four silhouettes wait together. The smallest space keeps changing sides.&quot;},
  {id = &quot;blocks&quot;, title = &quot;Spelling Practice&quot;, text = &quot;Children's blocks arrange themselves. There are too few letters for the name you remember.&quot;},
  {id = &quot;plates&quot;, title = &quot;Places Reserved&quot;, text = &quot;Four plates rise where no table stands. A fifth place is almost visible.&quot;},
  {id = &quot;lamp&quot;, title = &quot;The Answering Light&quot;, text = &quot;A lamp answers in groups of three. The last answer always has an extra pulse.&quot;},
  {id = &quot;coat&quot;, title = &quot;Small Shoulders&quot;, text = &quot;A child's coat rises as though someone is inside it. Then it hangs empty.&quot;},
  {id = &quot;steps&quot;, title = &quot;One Step More&quot;, text = &quot;Footprints continue after the person making them should have stopped.&quot;},
  {id = &quot;clock&quot;, title = &quot;The Uncounted Minute&quot;, text = &quot;The clock moves backwards. The house keeps its own time.&quot;},
  {id = &quot;chair&quot;, title = &quot;One More Place&quot;, text = &quot;There is an extra chair. Its legs are free of dust.&quot;},
 },
 Endings = {
  morning = {title = &quot;An Ordinary Morning&quot;, text = &quot;You keep one ordinary memory without deciding whose it was. Mum puts the kettle on.&quot;, diary = 2, anchor = true},
  names = {title = &quot;Names Without Faces&quot;, text = &quot;You preserve both records. Neither is declared a mistake. There is room for an answer later.&quot;, diary = 6, records = 2},
  seal = {title = &quot;Maintained in Absence&quot;, text = &quot;You renew the inspection seal. The earlier signatures remain beneath yours.&quot;, diary = 10, valve = true},
  tomorrow = {title = &quot;Somewhere for Tomorrow&quot;, text = &quot;You leave the final page unfinished. The house remembers a larger family, but offers no explanation.&quot;, diary = 20, records = 3, mum = true},
  glass = {title = &quot;The Far Side of the Glass&quot;, text = &quot;You cover the observation pane. The reflection continues arranging places on the other side.&quot;, anomalies = 3, sanityMax = 45},
  consumed = {title = &quot;YOUR SANITY GOT CONSUMED&quot;, text = &quot;The house keeps the memory you could no longer hold.&quot;},
 },
 Rooms = {&quot;Storage Room&quot;, &quot;Boiler Room&quot;, &quot;Maintenance Tunnel&quot;, &quot;Archive Room&quot;, &quot;Forgotten Family Room&quot;, &quot;Hidden Study&quot;, &quot;Sealed Corridor&quot;, &quot;Observation Room&quot;, &quot;Former Children's Area&quot;, &quot;Locked Chamber&quot;},
}

</ProtectedString></Properties></Item></Item><Item class="ServerScriptService" referent="RBX2806"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX2805"><Properties><string name="Name">SpareRoomServer</string><ProtectedString name="Source">-- ServerScriptService/SpareRoomServer
local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local Lighting = game:GetService(&quot;Lighting&quot;)
local DataStoreService = game:GetService(&quot;DataStoreService&quot;)
local Config = require(ReplicatedStorage:WaitForChild(&quot;SpareRoomConfig&quot;))
local world = workspace:WaitForChild(&quot;SpareRoomWorld&quot;)
local items = world:WaitForChild(&quot;Interactables&quot;)
local remote = Instance.new(&quot;RemoteEvent&quot;)
remote.Name = &quot;SpareRoomEvent&quot;
remote.Parent = ReplicatedStorage
-- Keep this allowlist server-side. Never put passwords in a Roblox place.
local ADMIN_USER_IDS = {} -- Example: [123456789] = true
local function isAdmin(player)
 return RunService:IsStudio() or ADMIN_USER_IDS[player.UserId] == true
  or (game.CreatorType == Enum.CreatorType.User and game.CreatorId == player.UserId)
end
local destinations = {
 House = Vector3.new(0,4,-11), Garden = Vector3.new(0,4,35), Basement = Vector3.new(0,-14,-12),
 Cinema = Vector3.new(-96,4,-79), Archive = Vector3.new(-56,4,-79), Clinic = Vector3.new(-16,4,-79),
 Station = Vector3.new(24,4,-79), Workshop = Vector3.new(64,4,-79), Costumes = Vector3.new(104,4,-79),
 Bookshop = Vector3.new(-76,4,-11), Cafe = Vector3.new(76,4,-11),
}
local states = {}
local prompts = {}
local function value(part, name)
 local v = part:FindFirstChild(name)
 return v and v.Value or &quot;&quot;
end
local function count(set)
 local n = 0
 for _ in pairs(set) do n += 1 end
 return n
end
local function position(player)
 local character = player.Character
 local root = character and character:FindFirstChild(&quot;HumanoidRootPart&quot;)
 return root
end
local function paused(s)
 return not s.started or s.reading ~= nil or s.menu or s.ended ~= nil
end
local function snapshot(player)
 local s = states[player]
 if not s then return end
 local observed = {}
 for _, a in ipairs(Config.Anomalies) do
  if s.anomalies[a.id] then table.insert(observed, a.title .. &quot; — &quot; .. a.text) end
 end
 local journal = {}
 for id in pairs(s.journal) do
  local e = Config.Endings[id]
  if e then table.insert(journal, e.title) end
 end
 table.sort(journal)
 remote:FireClient(player, &quot;State&quot;, {
  observed = observed, admin = isAdmin(player), flying = s.flying == true, day = s.day or 1, started = s.started, mode = s.mode, sanity = s.sanity, stamina = s.stamina,
  diary = count(s.diary), records = count(s.records), rooms = count(s.rooms),
  anomalies = count(s.anomalies), hasKey = s.key, journal = journal,
  sandwich = math.max(0, math.ceil(s.sandwichAt - s.time)),
  ended = s.ended, lost = s.ended == &quot;consumed&quot;,
 })
end
local function saveJournal(player, s)
 if not Config.SaveEndingJournal or not s.canSave then return end
 local copy = table.clone(s.journal)
 task.spawn(function()
  local ok, err = pcall(function()
   DataStoreService:GetDataStore(&quot;SpareRoomRobloxEndings_v1&quot;):UpdateAsync(&quot;u&quot; .. player.UserId, function(old)
    local result = {}
    if typeof(old) == &quot;table&quot; then
     for id, yes in pairs(old) do if yes == true and Config.Endings[id] then result[id] = true end end
    end
    for id in pairs(copy) do result[id] = true end
    return result
   end)
  end)
  if not ok then warn(&quot;The Spare Room: ending journal was not saved: &quot; .. tostring(err)) end
 end)
end
local function finish(player, id)
 local s = states[player]
 local ending = Config.Endings[id]
 if not s or s.ended or not ending then return end
 s.ended = id
 s.journal[id] = true
 s.sprint = false
 remote:FireClient(player, &quot;AnomalyEnd&quot;)
 remote:FireClient(player, &quot;Ending&quot;, {id = id, title = ending.title, text = ending.text})
 snapshot(player)
 saveJournal(player, s)
end
local function damage(player, amount)
 local s = states[player]
 if not s or s.ended then return end
 local loss = amount * Config.Modes[s.mode].damage
 s.sanity = math.max(0, s.sanity - loss)
 if loss &gt; 2 then remote:FireClient(player, &quot;SanityHit&quot;, loss) end
 if s.sanity &lt;= 0 then finish(player, &quot;consumed&quot;) end
end
local function tell(player, text)
 remote:FireClient(player, &quot;Caption&quot;, text)
end
local function reset(player, mode)
 local old = states[player]
 states[player] = {
  started = true, mode = mode, sanity = 100, stamina = 100, diary = {}, records = {}, rooms = {},
  anomalies = {}, journal = old and old.journal or {}, canSave = old and old.canSave or false,
  flags = {}, key = false, sandwichAt = 0, time = 0, nextAnomaly = Config.Modes[mode].delay,
  active = nil, menu = false, reading = nil, ended = nil, sprint = false, exhausted = false,
  day = 1, flying = false, sequence = old and old.sequence or 0, lastRequest = 0, lastStart = os.clock(),
 }
 remote:FireClient(player, &quot;AnomalyEnd&quot;)
 if not player.Character or not player.Character:FindFirstChildOfClass(&quot;Humanoid&quot;) or player.Character:FindFirstChildOfClass(&quot;Humanoid&quot;).Health &lt;= 0 then
  player:LoadCharacter()
 end
 local root = position(player)
 if root then player.Character:PivotTo(CFrame.new(0, 4, -11)) end
 snapshot(player)
end
local function valid(player, part)
 local s = states[player]
 local root = position(player)
 if not s or paused(s) or not root or not part:IsDescendantOf(items) then return false end
 if (root.Position - part.Position).Magnitude &gt; 7.5 then return false end
 local params = RaycastParams.new()
 params.FilterType = Enum.RaycastFilterType.Exclude
 params.FilterDescendantsInstances = {player.Character}
 local head = player.Character and player.Character:FindFirstChild(&quot;Head&quot;)
 local origin = head and head.Position or root.Position
 local hit = workspace:Raycast(origin, part.Position - origin, params)
 return hit == nil or hit.Instance == part
end
local function read(player, part, text, cost)
 local s = states[player]
 s.sequence += 1
 s.reading = {id = s.sequence, part = part, cost = cost}
 s.sprint = false
 remote:FireClient(player, &quot;Read&quot;, {id = s.sequence, title = value(part, &quot;Title&quot;), text = text})
end
local function interact(player, part)
 local s = states[player]
 local role = value(part, &quot;Role&quot;)
 if role == &quot;diary&quot; then
  local n = tonumber(value(part, &quot;Index&quot;))
  if not n or not Config.Diary[n] then return end
  local first = not s.diary[n]
  s.diary[n] = true
  read(player, part, Config.Diary[n], first and (n &gt; 10 and 3 or 1) or 0)
 elseif role == &quot;record&quot; then
  local id = value(part, &quot;Index&quot;)
  local first = not s.records[id]
  s.records[id] = true
  read(player, part, value(part, &quot;Text&quot;), first and 3 or 0)
 elseif role == &quot;mum&quot; then
  s.flags.mum = true
  read(player, part, &quot;“I remember making up the beds,” Mum says. “Please do not give me an answer just because I cannot find one.”&quot;, 0)
 elseif role == &quot;mirror&quot; then
  local first = not s.flags.mirror
  s.flags.mirror = true
  read(player, part, &quot;There are four height marks in the dust on the frame. Your reflection obscures the smallest one. A scratched line says: KEEP BOTH COPIES.&quot;, first and 5 or 0)
 elseif role == &quot;valve&quot; then
  s.flags.valve = true
  tell(player, &quot;The knocking pipe falls quiet. Someone has corrected the maintenance date twice.&quot;)
 elseif role == &quot;anchor&quot; then
  s.flags.anchor = true
  tell(player, &quot;You keep an ordinary memory close. You do not decide who shared it.&quot;)
 elseif role == &quot;key&quot; then
  s.key = true
  tell(player, &quot;You take the unnumbered key. Its label has been corrected by hand.&quot;)
 elseif role == &quot;sandwich&quot; then
  if s.time &lt; s.sandwichAt then
   tell(player, &quot;The next sandwich is ready in &quot; .. math.ceil(s.sandwichAt - s.time) .. &quot; seconds of active play.&quot;)
  else
   s.sanity = math.min(100, s.sanity + Config.Modes[s.mode].sandwich)
   s.sandwichAt = s.time + 120
   tell(player, &quot;You eat the sandwich. The kitchen smells ordinary again.&quot;)
  end
 elseif role == &quot;hatch&quot; or role == &quot;stairs&quot; or role == &quot;exitChamber&quot; then
  local target = role == &quot;hatch&quot; and Vector3.new(0, -14, -12) or role == &quot;stairs&quot; and Vector3.new(0, 4, 17) or Vector3.new(0, -14, 63)
  player.Character:PivotTo(CFrame.new(target))
  remote:FireClient(player, &quot;AnomalyEnd&quot;)
  s.active = nil
  s.nextAnomaly = s.time + 10
 elseif role == &quot;gate&quot; then
  if count(s.diary) &lt; 12 or count(s.records) &lt; 3 or not s.key then
   tell(player, &quot;The chamber needs 12 diary pages, 3 family records and the unnumbered key.&quot;)
  else
   player.Character:PivotTo(CFrame.new(9, -14, 63))
  end
 elseif role == &quot;ending&quot; then
  local id = value(part, &quot;Ending&quot;)
  local e = Config.Endings[id]
  if not e then return end
  local ready = count(s.diary) &gt;= (e.diary or 0) and count(s.records) &gt;= (e.records or 0)
   and count(s.anomalies) &gt;= (e.anomalies or 0) and (not e.anchor or s.flags.anchor)
   and (not e.valve or s.flags.valve) and (not e.mum or s.flags.mum)
   and (not e.sanityMax or s.sanity &lt;= e.sanityMax)
  if ready then
   s.sequence += 1
   s.confirm = {id = id, nonce = s.sequence, part = part}
   remote:FireClient(player, &quot;Confirm&quot;, {id = id, nonce = s.sequence, title = e.title, text = e.text})
   s.menu = true
  else
   tell(player, &quot;Requires diary pages: &quot; .. (e.diary or 0) .. &quot;, records: &quot; .. (e.records or 0) .. &quot;, anomalies: &quot; .. (e.anomalies or 0)
    .. (e.anchor and &quot;; hold the ordinary memory&quot; or &quot;&quot;) .. (e.valve and &quot;; isolate the boiler pipe&quot; or &quot;&quot;)
    .. (e.mum and &quot;; speak with Mum&quot; or &quot;&quot;) .. (e.sanityMax and &quot;; sanity at or below &quot; .. e.sanityMax .. &quot;%&quot; or &quot;&quot;))
  end
 end
 snapshot(player)
end
Lighting.ClockTime = 0
Lighting.GlobalShadows = true
Lighting.EnvironmentDiffuseScale = 0.35
Lighting.EnvironmentSpecularScale = 0.65
Lighting.ExposureCompensation = -0.15
Lighting.Brightness = 1.5
local grade = Instance.new(&quot;ColorCorrectionEffect&quot;)
grade.Name = &quot;SpareRoomGrade&quot;
grade.TintColor = Color3.fromRGB(225, 233, 221)
grade.Saturation = -0.22
grade.Contrast = 0.12
grade.Parent = Lighting
local bloom = Instance.new(&quot;BloomEffect&quot;)
bloom.Intensity = 0.12
bloom.Size = 24
bloom.Threshold = 1.6
bloom.Parent = Lighting
Lighting.Ambient = Color3.fromRGB(35, 39, 39)
Lighting.OutdoorAmbient = Color3.fromRGB(50, 57, 63)
Lighting.FogColor = Color3.fromRGB(17, 24, 25)
Lighting.FogStart = 110
Lighting.FogEnd = 310
for _, part in ipairs(world:GetDescendants()) do
 if part:IsA(&quot;BasePart&quot;) then
  local material = part:FindFirstChild(&quot;MaterialName&quot;)
  if material and Enum.Material[material.Value] then part.Material = Enum.Material[material.Value] end
  if part.Name == &quot;Lamp&quot; then
   local light = Instance.new(&quot;PointLight&quot;)
   light.Color = Color3.fromRGB(239, 207, 155)
   light.Brightness = part.Position.Y &lt; -5 and 0.65 or 1.1
   light.Range = part.Position.Y &lt; -5 and 17 or 25
   light.Shadows = true
   light.Parent = part
  end
  local sign = part:FindFirstChild(&quot;Sign&quot;)
  if sign then
   local gui = Instance.new(&quot;SurfaceGui&quot;)
   gui.Face = value(part, &quot;Side&quot;) == &quot;Right&quot; and Enum.NormalId.Right or value(part, &quot;Side&quot;) == &quot;Left&quot; and Enum.NormalId.Left or value(part, &quot;Side&quot;) == &quot;Back&quot; and Enum.NormalId.Back or Enum.NormalId.Front
   gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
   gui.PixelsPerStud = 60
   gui.AlwaysOnTop = false
   gui.Parent = part
   local label = Instance.new(&quot;TextLabel&quot;)
   label.Size = UDim2.fromScale(1, 1)
   label.BackgroundTransparency = 1
   label.TextColor3 = Color3.fromRGB(232, 218, 181)
   local kind = value(part, &quot;Venue&quot;)
   label.Font = (kind == &quot;ARCHIVE&quot; or kind == &quot;BOOKSHOP&quot;) and Enum.Font.Garamond
    or kind == &quot;CINEMA&quot; and Enum.Font.GothamBlack or Enum.Font.GothamMedium
   local padding = Instance.new(&quot;UIPadding&quot;)
   padding.PaddingLeft = UDim.new(0.05, 0)
   padding.PaddingRight = UDim.new(0.05, 0)
   padding.PaddingTop = UDim.new(0.12, 0)
   padding.PaddingBottom = UDim.new(0.12, 0)
   padding.Parent = label
   label.TextScaled = true
   label.TextWrapped = true
   label.Text = sign.Value
   label.Parent = gui
  end
 end
end
for _, part in ipairs(items:GetChildren()) do
 if part:IsA(&quot;BasePart&quot;) then
  local prompt = Instance.new(&quot;ProximityPrompt&quot;)
  prompt.Style = Enum.ProximityPromptStyle.Default
  prompt.ActionText = value(part, &quot;Action&quot;)
  prompt.ObjectText = value(part, &quot;Title&quot;)
  prompt.KeyboardKeyCode = Enum.KeyCode.E
  prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
  prompt.MaxActivationDistance = 6
  prompt.RequiresLineOfSight = true
  prompt.HoldDuration = 0.8
  prompt.ClickablePrompt = true
  prompt.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
  prompt.Parent = part
  prompts[part] = prompt
  -- Roblox owns hold progress. Validate the completed trigger independently.
  -- A second replicated hold-start clock can reject otherwise completed holds.
  prompt.Triggered:Connect(function(player)
   if not prompt.Enabled or not valid(player, part) then return end
   local state = states[player]
   local now = os.clock()
   if now - (state.lastInteraction or -10) &lt; 0.35 then return end
   state.lastInteraction = now
   interact(player, part)
  end)
 end
end
local function joined(player)
 states[player] = {
  started = false, mode = &quot;Easy&quot;, sanity = 100, stamina = 100, diary = {}, records = {}, rooms = {},
  anomalies = {}, journal = {}, flags = {}, time = 0, sandwichAt = 0, sequence = 0, nextAnomaly = 45, lastRequest = 0,
 }
 if Config.SaveEndingJournal then
  task.spawn(function()
   local ok, saved = pcall(function() return DataStoreService:GetDataStore(&quot;SpareRoomRobloxEndings_v1&quot;):GetAsync(&quot;u&quot; .. player.UserId) end)
   local s = states[player]
   if not s then return end
   s.canSave = ok
   if ok and typeof(saved) == &quot;table&quot; then for id, yes in pairs(saved) do if yes == true and Config.Endings[id] then s.journal[id] = true end end end
   snapshot(player)
  end)
 end
 player.CharacterAdded:Connect(function(character)
  local humanoid = character:WaitForChild(&quot;Humanoid&quot;)
  humanoid.UseJumpPower = true
  humanoid.JumpPower = 45
  task.wait(0.1)
  if character.Parent then character:PivotTo(CFrame.new(0, 4, -11)) end
 end)
end
Players.PlayerAdded:Connect(joined)
for _, player in ipairs(Players:GetPlayers()) do joined(player) end
Players.PlayerRemoving:Connect(function(player)
 local s = states[player]
 if s then saveJournal(player, s) end
 states[player] = nil
end)
game:BindToClose(function()
 if not Config.SaveEndingJournal then return end
 for player, s in pairs(states) do
  if s.canSave then
   pcall(function()
    DataStoreService:GetDataStore(&quot;SpareRoomRobloxEndings_v1&quot;):UpdateAsync(&quot;u&quot; .. player.UserId, function(old)
     local result = typeof(old) == &quot;table&quot; and old or {}
     for id in pairs(s.journal) do result[id] = true end
     return result
    end)
   end)
  end
 end
end)
remote.OnServerEvent:Connect(function(player, action, data)
 local s = states[player]
 if not s or typeof(action) ~= &quot;string&quot; then return end
 local now = os.clock()
 if action == &quot;Admin&quot; then
  if not isAdmin(player) or not s.started or s.ended or typeof(data) ~= &quot;table&quot; then return end
  if now - (s.lastAdmin or 0) &lt; 0.3 then return end
  s.lastAdmin = now
  local root = position(player)
  if data.command == &quot;Teleport&quot; and typeof(data.value) == &quot;string&quot; and destinations[data.value] and root then
   player.Character:PivotTo(CFrame.new(destinations[data.value]))
   remote:FireClient(player, &quot;AnomalyEnd&quot;)
   s.active = nil
  elseif data.command == &quot;Sanity&quot; and typeof(data.value) == &quot;number&quot; and (data.value == 10 or data.value == -10) then
   if data.value &lt; 0 then damage(player, 10) else s.sanity = math.min(100, s.sanity + 10) end
  elseif data.command == &quot;Fly&quot; then
   s.flying = not s.flying
  elseif data.command == &quot;Day&quot; then
   s.day = (s.day or 1) + 1
   s.time += 1200
   tell(player, &quot;Admin: advanced to day &quot; .. s.day .. &quot;.&quot;)
  elseif data.command == &quot;Clear&quot; then
   s.active = nil
   s.nextAnomaly = s.time + Config.Modes[s.mode].delay
   remote:FireClient(player, &quot;AnomalyEnd&quot;)
  elseif data.command == &quot;Anomaly&quot; and typeof(data.value) == &quot;string&quot; then
   for _, a in ipairs(Config.Anomalies) do
    if a.id == data.value then
     -- Use the same floor/clearance checks as natural anomalies.
     s.adminAnomaly = a.id
     s.nextAnomaly = s.time
     s.active = nil
     break
    end
   end
  end
  snapshot(player)
  return
 end
 if action == &quot;Ready&quot; then snapshot(player) return end
 if action == &quot;Sprint&quot; then s.sprint = data == true return end
 if action == &quot;Start&quot; then
  if now - (s.lastStart or -10) &lt; 2 then return end
  s.lastStart = now
 end
 if action == &quot;Start&quot; then
  if typeof(data) == &quot;string&quot; and Config.Modes[data] then reset(player, data) end
 elseif action == &quot;ReadClosed&quot; then
  if s.reading and data == s.reading.id then
   local cost = s.reading.cost
   s.reading = nil
   damage(player, cost)
   snapshot(player)
  end
 elseif action == &quot;Pause&quot; then
  if s.started and not s.ended and not s.reading then s.menu = data == true end
 elseif action == &quot;Finish&quot; then
  local c = s.confirm
  if c and data == c.nonce then
   s.menu = false
   s.confirm = nil
   local root = position(player)
   if root and (root.Position - c.part.Position).Magnitude &lt; 8 then finish(player, c.id) end
  end
 elseif action == &quot;CancelEnding&quot; then s.confirm = nil s.menu = false end
end)
-- Each natural anomaly appears once before the next shuffled set begins.
local function nextNaturalAnomaly(s)
 if not s.anomalyBag or #s.anomalyBag == 0 then
  s.anomalyBag = {}
  for _, a in ipairs(Config.Anomalies) do table.insert(s.anomalyBag, a) end
  for i = #s.anomalyBag, 2, -1 do
   local j = math.random(i)
   s.anomalyBag[i], s.anomalyBag[j] = s.anomalyBag[j], s.anomalyBag[i]
  end
  if #s.anomalyBag &gt; 1 and s.anomalyBag[#s.anomalyBag].id == s.lastNatural then
   s.anomalyBag[1], s.anomalyBag[#s.anomalyBag] = s.anomalyBag[#s.anomalyBag], s.anomalyBag[1]
  end
 end
 local a = table.remove(s.anomalyBag)
 s.lastNatural = a.id
 return a
end
local function eventPoint(player)
 local root = position(player)
 if not root then return nil end
 local params = RaycastParams.new()
 params.FilterType = Enum.RaycastFilterType.Exclude
 params.FilterDescendantsInstances = {player.Character}
 for _, offset in ipairs({Vector3.new(4, 0, 0), Vector3.new(-4, 0, 0), Vector3.new(0, 0, 4), Vector3.new(0, 0, -4)}) do
  if not workspace:Raycast(root.Position, offset, params) then
   local down = workspace:Raycast(root.Position + offset, Vector3.new(0, -8, 0), params)
   if down then
    local point = down.Position + Vector3.new(0, 0.05, 0)
    local overlap = OverlapParams.new()
    overlap.FilterType = Enum.RaycastFilterType.Exclude
    overlap.FilterDescendantsInstances = {player.Character}
    local clear = true
    for _, part in ipairs(workspace:GetPartBoundsInBox(CFrame.new(point + Vector3.new(0, 2.8, 0)), Vector3.new(4.5, 5.5, 5), overlap)) do
     if part.CanCollide then clear = false break end
    end
    if clear then return point end
   end
  end
 end
 return nil
end
local accumulator = 0
RunService.Heartbeat:Connect(function(dt)
 accumulator += dt
 for player, s in pairs(states) do
  local root = position(player)
  local humanoid = player.Character and player.Character:FindFirstChildOfClass(&quot;Humanoid&quot;)
  if humanoid then
   local locked = paused(s)
   local moving = root and Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude &gt; 1
   if not locked then
    if s.stamina &gt;= 25 then s.exhausted = false end
    local sprinting = s.sprint and not s.exhausted and moving
    s.stamina = math.clamp(s.stamina + (sprinting and -26 or 18) * dt, 0, 100)
    if s.stamina == 0 then s.exhausted = true end
    humanoid.WalkSpeed = sprinting and 20 or 12
   else humanoid.WalkSpeed = 0 end
   humanoid.JumpPower = locked and 0 or 45
  end
  if not paused(s) then
   s.time += dt
   local mode = Config.Modes[s.mode]
   s.sanity = math.max(0, s.sanity - mode.drain * dt)
   if s.sanity &lt;= 0 then finish(player, &quot;consumed&quot;) end
   if root then
    local row = math.floor((root.Position.Z + 18) / 18)
    if root.Position.Y &lt; -6 and row &gt;= 0 and row &lt; 5 and math.abs(root.Position.X) &gt; 4 and math.abs(root.Position.X) &lt; 28 then
     s.rooms[row * 2 + (root.Position.X &gt; 0 and 2 or 1)] = true
    end
    if not s.active and s.time &gt;= s.nextAnomaly then
     local point = eventPoint(player)
     if point then
      s.sequence += 1
      local a = nil
      if s.adminAnomaly then
       for _, candidate in ipairs(Config.Anomalies) do if candidate.id == s.adminAnomaly then a = candidate break end end
       s.adminAnomaly = nil
      else a = nextNaturalAnomaly(s) end
      s.active = {elapsed = 0, duration = 14, floor = root.Position.Y &lt; -6 and &quot;below&quot; or &quot;above&quot;}
      s.anomalies[a.id] = true
      remote:FireClient(player, &quot;Anomaly&quot;, {id = a.id, title = a.title, text = a.text, position = point, duration = s.active.duration})
      damage(player, 2.5)
     else s.nextAnomaly = s.time + 8 if s.adminAnomaly then tell(player, &quot;Move to an open floor area so the anomaly can appear safely.&quot;) end end
    end
   end
   if s.active then
    s.active.elapsed += dt
    if not root or (root.Position.Y &lt; -6 and &quot;below&quot; or &quot;above&quot;) ~= s.active.floor or s.active.elapsed &gt;= s.active.duration then
     s.active = nil
     s.nextAnomaly = s.time + mode.delay
     remote:FireClient(player, &quot;AnomalyEnd&quot;)
    end
   end
  end
  if accumulator &gt;= 0.5 then snapshot(player) end
 end
 if accumulator &gt;= 0.5 then accumulator = 0 end
end)

</ProtectedString><bool name="Disabled">false</bool></Properties></Item></Item><Item class="StarterPlayer" referent="RBX2809"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX2808"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX2807"><Properties><string name="Name">SpareRoomClient</string><ProtectedString name="Source">-- StarterPlayerScripts/SpareRoomClient. Roblox renders and handles its default E/touch/controller hold prompts.
local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local UserInputService = game:GetService(&quot;UserInputService&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)
local ProximityPromptService = game:GetService(&quot;ProximityPromptService&quot;)
local player = Players.LocalPlayer
local remote = ReplicatedStorage:WaitForChild(&quot;SpareRoomEvent&quot;)
local Config = require(ReplicatedStorage:WaitForChild(&quot;SpareRoomConfig&quot;))
local gui = Instance.new(&quot;ScreenGui&quot;)
gui.Name = &quot;SpareRoomHUD&quot;
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild(&quot;PlayerGui&quot;)
local canvas = Instance.new(&quot;Frame&quot;)
canvas.Name = &quot;ResponsiveCanvas&quot;
canvas.AnchorPoint = Vector2.new(0.5,0.5)
canvas.Position = UDim2.fromScale(0.5,0.5)
canvas.Size = UDim2.fromOffset(1280,720)
canvas.BackgroundTransparency = 1
canvas.Parent = gui
local uiScale = Instance.new(&quot;UIScale&quot;)
uiScale.Parent = canvas
local function fitCanvas()
 local c = workspace.CurrentCamera
 if c then uiScale.Scale = math.min(c.ViewportSize.X / 1280, math.max(1,c.ViewportSize.Y-40) / 720) end
end
local current = {started = false, sanity = 100, stamina = 100, journal = {}, mode = &quot;Easy&quot;}
local modalReason, readingId, confirmationNonce = nil, nil, nil
local thirdPerson = false
local cursorFree = false
local flashlightOn = true
local lastCameraMode = &quot;&quot;
local active = nil
local captionRemaining = 0
local gold = Color3.fromRGB(225, 204, 154)
local function frame(parent, name, pos, size)
 local f = Instance.new(&quot;Frame&quot;)
 f.Name = name
 f.Position = pos
 f.Size = size
 f.BackgroundColor3 = Color3.fromRGB(20, 22, 21)
 f.BackgroundTransparency = 0.08
 f.BorderColor3 = Color3.fromRGB(119, 108, 86)
 f.Parent = parent
 local corner = Instance.new(&quot;UICorner&quot;)
 corner.CornerRadius = UDim.new(0,5)
 corner.Parent = f
 return f
end
local function text(parent, content, pos, size, fontSize)
 local t = Instance.new(&quot;TextLabel&quot;)
 t.Position = pos
 t.Size = size
 t.BackgroundTransparency = 1
 t.Text = content
 t.Font = Enum.Font.Gotham
 t.TextSize = fontSize or 16
 t.TextColor3 = gold
 t.TextWrapped = true
 t.Parent = parent
 return t
end
local function button(parent, content, pos, size, callback)
 local b = Instance.new(&quot;TextButton&quot;)
 b.Position = pos
 b.Size = size
 b.BackgroundColor3 = Color3.fromRGB(48, 47, 40)
 b.TextColor3 = gold
 b.Font = Enum.Font.GothamBold
 b.TextSize = 16
 b.Text = content
 b.Parent = parent
 local corner = Instance.new(&quot;UICorner&quot;)
 corner.CornerRadius = UDim.new(0,4)
 corner.Parent = b
 b.Activated:Connect(callback)
 return b
end
local function blocked()
 return not current.started or current.ended ~= nil or modalReason ~= nil
end
local hud = frame(canvas, &quot;Sanity&quot;, UDim2.fromOffset(28,26), UDim2.fromOffset(260,86))
local sanityText = text(hud, &quot;SANITY 100%&quot;, UDim2.fromScale(0.04, 0.03), UDim2.fromScale(0.92, 0.3), 16)
local sanityTrack = frame(hud, &quot;SanityTrack&quot;, UDim2.fromScale(0.06, 0.4), UDim2.fromScale(0.88, 0.08))
local sanityFill = frame(sanityTrack, &quot;Fill&quot;, UDim2.fromScale(0, 0), UDim2.fromScale(1, 1))
sanityFill.BackgroundColor3 = gold
local staminaText = text(hud, &quot;STAMINA 100%&quot;, UDim2.fromScale(0.04, 0.56), UDim2.fromScale(0.92, 0.3), 13)
local tasks = frame(canvas, &quot;Tasks&quot;, UDim2.fromOffset(936,438), UDim2.fromOffset(316,216))
local tasksText = text(tasks, &quot;&quot;, UDim2.fromScale(0.05, 0.03), UDim2.fromScale(0.9, 0.94), 14)
tasksText.TextYAlignment = Enum.TextYAlignment.Top
tasksText.TextXAlignment = Enum.TextXAlignment.Left
local caption = frame(canvas, &quot;Caption&quot;, UDim2.fromOffset(310,116), UDim2.fromOffset(660,74))
caption.Visible = false
local captionText = text(caption, &quot;&quot;, UDim2.fromScale(0.04, 0.05), UDim2.fromScale(0.92, 0.9), 16)
local cross = frame(canvas, &quot;Crosshair&quot;, UDim2.new(0.5, -1, 0.5, -1), UDim2.fromOffset(3, 3))
cross.BackgroundColor3 = gold
cross.BorderSizePixel = 0
local title = frame(canvas, &quot;TitleScreen&quot;, UDim2.fromScale(0, 0), UDim2.fromScale(1, 1))
title.ZIndex = 10
text(title, &quot;THE SPARE ROOM&quot;, UDim2.fromScale(0.1, 0.12), UDim2.fromScale(0.8, 0.12), 32)
text(title, &quot;BENEATH THE HOUSE\nThere was always something underneath.\n\nRoblox Studio starter · six ending paths&quot;, UDim2.fromScale(0.1, 0.27), UDim2.fromScale(0.8, 0.2), 19)
for i, mode in ipairs({&quot;Easy&quot;, &quot;Intermediate&quot;, &quot;Hard&quot;}) do
 button(title, mode, UDim2.fromScale(0.32, 0.5 + (i - 1) * 0.1), UDim2.fromScale(0.36, 0.08), function()
  remote:FireServer(&quot;Start&quot;, mode)
 end)
end
text(title, &quot;WASD · Shift sprint · Space jump · V camera\nHold E, click, touch or controller X near an object.\nRead the hallway invitation, then inspect the maintenance hatch.&quot;, UDim2.fromScale(0.1, 0.83), UDim2.fromScale(0.8, 0.14), 14)
local modal = frame(canvas, &quot;Reading&quot;, UDim2.fromScale(0.12, 0.13), UDim2.fromScale(0.76, 0.72))
modal.ZIndex = 20
modal.Visible = false
local heading = text(modal, &quot;&quot;, UDim2.fromScale(0.05, 0.03), UDim2.fromScale(0.9, 0.16), 25)
local paper = Instance.new(&quot;ScrollingFrame&quot;)
paper.Position = UDim2.fromScale(0.06,0.22)
paper.Size = UDim2.fromScale(0.88,0.56)
paper.BackgroundTransparency = 1
paper.BorderSizePixel = 0
paper.ScrollBarThickness = 4
paper.AutomaticCanvasSize = Enum.AutomaticSize.Y
paper.CanvasSize = UDim2.new()
paper.Parent = modal
local body = text(paper, &quot;&quot;, UDim2.fromOffset(0,0), UDim2.new(1,-14,0,0), 17)
body.AutomaticSize = Enum.AutomaticSize.Y
body.TextYAlignment = Enum.TextYAlignment.Top
body.TextXAlignment = Enum.TextXAlignment.Left
local closeButton
local chooseButton
local function closeModal()
 local reason = modalReason
 modalReason = nil
 modal.Visible = false
 if reason == &quot;read&quot; then remote:FireServer(&quot;ReadClosed&quot;, readingId)
 elseif reason == &quot;confirm&quot; then remote:FireServer(&quot;CancelEnding&quot;)
 elseif reason == &quot;admin&quot; then remote:FireServer(&quot;Pause&quot;, false)
 elseif reason == &quot;map&quot; then remote:FireServer(&quot;Pause&quot;, false)
 elseif reason == &quot;journal&quot; then remote:FireServer(&quot;Pause&quot;, false)
 elseif reason == &quot;ending&quot; then remote:FireServer(&quot;Start&quot;, current.mode) end
end
closeButton = button(modal, &quot;Close&quot;, UDim2.fromScale(0.05, 0.85), UDim2.fromScale(0.42, 0.1), closeModal)
chooseButton = button(modal, &quot;Choose this ending&quot;, UDim2.fromScale(0.52, 0.85), UDim2.fromScale(0.43, 0.1), function()
 if modalReason == &quot;confirm&quot; then remote:FireServer(&quot;Finish&quot;, confirmationNonce) end
end)
chooseButton.Visible = false
local journalButton = button(canvas, &quot;JOURNAL&quot;, UDim2.fromOffset(1136,26), UDim2.fromOffset(116, 36), function()
 if blocked() then return end
 modalReason = &quot;journal&quot;
 heading.Text = &quot;Ending journal&quot;
 local endings = #current.journal &gt; 0 and table.concat(current.journal, &quot;\n&quot;) or &quot;No endings recorded yet.&quot;
 local observed = current.observed or {}
 body.Text = &quot;ENDING JOURNAL\n&quot; .. endings .. &quot;\n\nANOMALY FIELD NOTES (&quot; .. #observed .. &quot;/&quot; .. #Config.Anomalies .. &quot;)\n&quot;
  .. (#observed &gt; 0 and table.concat(observed,&quot;\n\n&quot;) or &quot;No anomalies witnessed this run.&quot;)
 closeButton.Text = &quot;Close&quot;
 chooseButton.Visible = false
 modal.Visible = true
 remote:FireServer(&quot;Pause&quot;, true)
end)
local cameraButton = button(canvas, &quot;CAMERA · V&quot;, UDim2.fromOffset(1136,68), UDim2.fromOffset(116, 36), function()
 if not blocked() then thirdPerson = not thirdPerson end
end)
local mouseButton
local function toggleMouse()
 if blocked() then return end
 cursorFree = not cursorFree
end
mouseButton = button(canvas,&quot;MOUSE / M&quot;,UDim2.fromOffset(1136,152),UDim2.fromOffset(116,36),toggleMouse)
local lampButton
local function toggleTorch()
 if blocked() then return end
 flashlightOn=not flashlightOn
 lampButton.Text=flashlightOn and &quot;LIGHT ON / F&quot; or &quot;LIGHT OFF / F&quot;
end
lampButton=button(canvas,&quot;LIGHT ON / F&quot;,UDim2.fromOffset(1136,194),UDim2.fromOffset(116,36),toggleTorch)
local function openMap()
 if blocked() then return end
 modalReason=&quot;map&quot;
 heading.Text=&quot;ASHFIELD / DISTRICT GUIDE&quot;
 local root=player.Character and player.Character:FindFirstChild(&quot;HumanoidRootPart&quot;)
 local location=root and root.Position.Y &lt; -6 and &quot;Beneath the house&quot; or &quot;House and district&quot;
 body.Text=&quot;YOU ARE: &quot;..location..&quot;\n\nLeave through the house's front entrance. Follow the path to the road.\n\nACROSS THE ROAD — west to east\nThe Palladium cinema · Municipal Archive · St. Agnes Clinic · Ashfield Station · Ward &amp; Sons · Velvet &amp; Ash\n\nON THE HOUSE SIDE\nThe Second Copy bookshop to the west. The Empty Chair cafe to the east.\n\nAT HOME\nThe garden is behind the house. The maintenance hatch at the end of the hallway leads below. Use the return stairs to come home.\n\nPlaces change what you notice. Read the correspondence in every venue.&quot;
 closeButton.Text=&quot;Fold the map&quot;
 chooseButton.Visible=false
 modal.Visible=true
 remote:FireServer(&quot;Pause&quot;,true)
end
local mapButton=button(canvas,&quot;MAP / G&quot;,UDim2.fromOffset(1136,236),UDim2.fromOffset(116,36),openMap)
local touchSprint = false
local sprintButton = button(canvas, &quot;SPRINT&quot;, UDim2.fromScale(0.02, 0.72), UDim2.fromOffset(110, 36), function()
 if blocked() then return end
 touchSprint = not touchSprint
 remote:FireServer(&quot;Sprint&quot;, touchSprint)
end)
sprintButton.Visible = UserInputService.TouchEnabled
local controlHints = text(canvas, &quot;WASD  MOVE     SHIFT  SPRINT     SPACE  JUMP     HOLD E  INTERACT     M  MOUSE     F  LIGHT     G  MAP&quot;, UDim2.fromOffset(250,674), UDim2.fromOffset(780,26),12)
-- Admin UI is only shown after server-confirmed authorization.
local adminPanel = frame(canvas, &quot;AdminPanel&quot;, UDim2.fromOffset(300,92), UDim2.fromOffset(680,540))
adminPanel.Visible = false
adminPanel.ZIndex = 30
text(adminPanel,&quot;HOUSEKEEPER / ADMIN TOOLS&quot;,UDim2.fromOffset(24,12),UDim2.fromOffset(500,38),23)
local adminScroll = Instance.new(&quot;ScrollingFrame&quot;)
adminScroll.Position = UDim2.fromOffset(24,64)
adminScroll.Size = UDim2.fromOffset(632,404)
adminScroll.BackgroundTransparency = 1
adminScroll.ScrollBarThickness = 5
adminScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
adminScroll.CanvasSize = UDim2.new()
adminScroll.Parent = adminPanel
local adminLayout = Instance.new(&quot;UIListLayout&quot;)
adminLayout.Padding = UDim.new(0,8)
adminLayout.SortOrder = Enum.SortOrder.LayoutOrder
adminLayout.Parent = adminScroll
local function adminAction(command,value)
 remote:FireServer(&quot;Admin&quot;,{command=command,value=value})
end
local rowNumber = 0
local function adminRow(label,command,value)
 rowNumber += 1
 local b = button(adminScroll,label,UDim2.new(),UDim2.new(1,-12,0,36),function() adminAction(command,value) end)
 b.LayoutOrder = rowNumber
end
for _, location in ipairs({&quot;House&quot;,&quot;Garden&quot;,&quot;Basement&quot;,&quot;Cinema&quot;,&quot;Archive&quot;,&quot;Clinic&quot;,&quot;Station&quot;,&quot;Workshop&quot;,&quot;Costumes&quot;,&quot;Bookshop&quot;,&quot;Cafe&quot;}) do
 adminRow(&quot;TELEPORT / &quot;..location,&quot;Teleport&quot;,location)
end
for _, a in ipairs(Config.Anomalies) do adminRow(&quot;ANOMALY / &quot;..a.title,&quot;Anomaly&quot;,a.id) end
adminRow(&quot;Clear active anomaly&quot;,&quot;Clear&quot;)
adminRow(&quot;Restore sanity +10%&quot;,&quot;Sanity&quot;,10)
adminRow(&quot;Remove sanity 10% (difficulty adjusted)&quot;,&quot;Sanity&quot;,-10)
adminRow(&quot;Toggle flight (WASD, Space up, Ctrl down)&quot;,&quot;Fly&quot;)
adminRow(&quot;Skip one day / advance event timers&quot;,&quot;Day&quot;)
button(adminPanel,&quot;Return to game&quot;,UDim2.fromOffset(24,482),UDim2.fromOffset(632,38),function()
 adminPanel.Visible=false
 modalReason=nil
 remote:FireServer(&quot;Pause&quot;,false)
end)
local function toggleAdmin()
 if not current.admin or not current.started or current.ended then return end
 if adminPanel.Visible then
  adminPanel.Visible=false modalReason=nil remote:FireServer(&quot;Pause&quot;,false)
 elseif not modalReason then
  adminPanel.Visible=true modalReason=&quot;admin&quot; remote:FireServer(&quot;Pause&quot;,true)
 end
end
local adminButton = button(canvas,&quot;ADMIN / F8&quot;,UDim2.fromOffset(1136,110),UDim2.fromOffset(116,36),toggleAdmin)
adminButton.Visible=false
local flyAttachment, flyVelocity, flyRoot
local function stopFlight()
 if flyVelocity then flyVelocity:Destroy() flyVelocity=nil end
 if flyAttachment then flyAttachment:Destroy() flyAttachment=nil end
 if flyRoot and flyRoot.Parent then
  local h=flyRoot.Parent:FindFirstChildOfClass(&quot;Humanoid&quot;)
  if h then h.PlatformStand=false end
 end
 flyRoot=nil
end
local flash = frame(canvas, &quot;SanityFlash&quot;, UDim2.fromScale(0, 0), UDim2.fromScale(1, 1))
flash.BackgroundColor3 = Color3.fromRGB(110, 20, 15)
flash.BackgroundTransparency = 1
flash.ZIndex = 6
flash.BorderSizePixel = 0
local flashTween = nil
local torchPart = Instance.new(&quot;Part&quot;)
torchPart.Name = &quot;SpareRoomLocalTorch&quot;
torchPart.Anchored = true
torchPart.CanCollide = false
torchPart.CanQuery = false
torchPart.CanTouch = false
torchPart.Transparency = 1
torchPart.Size = Vector3.new(0.1, 0.1, 0.1)
torchPart.Parent = workspace
local torch = Instance.new(&quot;SpotLight&quot;)
torch.Face = Enum.NormalId.Front
torch.Range = 26
torch.Angle = 72
torch.Brightness = 2.6
torch.Color = Color3.fromRGB(233, 219, 183)
torch.Shadows = true
torch.Parent = torchPart
local highlight = Instance.new(&quot;Highlight&quot;)
highlight.Name = &quot;NearbyInteractable&quot;
highlight.DepthMode = Enum.HighlightDepthMode.Occluded
highlight.FillTransparency = 0.88
highlight.OutlineColor = gold
highlight.FillColor = gold
highlight.Enabled = false
highlight.Parent = workspace
local shown = {}
ProximityPromptService.PromptShown:Connect(function(prompt)
 if prompt:IsDescendantOf(workspace:WaitForChild(&quot;SpareRoomWorld&quot;):WaitForChild(&quot;Interactables&quot;)) then shown[prompt] = true end
end)
ProximityPromptService.PromptHidden:Connect(function(prompt) shown[prompt] = nil end)
local function showCaption(message, duration)
 captionText.Text = message
 captionRemaining = duration or 7
 caption.Visible = not blocked()
end
local function endAnomaly()
 if active then active.model:Destroy() active = nil end
end
local function anomalyPart(model, size, color)
 local part = Instance.new(&quot;Part&quot;)
 part.Size = size
 part.Color = color
 part.Material = Enum.Material.SmoothPlastic
 part.Anchored = true
 part.CanCollide = false
 part.CanQuery = false
 part.CanTouch = false
 part.Parent = model
 return part
end
local function startAnomaly(data)
 endAnomaly()
 local model = Instance.new(&quot;Model&quot;)
 model.Name = &quot;SpareRoomLocalAnomaly&quot;
 model.Parent = workspace
 local camera = workspace.CurrentCamera
 local p = data.position
 local eye = camera.CFrame.Position
 local base = CFrame.lookAt(p, Vector3.new(eye.X, p.Y, eye.Z))
 local parts = {}
 if data.id == &quot;coat&quot; then
  parts[1] = anomalyPart(model, Vector3.new(1.2, 2.1, 0.4), Color3.fromRGB(89, 106, 91))
  parts[2] = anomalyPart(model, Vector3.new(0.6, 0.5, 0.4), Color3.fromRGB(158, 147, 113))
  for i = 3, 4 do parts[i] = anomalyPart(model, Vector3.new(0.3, 1.5, 0.35), Color3.fromRGB(89, 106, 91)) end
 elseif data.id == &quot;steps&quot; then
  for i = 1, 7 do parts[i] = anomalyPart(model, Vector3.new(0.35, 0.035, 0.7), Color3.fromRGB(59, 77, 65)) end
 elseif data.id == &quot;clock&quot; then
  parts[1] = anomalyPart(model, Vector3.new(2, 2, 0.16), Color3.fromRGB(194, 184, 149))
  parts[1].Shape = Enum.PartType.Ball
  parts[2] = anomalyPart(model, Vector3.new(0.08, 0.9, 0.06), Color3.fromRGB(31, 49, 41))
 elseif data.id == &quot;chair&quot; then
  parts[1] = anomalyPart(model, Vector3.new(1.5, 0.18, 1.5), Color3.fromRGB(129, 103, 74))
  parts[2] = anomalyPart(model, Vector3.new(1.5, 1.7, 0.15), Color3.fromRGB(129, 103, 74))
  for i = 3, 6 do parts[i] = anomalyPart(model, Vector3.new(0.15, 1.4, 0.15), Color3.fromRGB(91, 76, 57)) end
 end
 if data.id == &quot;pages&quot; then
  for i=1,8 do parts[i]=anomalyPart(model,Vector3.new(0.7,0.025,1),Color3.fromRGB(205,194,160)) end
 elseif data.id == &quot;door&quot; then
  parts[1]=anomalyPart(model,Vector3.new(2.4,4.8,0.16),Color3.fromRGB(83,68,50))
  parts[2]=anomalyPart(model,Vector3.new(0.12,0.12,0.25),Color3.fromRGB(185,157,93))
  for i=3,4 do parts[i]=anomalyPart(model,Vector3.new(0.16,5.1,0.3),Color3.fromRGB(138,119,86)) end
  parts[5]=anomalyPart(model,Vector3.new(2.8,0.2,0.3),Color3.fromRGB(138,119,86))
 elseif data.id == &quot;family&quot; then
  for i=1,8 do
   parts[i]=anomalyPart(model,i%2==0 and Vector3.new(0.55,0.6,0.55) or Vector3.new(0.7,1.6,0.35),Color3.fromRGB(31,39,35))
   if i%2==0 then parts[i].Shape=Enum.PartType.Ball end
  end
 elseif data.id == &quot;blocks&quot; then
  for i=1,5 do
   parts[i]=anomalyPart(model,Vector3.new(0.65,0.65,0.65),Color3.fromRGB(126+i*9,113+i*3,82))
   local face=Instance.new(&quot;SurfaceGui&quot;) face.Face=Enum.NormalId.Front face.Parent=parts[i]
   local letter=text(face,string.sub(&quot;HOME?&quot;,i,i),UDim2.new(),UDim2.fromScale(1,1),32)
   letter.TextScaled=true letter.TextColor3=Color3.fromRGB(46,49,41)
  end
 elseif data.id == &quot;plates&quot; then
  for i=1,5 do
   parts[i]=anomalyPart(model,Vector3.new(0.09,1.05,1.05),Color3.fromRGB(194,189,164))
   parts[i].Shape=Enum.PartType.Cylinder
  end
 elseif data.id == &quot;lamp&quot; then
  parts[1]=anomalyPart(model,Vector3.new(0.2,2.6,0.2),Color3.fromRGB(80,81,63))
  parts[2]=anomalyPart(model,Vector3.new(1.5,0.6,1.5),Color3.fromRGB(183,166,121))
  parts[3]=anomalyPart(model,Vector3.new(1.1,0.1,1.1),Color3.fromRGB(79,79,60))
  local light=Instance.new(&quot;PointLight&quot;) light.Range=10 light.Color=Color3.fromRGB(237,207,143) light.Parent=parts[2]
 end
 for _,part in ipairs(parts) do part.CFrame=base end
 active = {model = model, parts = parts, base = base, id = data.id, time = 0, duration = data.duration or 12}
 showCaption(data.title .. &quot; — &quot; .. data.text, data.duration or 12)
end
UserInputService.InputBegan:Connect(function(input, processed)
 if processed then return end
 if input.KeyCode == Enum.KeyCode.F8 then toggleAdmin() return end
 if input.KeyCode == Enum.KeyCode.M then toggleMouse() return end
 if input.KeyCode == Enum.KeyCode.F then toggleTorch() return end
 if input.KeyCode == Enum.KeyCode.G then openMap() return end
 if input.UserInputType == Enum.UserInputType.MouseButton1 and cursorFree and not blocked() then cursorFree=false end
 if input.KeyCode == Enum.KeyCode.LeftShift and not blocked() then remote:FireServer(&quot;Sprint&quot;, true) end
 if input.KeyCode == Enum.KeyCode.V and not blocked() then thirdPerson = not thirdPerson end
end)
UserInputService.InputEnded:Connect(function(input)
 if input.KeyCode == Enum.KeyCode.LeftShift then remote:FireServer(&quot;Sprint&quot;, false) end
end)
UserInputService.WindowFocusReleased:Connect(function() remote:FireServer(&quot;Sprint&quot;, false) end)
remote.OnClientEvent:Connect(function(action, data)
 if action == &quot;State&quot; then
  current = data
  adminButton.Visible = data.admin and data.started and not data.ended
  if not data.started or data.ended then adminPanel.Visible=false end
  title.Visible = not data.started
  hud.Visible = data.started
  tasks.Visible = data.started
  sanityText.Text = &quot;SANITY &quot; .. math.ceil(data.sanity) .. &quot;%&quot;
  sanityFill.Size = UDim2.fromScale(data.sanity / 100, 1)
  staminaText.Text = &quot;STAMINA &quot; .. math.floor(data.stamina) .. &quot;%&quot;
  local mark = function(yes) return yes and &quot;✓ &quot; or &quot;□ &quot; end
  tasksText.Text = &quot;BENEATH THE HOUSE\n\n&quot;
   .. mark(data.diary &gt;= 20) .. &quot;Collect diary pages (&quot; .. data.diary .. &quot;/20)\n&quot;
   .. mark(data.records &gt;= 3) .. &quot;Find family records (&quot; .. data.records .. &quot;/3)\n&quot;
   .. mark(data.hasKey) .. &quot;Find the unnumbered key\n&quot;
   .. mark(data.rooms &gt;= 10) .. &quot;Explore the rooms (&quot; .. data.rooms .. &quot;/10)\n&quot;
   .. &quot;Sandwich: &quot; .. (data.sandwich == 0 and &quot;ready&quot; or data.sandwich .. &quot;s&quot;)
 elseif action == &quot;Read&quot; then
  modalReason = &quot;read&quot;
  readingId = data.id
  heading.Text = data.title
  body.Text = data.text
  closeButton.Text = &quot;Put it back&quot;
  chooseButton.Visible = false
  modal.Visible = true
 elseif action == &quot;Confirm&quot; then
  modalReason = &quot;confirm&quot;
  confirmationNonce = data.nonce
  heading.Text = data.title
  body.Text = data.text .. &quot;\n\nChoose this ending, or keep exploring.&quot;
  closeButton.Text = &quot;Keep exploring&quot;
  chooseButton.Visible = true
  modal.Visible = true
 elseif action == &quot;Ending&quot; then
  endAnomaly()
  modalReason = &quot;ending&quot;
  heading.Text = data.id == &quot;consumed&quot; and &quot;YOU LOST: YOUR SANITY GOT CONSUMED&quot; or data.title
  body.Text = data.text
  closeButton.Text = &quot;Start again&quot;
  chooseButton.Visible = false
  modal.Visible = true
 elseif action == &quot;Caption&quot; then showCaption(data, 7)
 elseif action == &quot;SanityHit&quot; then
  if flashTween then flashTween:Cancel() end
  flash.BackgroundTransparency = 0.55
  flashTween = TweenService:Create(flash, TweenInfo.new(2.2), {BackgroundTransparency = 1})
  flashTween:Play()
 elseif action == &quot;Anomaly&quot; then startAnomaly(data)
 elseif action == &quot;AnomalyEnd&quot; then endAnomaly() end
end)
RunService:BindToRenderStep(&quot;SpareRoomVisuals&quot;, Enum.RenderPriority.Camera.Value + 1, function(dt)
 fitCanvas()
 local isBlocked = blocked()
 controlHints.Visible=not isBlocked
 journalButton.Visible=current.started and not current.ended
 cameraButton.Visible=current.started and not current.ended
 mouseButton.Visible=current.started and not current.ended
 lampButton.Visible=current.started and not current.ended
 mapButton.Visible=current.started and not current.ended
 mouseButton.Modal=cursorFree and not isBlocked
 mouseButton.Text=cursorFree and &quot;CAPTURE / M&quot; or &quot;MOUSE / M&quot;
 if current.admin and current.flying and not current.ended and current.started then
  local root = player.Character and player.Character:FindFirstChild(&quot;HumanoidRootPart&quot;)
  if root and root ~= flyRoot then
   stopFlight()
   flyRoot=root
   flyAttachment=Instance.new(&quot;Attachment&quot;) flyAttachment.Parent=root
   flyVelocity=Instance.new(&quot;LinearVelocity&quot;)
   flyVelocity.Attachment0=flyAttachment
   flyVelocity.MaxForce=math.huge
   flyVelocity.RelativeTo=Enum.ActuatorRelativeTo.World
   flyVelocity.Parent=root
  end
  if flyVelocity then
   local h=player.Character:FindFirstChildOfClass(&quot;Humanoid&quot;)
   if h then h.PlatformStand=true end
   local direction=Vector3.zero
   if not isBlocked and workspace.CurrentCamera then
    local camera=workspace.CurrentCamera.CFrame
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then direction+=camera.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then direction-=camera.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then direction+=camera.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then direction-=camera.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then direction+=Vector3.yAxis end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then direction-=Vector3.yAxis end
   end
   flyVelocity.VectorVelocity=direction.Magnitude&gt;0 and direction.Unit*28 or Vector3.zero
  end
 else stopFlight() end
 if not isBlocked then captionRemaining = math.max(0, captionRemaining - dt) end
 caption.Visible = not isBlocked and captionRemaining &gt; 0
 local mode = isBlocked and &quot;menu&quot; or thirdPerson and &quot;third&quot; or &quot;first&quot;
 if mode ~= lastCameraMode then
  lastCameraMode = mode
  if mode == &quot;first&quot; then
   player.CameraMode = Enum.CameraMode.LockFirstPerson
   player.CameraMinZoomDistance = 0.5
   player.CameraMaxZoomDistance = 0.5
  else
   player.CameraMode = Enum.CameraMode.Classic
   player.CameraMaxZoomDistance = 14
   player.CameraMinZoomDistance = 6
  end
 end
 if isBlocked or cursorFree then
  UserInputService.MouseBehavior=Enum.MouseBehavior.Default
 elseif not thirdPerson then UserInputService.MouseBehavior=Enum.MouseBehavior.LockCenter end
 UserInputService.MouseIconEnabled = isBlocked or cursorFree
 ProximityPromptService.Enabled = not isBlocked
 cross.Visible = not isBlocked
 torch.Enabled = flashlightOn and current.started and not current.ended
 if workspace.CurrentCamera then torchPart.CFrame = workspace.CurrentCamera.CFrame end
 local nearest, nearestPrompt, distance = nil, nil, math.huge
 local character = player.Character
 local root = character and character:FindFirstChild(&quot;HumanoidRootPart&quot;)
 if root and not isBlocked then
  for prompt in pairs(shown) do
   if prompt.Parent and prompt.Enabled then
    local d = (prompt.Parent.Position - root.Position).Magnitude
    if d &lt; distance and d &lt;= 6 then nearest = prompt.Parent nearestPrompt=prompt distance = d end
   end
  end
 end
 highlight.Adornee = nearest
 highlight.Enabled = nearest ~= nil
 if active and not isBlocked then
  active.time += dt
  local t, parts, base = active.time, active.parts, active.base
  if active.id == &quot;pages&quot; then
   for i,part in ipairs(parts) do
    local angle=t*0.45+i*math.pi/4
    part.CFrame=base*CFrame.new(math.cos(angle)*1.1,1.8+math.sin(t+i)*0.25,math.sin(angle)*1.1)*CFrame.Angles(0,angle,math.sin(t+i)*0.2)
   end
  elseif active.id == &quot;door&quot; then
   local swing=math.sin(math.clamp((t-3)/5,0,1)*math.pi)*0.22
   parts[1].CFrame=base*CFrame.new(0,2.4,0)*CFrame.Angles(0,swing,0)
   parts[2].CFrame=parts[1].CFrame*CFrame.new(0.85,0,-0.2)
   parts[3].CFrame=base*CFrame.new(-1.35,2.55,0)
   parts[4].CFrame=base*CFrame.new(1.35,2.55,0)
   parts[5].CFrame=base*CFrame.new(0,5.05,0)
  elseif active.id == &quot;family&quot; then
   for i=1,4 do
    local x=(i-2.5)*0.9
    local small=i==4 and 0.65 or 1
    local sway=math.sin(t*0.35+i)*0.06
    parts[i*2-1].CFrame=base*CFrame.new(x+sway,small*1.5,0)
    parts[i*2].CFrame=base*CFrame.new(x+sway,small*2.55,0)
    parts[i*2-1].Transparency=0.35+math.sin(t*0.5+i)*0.1
    parts[i*2].Transparency=parts[i*2-1].Transparency
   end
  elseif active.id == &quot;blocks&quot; then
   for i,part in ipairs(parts) do
    local settle=math.clamp((t-i*0.6)/2,0,1)
    part.CFrame=base*CFrame.new((i-3)*0.75,0.35+(1-settle)*1.8,math.sin(i)*(1-settle))*CFrame.Angles(0,(1-settle)*i,0)
   end
  elseif active.id == &quot;plates&quot; then
   for i,part in ipairs(parts) do
    local angle=(i-1)*math.pi/2
    part.CFrame=base*CFrame.new(i==5 and 0 or math.cos(angle)*1.1,1.8+math.sin(t*0.8+i)*0.06,i==5 and 0 or math.sin(angle)*1.1)*CFrame.Angles(0,0,math.pi/2)
    part.Transparency=i==5 and 0.78+math.sin(t*0.5)*0.15 or math.max(0,1-t/2)
   end
  elseif active.id == &quot;lamp&quot; then
   parts[1].CFrame=base*CFrame.new(0,1.3,0)
   parts[2].CFrame=base*CFrame.new(0,2.8,0)
   parts[3].CFrame=base*CFrame.new(0,0.1,0)
   -- Gentle pulses rather than rapid flashes: three, then one late answer.
   local phase=t%6
   local pulse=0
   for _,beat in ipairs({0.6,1.8,3,4.8}) do pulse=math.max(pulse,math.max(0,1-math.abs(phase-beat)/0.4)) end
   parts[2]:FindFirstChildOfClass(&quot;PointLight&quot;).Brightness=0.2+pulse*1.2
  elseif active.id == &quot;coat&quot; then
   local lift = math.sin(math.min(t, 10) / 10 * math.pi) * 0.6
   parts[1].CFrame = base * CFrame.new(0, 1.6 + lift, 0)
   parts[2].CFrame = base * CFrame.new(0, 2.85 + lift, 0)
   parts[3].CFrame = base * CFrame.new(-0.75, 1.6 + lift, 0) * CFrame.Angles(0, 0, 0.13)
   parts[4].CFrame = base * CFrame.new(0.75, 1.6 + lift, 0) * CFrame.Angles(0, 0, -0.13)
  elseif active.id == &quot;steps&quot; then
   for i, part in ipairs(parts) do
    part.CFrame = base * CFrame.new(i % 2 == 0 and 0.25 or -0.25, 0.025, (i - 4) * 0.6)
    part.Transparency = t &gt;= i * 0.65 and 0.2 or 1
   end
  elseif active.id == &quot;clock&quot; then
   parts[1].CFrame = base * CFrame.new(0, 2, 0)
   parts[2].CFrame = base * CFrame.new(0, 2, -0.15) * CFrame.Angles(0, 0, -t * 0.65) * CFrame.new(0, 0.45, 0)
  elseif active.id == &quot;chair&quot; then
   parts[1].CFrame = base * CFrame.new(0, 1.5, 0)
   parts[2].CFrame = base * CFrame.new(0, 2.3, 0.7)
   for i = 3, 6 do
    local dx = i % 2 == 0 and -0.6 or 0.6
    local dz = i &lt;= 4 and -0.6 or 0.6
    parts[i].CFrame = base * CFrame.new(dx, 0.75, dz)
   end
   for _, part in ipairs(parts) do part.Transparency = math.clamp(1 - (t - 0.8) / 1.4, 0, 1) end
  end
  local fade=math.clamp((t-(active.duration-2))/2,0,1)
  if fade&gt;0 then for _,part in ipairs(parts) do part.Transparency=math.max(part.Transparency,fade) end end
 end
end)
remote:FireServer(&quot;Ready&quot;)

</ProtectedString><bool name="Disabled">false</bool></Properties></Item></Item></Item><Item class="Lighting" referent="RBX2810"><Properties><string name="Name">Lighting</string><token name="LightingStyle">1</token><bool name="GlobalShadows">true</bool></Properties></Item></roblox>